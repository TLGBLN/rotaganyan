P("| Sinyal (kararlı yönlü) | tüm koşucular: n | D_i [GA] | favoriler: n | D_i [GA] |"); P("|---|---|---|---|---|");
for (const n of kararli) { const i = NAMES.indexOf(n); const perRace = O.map((o) => { let sA = 0, nA = 0, sF = 0, nF = 0; const fi = o.p.indexOf(Math.max(...o.p)); o.r.runners.forEach((x, j) => { const z = zy(x.f[i]!, n); if (z == null || z <= 0) return; const d = (j === o.w ? 1 : 0) - o.p[j]!; sA += d; nA++; if (j === fi) { sF += d; nF++; } }); return { sA, nA, sF, nF }; });
  const ag = (idx: number[], k: "A" | "F") => { let s = 0, c = 0; for (const j of idx) { const r = perRace[j]!; s += k === "A" ? r.sA : r.sF; c += k === "A" ? r.nA : r.nF; } return c ? s / c : 0; }; const all = perRace.map((_, j) => j);
  const cA = boot(all.length, (idx) => ag(idx, "A")), cF = boot(all.length, (idx) => ag(idx, "F")); const f = (v: number, c: number[]) => (v >= 0 ? "+" : "") + v.toFixed(4) + " [" + c[0]!.toFixed(4) + ", " + c[1]!.toFixed(4) + "]" + (c[0]! > 0 ? " ✔" : c[1]! < 0 ? " ✘" : "");
  P("| " + n + " | " + perRace.reduce((p, r) => p + r.nA, 0) + " | " + f(ag(all, "A"), cA) + " | " + perRace.reduce((p, r) => p + r.nF, 0) + " | " + f(ag(all, "F"), cF) + " |"); }
