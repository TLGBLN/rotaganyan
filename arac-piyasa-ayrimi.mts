for (let i = 0; i < D; i++) { let sa = 0, sb = 0, saa = 0, sbb = 0, sab = 0, n = 0; for (const o of T) { const av = o.agf!.map((p) => Math.log(Math.max(p, 1e-9))); const ma = avg(av), zs = o.z.map((z) => z[i]!), mz = avg(zs); for (let j = 0; j < av.length; j++) { if (!o.r.runners[j]!.f[i]) continue; const x = av[j]! - ma, y = zs[j]! - mz; n++; sa += x; sb += y; saa += x * x; sbb += y * y; sab += x * y; } } const rho = n > 200 ? sab / Math.sqrt(saa * sbb) : NaN;
