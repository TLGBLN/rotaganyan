    O.push({ r, w: r.runners.findIndex((x) => x.k === 1), z, fold: k, p: softmax(z.map((v) => { let t = 0; for (let i = 0; i < D; i++) t += v[i]! * w[i]!; return t; })), agf: top ? top.map((v) => v / sum) : null, ganyan: pg?.ganyan ?? null }); }
  console.log("OOF kat " + k + " (" + te.length + " test)"); }
const L: string[] = []; const P = (s = "") => { console.log(s); L.push(s); };
P("# NET GETİRİ VE PİYASA ETKİSİ AYRIMI (as-of, ileri OOF) — " + new Date().toISOString().slice(0, 10)); P("Test yarışı " + O.length + " | AGF'si TAM olan yarış " + O.filter((o) => o.agf).length + " | ganyan var " + O.filter((o) => o.ganyan != null).length + ". **AGF yalnız değerlendirme ölçüsü; modele girmedi.**");
let sd0 = 7; const rn = () => (sd0 = (sd0 * 1664525 + 1013904223) % 4294967296) / 4294967296; const boot = (n: number, f: (idx: number[]) => number) => { const bs: number[] = []; for (let t = 0; t < 500; t++) bs.push(f(Array.from({ length: n }, () => Math.floor(rn() * n)))); bs.sort((a, b) => a - b); return [bs[12]!, bs[487]!]; };
// 1) NET GETİRİ
P("\n## 1) AYNI BÜTÇEDE NET GETİRİ (düz 1 TL; net = ort. getiri − 1; yarış-bootstrap %95 GA). Getiri = kazandıysa ganyan ikramiyesi.");
const F = O.filter((o) => o.ganyan != null).map((o) => { const fi = o.p.indexOf(Math.max(...o.p)); const srt = [...o.p].sort((a, b) => b - a); const mf = o.agf ? o.agf.indexOf(Math.max(...o.agf)) : -1; return { p: srt[0]!, gap: srt[0]! - (srt[1] ?? 0), ret: fi === o.w ? o.ganyan! : 0, y: fi === o.w ? 1 : 0, piyasaRet: mf >= 0 ? (mf === o.w ? o.ganyan! : 0) : null, piyasaY: mf >= 0 ? (mf === o.w ? 1 : 0) : null, ganyanOrt: o.ganyan! }; });
const net = (T: { ret: number }[]) => { const v = T.map((x) => x.ret); const c = boot(v.length, (idx) => avg(idx.map((i) => v[i]!)) - 1); return (avg(v) - 1 >= 0 ? "+" : "") + ((avg(v) - 1) * 100).toFixed(1) + "% [" + (c[0]! * 100).toFixed(1) + ", " + (c[1]! * 100).toFixed(1) + "]"; };
P("- Model favorisi, TÜM yarışlar: n=" + F.length + ", isabet %" + (avg(F.map((f) => f.y)) * 100).toFixed(1) + ", net " + net(F));
const pf = F.filter((f) => f.piyasaRet != null); P("- Piyasa favorisi (AGF en yüksek, referans), aynı yarışlar: n=" + pf.length + ", isabet %" + (avg(pf.map((f) => f.piyasaY!)) * 100).toFixed(1) + ", net " + net(pf.map((f) => ({ ret: f.piyasaRet! }))) + " | model favorisi aynı yarışlarda: isabet %" + (avg(F.filter((f) => f.piyasaRet != null).map((f) => f.y)) * 100).toFixed(1) + ", net " + net(F.filter((f) => f.piyasaRet != null)));
const rk = (v: number[]) => { const o = v.map((x, i) => ({ x, i })).sort((a, b) => b.x - a.x); const r = new Array<number>(v.length); o.forEach((q, i) => (r[q.i] = i)); return r; }; const rp = rk(F.map((f) => f.p)), rg = rk(F.map((f) => f.gap));
P("\n| Aynı-N seçim | " + [100, 200, 300, 500, 1000].map((n) => "N=" + n).join(" | ") + " |"); P("|---|" + [1, 2, 3, 4, 5].map(() => "---").join("|") + "|");
for (const [ad, sk] of [["p'ye göre", (i: number) => rp[i]!], ["p+GAP", (i: number) => rp[i]! + rg[i]!]] as [string, (i: number) => number][]) { const sir = F.map((_, i) => i).sort((a, b) => sk(a) - sk(b)); P("| " + ad + " | " + [100, 200, 300, 500, 1000].map((N) => { const T = sir.slice(0, N).map((i) => F[i]!); return "isabet %" + (avg(T.map((f) => f.y)) * 100).toFixed(1) + ", net " + net(T); }).join(" | ") + " |"); }
