for (let k = 1; k < 5; k++) { const tr = T.filter((o) => o.fold < k), te = T.filter((o) => o.fold === k); if (tr.length < 100) continue; const mk = (o: R) => ({ w: o.w, x: o.p.map((p, i) => Float64Array.of(Math.log(Math.max(p, 1e-9)), Math.log(Math.max(o.agf![i]!, 1e-9)))) }); const w = egit(tr.map(mk), 2, 1e-4); abSon = [w[0]!, w[1]!];
