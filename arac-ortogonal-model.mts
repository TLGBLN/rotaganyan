// KALICI ARAÇ — TAM ORTOGONALLEŞTİRİLMİŞ (birbirinden arındırılmış) MODEL (şartname v1.2 bölüm 4: "artıklaştırılmış sinyal, orijinal sinyal ve etkileşimli model birbirine karşı test edilecek"). SALT-OKUMA, DB'siz.
// Soru (projenin ana şüphesi): sinyaller birbirini ENGELLİYOR mu? Doğrusal modelde korelasyon tek başına tahmini DEĞİŞTİRMEZ (aynı kapsam uzayı); yalnız ridge düzenlileştirmesi ve katsayı kararlılığı etkilenir. Bu araç bunu ölçer:
//   M_orijinal  : 17 sinyal, ridge 0.02 (canlı yapı)        M_ortogonal : sinyaller sırayla (tekil gücü büyükten küçüğe) önceki ortogonal sütunlara regresyonla ARITILIR (eğitim penceresinde öğrenilir), aynı ridge
//   M_ridgesiz  : orijinal, ridge 1e-6 (düzenlileştirmenin payını ayırmak için)
// İleri kronolojik 5 dış kat, as-of matris, aynı test yarışları. ΔLL paired bootstrap.
import fs from "node:fs";
type Cell = [number, number, number?] | null; type Race = { raceId: string; tarih: string; runners: { no: number; k: number; f: Cell[] }[] };
const M = JSON.parse(fs.readFileSync(process.env.GOLGELEME_MATRIS ?? ".sinyal-veri/golgeleme-matris-tum-asof.json", "utf8")) as { ozellik: string[]; kesim: string[]; yarislar: Race[] };
{ const nAt = M.yarislar.reduce((p, r) => p + r.runners.length, 0); const keep = M.ozellik.map((_, i) => i).filter((i) => M.yarislar.reduce((p, r) => p + r.runners.filter((x) => x.f[i]).length, 0) / nAt >= 0.05); M.yarislar.forEach((r) => r.runners.forEach((x) => { x.f = keep.map((i) => x.f[i]!); })); M.ozellik = keep.map((i) => M.ozellik[i]!); }
const NAMES = M.ozellik, D = NAMES.length, kesim = M.kesim;
const races = [...M.yarislar].sort((a, b) => a.tarih.localeCompare(b.tarih)).filter((r) => r.runners.some((x) => x.k === 1));
const softmax = (s: number[]) => { const m = Math.max(...s); const e = s.map((x) => Math.exp(x - m)); const z = e.reduce((a, b) => a + b, 0); return e.map((x) => x / z); }; const avg = (a: number[]) => a.reduce((p, q) => p + q, 0) / Math.max(1, a.length);
function coz(A: number[][], d: number) { for (let i = 0; i < d; i++) { let pv = i; for (let k = i + 1; k < d; k++) if (Math.abs(A[k]![i]!) > Math.abs(A[pv]![i]!)) pv = k; [A[i], A[pv]] = [A[pv]!, A[i]!]; const dv = A[i]![i]! || 1e-12; for (let j = i; j <= d; j++) A[i]![j]! /= dv; for (let k = 0; k < d; k++) if (k !== i) { const mm = A[k]![i]!; for (let j = i; j <= d; j++) A[k]![j]! -= mm * A[i]![j]!; } } return A.map((r) => r[d]!); }
function egit(rows: { x: Float64Array[]; w: number }[], d: number, ridge: number): Float64Array { const w = new Float64Array(d); if (!d) return w; for (let it = 0; it < 30; it++) { const g = new Float64Array(d), H = new Float64Array(d * d);
  for (const q of rows) { const p = softmax(q.x.map((v) => { let t = 0; for (let i = 0; i < d; i++) t += v[i]! * w[i]!; return t; })); const m1 = new Float64Array(d); for (let i = 0; i < q.x.length; i++) for (let k = 0; k < d; k++) m1[k]! += p[i]! * q.x[i]![k]!; for (let k = 0; k < d; k++) g[k]! += m1[k]! - q.x[q.w]![k]!; for (let i = 0; i < q.x.length; i++) { const v = q.x[i]!, pi = p[i]!; for (let a = 0; a < d; a++) { const va = v[a]! * pi; for (let b = 0; b <= a; b++) H[a * d + b]! += va * v[b]!; } } for (let a = 0; a < d; a++) for (let b = 0; b <= a; b++) H[a * d + b]! -= m1[a]! * m1[b]!; }
  const N = rows.length; for (let a = 0; a < d; a++) { g[a] = g[a]! / N + ridge * w[a]!; for (let b = 0; b <= a; b++) { const v = H[a * d + b]! / N + (a === b ? ridge : 0); H[a * d + b] = v; H[b * d + a] = v; } }
  const st = coz(Array.from({ length: d }, (_, i) => [...Array.from({ length: d }, (_, j) => H[i * d + j]!), g[i]!]), d); let adim = 0; for (let i = 0; i < d; i++) { w[i]! -= st[i]!; adim = Math.max(adim, Math.abs(st[i]!)); } if (adim < 1e-8) break; } return w; }
type RS = { ll: number; t1: number; t3: number };
const A: RS[] = [], B: RS[] = [], C: RS[] = []; let siraSon = "";
for (let k = 0; k < 5; k++) { const bas = kesim[k]!, bit = k === 4 ? "9999" : kesim[k + 1]!; const tr = races.filter((r) => r.tarih < bas), te = races.filter((r) => r.tarih >= bas && r.tarih < bit);
  const mu = new Float64Array(D), sg = new Float64Array(D); for (let i = 0; i < D; i++) { let s = 0, n = 0; for (const r of tr) for (const x of r.runners) { const c = x.f[i]; if (c) { s += c[0]; n++; } } const m = n ? s / n : 0; let s2 = 0; for (const r of tr) for (const x of r.runners) { const c = x.f[i]; if (c) s2 += (c[0] - m) ** 2; } mu[i] = m; sg[i] = n ? Math.sqrt(s2 / n) || 1 : 1; }
  const zv = (x: { f: Cell[] }) => Float64Array.from({ length: D }, (_, i) => { const c = x.f[i]; return c ? c[1] * (c[0] - mu[i]!) / sg[i]! : 0; });
  const Ztr = tr.map((r) => ({ w: r.runners.findIndex((x) => x.k === 1), x: r.runners.map(zv) })); const Zte = te.map((r) => ({ w: r.runners.findIndex((x) => x.k === 1), x: r.runners.map(zv) }));
  // sıra: tekil güç (eğitim)
  const solo = Array.from({ length: D }, (_, i) => { const w = egit(Ztr.map((q) => ({ w: q.w, x: q.x.map((v) => Float64Array.of(v[i]!)) })), 1, 0.02); let ll = 0; for (const q of Ztr) { const p = softmax(q.x.map((v) => v[i]! * w[0]!)); ll += -Math.log(Math.max(p[q.w]!, 1e-15)); } return { i, ll: ll / Ztr.length }; }).sort((a, b) => a.ll - b.ll); const sira = solo.map((s) => s.i); siraSon = sira.map((i) => NAMES[i]).join(" > ");
  // Gram-Schmidt (regresyon): her yeni sütun, önceki ORTOGONAL sütunlara göre artık; katsayılar eğitimde öğrenilir
  const katsayi: number[][] = []; const ortTr = Ztr.map((q) => q.x.map(() => new Float64Array(D))); const ortTe = Zte.map((q) => q.x.map(() => new Float64Array(D)));
  sira.forEach((i, pos) => { const dO = pos; if (dO === 0) { katsayi.push([]); } else { const Am = Array.from({ length: dO + 1 }, () => new Array(dO + 2).fill(0)); // [1, önceki ortogonal sütunlar] + hedef
      Ztr.forEach((q, ri) => q.x.forEach((v, j) => { const x = [1, ...sira.slice(0, pos).map((_, p) => ortTr[ri]![j]![p]!)]; const y = v[i]!; for (let a = 0; a <= dO; a++) { for (let b = 0; b <= dO; b++) Am[a]![b]! += x[a]! * x[b]!; Am[a]![dO + 1]! += x[a]! * y; } }));
      for (let a = 1; a <= dO; a++) Am[a]![a]! += 1; katsayi.push(coz(Am.map((r) => [...r.slice(0, dO + 1), r[dO + 1]!]), dO + 1)); }
    const uygula = (Z: typeof Ztr, ort: Float64Array[][]) => Z.forEach((q, ri) => q.x.forEach((v, j) => { const b = katsayi[pos]!; let t = pos === 0 ? 0 : b[0]!; for (let p = 0; p < pos; p++) t += b[p + 1]! * ort[ri]![j]![p]!; ort[ri]![j]![pos] = v[i]! - t; })); uygula(Ztr, ortTr); uygula(Zte, ortTe); });
  const rOrt = (Z: typeof Ztr, ort: Float64Array[][]) => Z.map((q, ri) => ({ w: q.w, x: ort[ri]!.map((v) => Float64Array.from(v)) }));
  const wA = egit(Ztr, D, 0.02), wA0 = egit(Ztr, D, 1e-6), wB = egit(rOrt(Ztr, ortTr), D, 0.02); const teO = rOrt(Zte, ortTe);
  const ev = (q: { x: Float64Array[]; w: number }, w: Float64Array): RS => { const p = softmax(q.x.map((v) => { let t = 0; for (let i = 0; i < D; i++) t += v[i]! * w[i]!; return t; })); const sr = p.map((v, i) => ({ i, v })).sort((a, b) => b.v - a.v); return { ll: -Math.log(Math.max(p[q.w]!, 1e-15)), t1: sr[0]!.i === q.w ? 1 : 0, t3: sr.slice(0, 3).some((s) => s.i === q.w) ? 1 : 0 }; };
  Zte.forEach((q, ri) => { A.push(ev(q, wA)); B.push(ev(teO[ri]!, wB)); C.push(ev(q, wA0)); }); console.log("dış kat " + k + " tamam"); }
let sd0 = 7; const rn = () => (sd0 = (sd0 * 1664525 + 1013904223) % 4294967296) / 4294967296; const ci = (d: number[]) => { const o: number[] = []; for (let t = 0; t < 1000; t++) { let q = 0; for (let i = 0; i < d.length; i++) q += d[Math.floor(rn() * d.length)]!; o.push(q / d.length); } o.sort((a, b) => a - b); return [o[24]!, o[974]!]; };
const out: string[] = []; const P = (s = "") => { console.log(s); out.push(s); };
P("# ORTOGONALLEŞTİRİLMİŞ MODEL — SİNYALLER BİRBİRİNİ ENGELLİYOR MU? (as-of, ileri; " + A.length + " test yarışı) — " + new Date().toISOString().slice(0, 10)); P("Ortogonalleştirme sırası (son kat, tekil güç büyükten küçüğe): " + siraSon);
P("| Model | log-loss | Top1 | Top3 |"); P("|---|---|---|---|"); for (const [ad, r] of [["Orijinal, ridge 0.02 (canlı yapı)", A], ["Orijinal, ridgesiz (1e-6)", C], ["TAM ORTOGONAL, ridge 0.02", B]] as [string, RS[]][]) P("| " + ad + " | " + avg(r.map((x) => x.ll)).toFixed(4) + " | %" + (avg(r.map((x) => x.t1)) * 100).toFixed(1) + " | %" + (avg(r.map((x) => x.t3)) * 100).toFixed(1) + " |");
for (const [ad, r] of [["ortogonal − orijinal(ridge)", B], ["ridgesiz − orijinal(ridge)", C]] as [string, RS[]][]) { const d = r.map((x, i) => x.ll - A[i]!.ll); const c = ci(d); P("ΔLL " + ad + ": " + (avg(d) >= 0 ? "+" : "") + avg(d).toFixed(4) + " [" + c[0]!.toFixed(4) + ", " + c[1]!.toFixed(4) + "]" + (c[1]! < 0 ? " ✔ daha iyi" : c[0]! > 0 ? " ✘ daha kötü" : " ≈ fark yok")); }
P("\nOkuma: ortogonal model, aynı sinyallerin aynı bilgisini birbirinden arındırılmış sütunlarla verir. Doğrusal modelde tahmin yalnız ridge farkıyla değişebilir; log-loss farkı bu yüzden küçük beklenir. Büyük bir fark olsaydı 'sinyaller birbirini engelliyor' şüphesi doğrusal yapıda doğrulanırdı. Doğrusal-olmayan engellenme için ağaç karşılaştırmasına bakılmalı (ayrı rapor).");
fs.writeFileSync(".sinyal-veri/ortogonal-model-asof.md", out.join("\n"));
