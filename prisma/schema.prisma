generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  EDITOR
  ADMIN
}

enum Plan {
  FREE
  PREMIUM
}

enum Surface {
  CIM
  KUM
  SENTETIK
}

enum Breed {
  ARAP
  INGILIZ
}

enum Confidence {
  DUSUK
  ORTA
  YUKSEK
}

enum PedigreeRating {
  ZAYIF
  DUSUK
  ORTA
  GUCLU
  YUKSEK
  COK_YUKSEK
  SORU
  BILINMIYOR
}

enum ArticleType {
  EDUCATIONAL
  MAGAZINE
}

enum NotificationType {
  NEW_PREDICTION
  NEW_ARTICLE
  SYSTEM
  HORSE_RACE
}

// ─── AUTH & USERS ─────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  name             String?
  role             Role      @default(USER)
  plan             Plan      @default(FREE)
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  hasSeenIntro     Boolean   @default(false)
  marketingConsent Boolean   @default(false)
  // Takip edilen atlar bugün koşuyorsa girişte açılan popup — günde en fazla 1 kez
  // gösterilir (bkz. followed-horses-popup.actions.ts). hasSeenIntro'nun aksine KALICI
  // değil, her gün yeniden gösterilebilir olması gerektiği için tarih karşılaştırılıyor.
  followPopupShownAt DateTime?

  predictions   Prediction[]
  articles      Article[]
  notifications Notification[]
  horseFollows  HorseFollow[]
  accounts      Account[]
  sessions      Session[]
  loginLogs     LoginLog[]
  pageViews     PageView[]
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ip        String
  userAgent String   @default("")
  country   String?
  city      String?
  success   Boolean
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@index([success])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── RACE DOMAIN ──────────────────────────────────────────────────────────────

model Hippodrome {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  raceDays RaceDay[]
}

model RaceDay {
  id                String   @id @default(cuid())
  date              DateTime
  hippodromeId      String
  createdAt         DateTime @default(now())
  surfaceConditions Json? // TJK "conditions-race" bloğu — [{label:"Çim", detail:"Normal 3,3"}, ...]
  weather           String? // örn. "Hava: 26C,Az Bulutlu,Nem%64"

  hippodrome Hippodrome @relation(fields: [hippodromeId], references: [id])
  races      Race[]

  @@unique([date, hippodromeId])
}

model Race {
  id          String   @id @default(cuid())
  raceDayId   String
  raceNo      Int
  time        String?
  classType   String
  breed       Breed
  surface     Surface
  distance    Int
  conditions  String?
  ageWeight   String?
  trackRecord String?
  createdAt   DateTime @default(now())

  raceDay      RaceDay       @relation(fields: [raceDayId], references: [id], onDelete: Cascade)
  runners      Runner[]
  prediction   Prediction?
  result       Result?
  accuraceRace AccuraceRace?

  @@unique([raceDayId, raceNo])
}

model Runner {
  id                 String  @id @default(cuid())
  raceId             String
  no                 Int
  name               String
  sire               String?
  dam                String?
  damSire            String?
  adminNote          String?
  jockey             String?
  trainer            String?
  startNo            Int?
  disaridanStart     Boolean @default(false)
  weight             Float?
  weightChange       Float?
  equipment          String?
  equipmentAdded     String?
  equipmentRemoved   String?
  sameJockey         Boolean @default(false)
  agf                Float?
  raceStyle          Json?
  recentForm         String?
  jockeyChanged      Boolean @default(false)
  previousJockey     String?
  age                String?
  owner              String?
  hp                 Int?
  bestTime           String?
  recentFormSurfaces String?
  scratched          Boolean @default(false)
  ekuriGroup         Int?
  apprentice         Boolean @default(false)
  tjkAtId            Int?
  idmanVideoUrl      String?

  race           Race                 @relation(fields: [raceId], references: [id], onDelete: Cascade)
  gallops        Gallop[]
  picks          Pick[]
  agfSnapshots   AgfSnapshot[]
  accuraceSplits AccuraceHorseSplit[]

  @@unique([raceId, no])
  @@index([name])
}

/**
 * TJK'nın kendi Pedigri uç noktasından (Query/Pedigri/Pedigri?Atkodu=X) çekilen 3 kuşaklık
 * (14 atalı) tam soy ağacı — tjkAtId'ye göre KALICI olarak önbelleklenir (pedigri değişmez,
 * bir at kaç yarışa girerse girsin tek seferlik çekim yeterli). treeJson yapısı 14 alan:
 * sire/dam, sireSire/sireDam/damSire/damDam, ve 8 üçüncü kuşak — her biri
 * {name, year, note} veya null (bkz. src/server/services/ingest/tjk-pedigri.adapter.ts).
 */
model HorsePedigree {
  tjkAtId   Int      @id
  treeJson  Json
  updatedAt DateTime @default(now()) @updatedAt
}

/**
 * TJK "At Koşu Bilgileri" sayfasının kimlik/kazanç ve Zaman/Hipodrom/Jokey/Pist/Mesafe
 * kırılımlı istatistiklerinin KALICI önbelleği — pedigriden farklı olarak bu veri her yeni
 * koşudan sonra DEĞİŞİR, bu yüzden updatedAt'e göre periyodik olarak yeniden çekilir (bkz.
 * src/server/services/ingest/tjk-at-profil.adapter.ts, sync-horse-stats-cache cron'u).
 * Kullanıcı talebi 2026-07-30: "tüm atların tüm detayları çekilsin" — TJK'ya kullanıcı
 * tıkladıkça değil, arka planda toplu olarak gidilsin.
 */
model HorseStatsCache {
  tjkAtId           Int      @id
  profileJson       Json
  detailedStatsJson Json
  updatedAt         DateTime @default(now()) @updatedAt
}

/**
 * Bir atın istatistik/geçmiş çekimi ISRARLA (üst üste birkaç kez) başarısız olursa buraya
 * kaydedilir — kullanıcı talimatı 2026-07-30: "ısrarla başarısız olanları atla" — aksi halde
 * gerçekten hatalı/eksik bir TJK kaydı olan tek bir at, toplu dolum döngüsünü SONSUZA kadar
 * durdurmadan tekrar tekrar dener. attempts eşiği aşılınca o at gelecek taramalarda
 * `needsSync`'ten çıkarılır (syncHorseStatsCache) — sessizce değil, bu tabloda görünür kalır.
 */
model HorseSyncFailure {
  tjkAtId     Int      @id
  attempts    Int      @default(1)
  lastAttempt DateTime @default(now()) @updatedAt
}

/**
 * TJK'nın "At Koşu Bilgileri" tam yarış geçmişi tablosunun (tjk-at-performans.adapter.ts)
 * KALICI önbelleği — kullanıcı talebi 2026-07-30: analiz (Faz1/veri-toplama.ts) ve public
 * panellerin (H2H/Karşılaştır/Son Yarış Detayları) hepsi TJK'ya canlı gitmek yerine buradan
 * okusun, TJK'dan besleme yalnız arka plan cron'uyla (sync-horse-stats-cache) devam etsin.
 */
model HorseRaceHistoryCache {
  tjkAtId   Int      @id
  rowsJson  Json
  updatedAt DateTime @default(now()) @updatedAt
}

/**
 * AGF senkronizasyonu her çalıştığında (günde 4 kez) atılan an'lık AGF kaydı — zaman içindeki para hareketini (steam) görmek için.
 */
model AgfSnapshot {
  id         String   @id @default(cuid())
  runnerId   String
  agf        Float
  capturedAt DateTime @default(now())

  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@index([runnerId, capturedAt])
}

model Gallop {
  id       String   @id @default(cuid())
  runnerId String
  date     DateTime
  track    String?
  surface  Surface?
  jockey   String?
  form     String?
  splits   Json

  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@index([runnerId, date])
}

// Accurace.net (GPS/sektörel zamanlama sağlayıcısı) bir yarışın 100m'lik her
// bölümündeki sıra+geçiş süresini veriyor — TJK'nın resmi sitesi bunu hiç yayınlamıyor,
// yalnız bitiş derecesi/ganyan var. "raw" tam çözümlenmiş kaynak veriyi tutar (ileride
// yeniden işlemek — örn. yeni bir tempo metriği eklemek — için yeniden çekmeye gerek
// kalmasın diye); officialTimes TJK'nın resmi (Accurace'in KENDİ ölçümü değil) bitiş
// dereceleridir, sırayla (1.den sonuncuya) verilir.
model AccuraceRace {
  id            String   @id @default(cuid())
  raceId        String?  @unique
  date          DateTime
  citySlug      String
  hippodrome    String?
  raceNo        Int
  length        Int?
  ground        String?
  officialTimes Json?
  fetchedAt     DateTime @default(now())
  raw           Json

  race   Race?                @relation(fields: [raceId], references: [id], onDelete: SetNull)
  splits AccuraceHorseSplit[]

  @@unique([date, citySlug, raceNo])
}

// Bir atın bir yarıştaki her 100m'lik checkpoint'teki (kümülatif) geçiş süresi + o
// andaki sırası. checkpoints: [{checkpoint:100, timeReal:8443, place:1}, ...] (timeReal ms).
model AccuraceHorseSplit {
  id             String  @id @default(cuid())
  accuraceRaceId String
  runnerId       String?
  horseName      String
  horseNumber    Int
  place          Int
  finishTimeReal Int
  checkpoints    Json

  accuraceRace AccuraceRace @relation(fields: [accuraceRaceId], references: [id], onDelete: Cascade)
  runner       Runner?      @relation(fields: [runnerId], references: [id], onDelete: SetNull)

  @@unique([accuraceRaceId, horseNumber])
  @@index([horseName])
}

// ─── PREDICTION ───────────────────────────────────────────────────────────────

model Prediction {
  id           String     @id @default(cuid())
  raceId       String     @unique
  authorId     String
  confidence   Confidence @default(ORTA)
  notes        String
  tempo        String?
  couponNarrow String?
  couponNormal String?
  couponWide   String?
  isBanko      Boolean    @default(false)
  bankoNote    String?
  published    Boolean    @default(false)
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  race   Race   @relation(fields: [raceId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])
  picks  Pick[]

  @@index([published])
}

model Pick {
  id             String         @id @default(cuid())
  predictionId   String
  rank           Int
  runnerId       String?
  runnerLabel    String
  score          Int?
  details        Json
  pedigreeRating PedigreeRating @default(BILINMIYOR)
  isTarget       Boolean        @default(false)

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  runner     Runner?    @relation(fields: [runnerId], references: [id])

  @@unique([predictionId, rank])
}

// ─── RESULT ───────────────────────────────────────────────────────────────────

model Result {
  id          String   @id @default(cuid())
  raceId      String   @unique
  actualOrder Json
  winnerNo    Int? // birincil kazanan (geriye uyumluluk — beraberlikte winnerNos[0])
  winnerNos   Int[] @default([]) // TÜM kazananlar — at başı/beraberlik (dead heat) TJK'da birden fazla at aynı SONUCNO=1 alabilir
  ganyan      Float?
  time        String? // Müddet — kazananın resmi koşu süresi (örn. "1.20.11")
  farklar     String? // Farklar — ilk sıralar arasındaki mesafe farkları, TJK sırasıyla (örn. "Baş, 1, 2, Boyun")
  // "Geç Çıkış" — TJK'nın kendi resmi start-kalitesi tespiti (bkz. tjk-result.adapter.ts).
  // Bu koşuda geç kalkan at(lar), her biri {no, name, fark} — ör. [{"no":5,"name":"...","fark":"3 Boy"}].
  // Boş dizi/null = kimse geç kalkmadı (TJK'nın kendi işaretlemesine göre).
  gecCikanlar Json?
  hitTop1     Boolean  @default(false)
  hitInCoupon Boolean  @default(false)
  hitRanks    Json?
  errorTag    String?
  errorNote   String?
  cikan       String?
  enteredAt   DateTime @default(now())

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([hitTop1])
}

// ─── CONTENT ──────────────────────────────────────────────────────────────────

model Article {
  id              String      @id @default(cuid())
  type            ArticleType
  title           String
  slug            String      @unique
  excerpt         String?
  body            String
  coverImage      String?
  category        String?
  tags            String[]
  authorId        String
  published       Boolean     @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([type, published])
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ─── HORSE FOLLOWS ────────────────────────────────────────────────────────────

model HorseFollow {
  id        String   @id @default(cuid())
  userId    String
  horseName String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, horseName])
  @@index([userId])
}

// ─── CLAUDE API BÜTÇE TAKİBİ ───────────────────────────────────────────────────
// Anthropic'in kendisi kalan kredi bakiyesini API üzerinden vermiyor (yalnızca
// Console'da gösteriliyor) — bu yüzden her çağrının token kullanımını burada
// kendimiz kaydedip, admin'in girdiği başlangıç bakiyeden düşerek TAHMİNİ bir
// kalan bakiye hesaplıyoruz. Gerçek Anthropic bakiyesiyle birebir aynı olacağının
// garantisi yoktur.

model ClaudeUsageLog {
  id                       String   @id @default(cuid())
  createdAt                DateTime @default(now())
  raceId                   String?
  phase                    String // "faz2" | "faz4"
  model                    String
  inputTokens              Int
  outputTokens             Int
  // Prompt cache (Faz2/Faz4 arasında paylaşılan bağlam) devreye girdikten sonra eklendi —
  // bunlar olmadan gerçek maliyet olduğundan DÜŞÜK görünüyordu, çünkü cache yazma/okuma
  // token'ları inputTokens'a hiç dahil değil (Anthropic bunları ayrı sayaçlarda döner).
  cacheCreationInputTokens Int      @default(0)
  cacheReadInputTokens     Int      @default(0)
  // cacheCreationInputTokens'ın 1 saatlik TTL'li kısmı (2x fiyat) — kalanı (toplam eksi bu)
  // 5 dakikalık TTL'li kısımdır (1.25x fiyat). Anthropic bu ikisini usage.cache_creation
  // altında ayrı ayrı döner (ephemeral_1h_input_tokens/ephemeral_5m_input_tokens) — doğru
  // maliyet hesaplamak için ayrı saklanır (v6.31, metodoloji bloğu artık 1sa cache'leniyor).
  cacheCreation1hInputTokens Int    @default(0)
  // Claude'un ham yanıt metni (extractText sonrası) — Vercel platform zaman aşımı
  // Claude başarıyla yanıtladıktan SONRA ama istemciye ulaşmadan ÖNCE fonksiyonu
  // kesebiliyor ("boşa ödeme"). Bu alan sayesinde hemen ardından gelen "tekrar dene"
  // Claude'u yeniden çağırıp ikinci kez ücretlendirmek yerine bu kaydı kullanabilir.
  resultText               String?  @db.Text
  // İsteğin gönderilmesinden yanıtın alınmasına kadar geçen süre (ms) — admin panelde
  // "hangi analiz kaç dakika sürdü" tablosu için (kullanıcı talebi). Eski kayıtlarda yok.
  durationMs               Int?

  @@index([createdAt])
  @@index([raceId, phase, createdAt])
}

model ClaudeBudget {
  id          String   @id @default(cuid())
  startingUsd Float
  resetAt     DateTime @default(now())
  note        String?
}

// v6.77 — kullanıcı kararı 2026-08-10: hipodromx.com'dan elle yapıştırılan SireStat/DamStat
// modelleri (aşağıdaki SireStatOwn/DamStatOwn'dan FARKLI — bunlar hiç kullanılmıyordu, analiz
// akışına zaten girmiyorlardı, "hipodromx'e ait hiçbir veri/iz kalmasın" talimatıyla admin
// sayfaları/formları/parser'larıyla birlikte koddan VE veritabanından tamamen kaldırıldı.

// rotaganyan'ın KENDİ Runner/Result verisinden hesaplanan aygır istatistiği. Yalnız
// irk×pist×mesafe kırılımı var (kendi örneklemimiz küçük, daha ince kırılım örneklemi
// anlamsızlaştırır). AEI/ikramiye hesaplanamıyor çünkü şemada hiçbir yerde ödül/purse verisi yok.
model SireStatOwn {
  id        String   @id @default(cuid())
  sireName  String
  irk       String
  pist      String // surfaceToPist() değeri
  mesafe    String // mesafeBucket() değeri
  start     Int
  birinci   Int
  ikinci    Int
  ucuncu    Int
  dorduncu  Int
  besinci   Int
  kYuzde    Float
  updatedAt DateTime @updatedAt

  @@unique([sireName, irk, pist, mesafe])
  @@index([sireName])
  @@index([irk, pist, mesafe])
}

// DamStatOwn — bkz. SireStatOwn yorumu, aynı mantık kısrak+kısrak babası için.
model DamStatOwn {
  id          String   @id @default(cuid())
  damName     String
  damSireName String
  irk         String
  pist        String
  mesafe      String
  start       Int
  birinci     Int
  ikinci      Int
  ucuncu      Int
  dorduncu    Int
  besinci     Int
  kYuzde      Float
  // 2026-07-24: kullanıcı isteği — "kazanan tay oranı" (kaç FARKLI yavrunun en az 1
  // galibiyeti var / toplam farklı yavru). start/birinci YARIŞ bazlı (aynı at birden
  // fazla start/galibiyet üretebilir) — bu ikisi ise AT (yavru) bazlı, distinct Runner.name
  // gruplamasıyla hesaplanır. hipodromx bunu vermiyor (yalnız kendi verimizde mümkün).
  yavruSayisi        Int @default(0)
  kazananYavruSayisi Int @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([damName, damSireName, irk, pist, mesafe])
  @@index([damName])
  @@index([irk, pist, mesafe])
}

// Damsire'nin (kısrağın babası) KENDİ BAŞINA etkisi — DamStatOwn'dan farklı olarak dam
// ADI hiç sayılmıyor, damSireName'e göre TÜM farklı kısraklardan gelen yavrular birlikte
// gruplanıyor (kullanıcı doktrini 2026-07-26: "damsire atın fiziksel/mizaç profili üzerinde
// önemli etki taşır, aygır+kısrak yanında üçüncü ayrı bir istatistik olarak izlenmeli").
// torunSayisi/kazananTorunSayisi = DamStatOwn'daki yavru kavramının bir kuşak ötesi hali.
model DamSireStatOwn {
  id            String   @id @default(cuid())
  damSireName   String
  irk           String
  pist          String
  mesafe        String
  start         Int
  birinci       Int
  ikinci        Int
  ucuncu        Int
  dorduncu      Int
  besinci       Int
  kYuzde        Float
  torunSayisi        Int @default(0)
  kazananTorunSayisi Int @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([damSireName, irk, pist, mesafe])
  @@index([damSireName])
}

// v6.78 — kullanıcı kararı 2026-08-10 ("site genelinde kullanılmayan veri" taraması):
// SireDosageStat (rafa kaldırılmış Dosage/DI-CD özelliği, hiç okunmuyordu),
// TrainerEquipmentStatOwn/JockeyPistMesafeSkkStatOwn/JokeyAntrenorKombinasyonStatOwn
// (üçü de gece cron'larıyla yazılıyordu ama hiçbir yerde okunmuyordu, v6.24/v6.26
// kararıyla analiz akışından zaten çıkarılmışlardı) tamamen kaldırıldı — modeller,
// onları besleyen cron rotaları/servisleri/action dosyaları koddan silindi.

// ─── METHODOLOGY ──────────────────────────────────────────────────────────────

model MethodologyVersion {
  id            String   @id @default(cuid())
  version       String   @unique
  effectiveDate DateTime
  content       String
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ─── ANASAYFA KUPON ───────────────────────────────────────────────────────────

// Admin'in manuel kurduğu çok ayaklı kombine kupon (Ekonomik/Normal/Geniş) — anasayfada gösterilir.
model HomeKupon {
  id             String   @id @default(cuid())
  hippodromeName String
  date           DateTime
  legs           Json // [{ raceNo: number, narrow: number[], normal: number[], wide: number[] }]
  slot           Int      @default(1) // 1 = 1. Altılı, 2 = 2. Altılı — her slot kendi başına aktif olabilir
  isActive       Boolean  @default(false)
  // TJK'nın resmi "6'lı Ganyan X TL vermiştir." cümlesi — yalnız gün sonu arşivlenirken
  // (archive-kupon cron) yakalanabilir, TJK'nın ilgili sayfası geçmişe dönük sorgu
  // desteklemiyor (her zaman "bugün"). Bu yüzden yalnız BUNDAN SONRAKİ arşivlenen
  // kayıtlarda dolu olur, geçmişe dönük doldurulamaz. null = yakalanamadı/henüz arşivlenmedi.
  ikramiye       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([slot])
}

// ─── SITE SETTINGS ───────────────────────────────────────────────────────────

model SiteSetting {
  key       String   @id // örn. "banner_url"
  value     String
  updatedAt DateTime @updatedAt
}

// ─── BANNER SLIDES ───────────────────────────────────────────────────────────

model BannerSlide {
  id          String   @id @default(cuid())
  url         String
  storagePath String // Supabase'deki dosya yolu (silme için)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([active, order])
}

// ─── JOKEY STAT SYNC (TJK'dan çekilen) ───────────────────────────────────────

model JockeyStatSync {
  id               String    @id @default(cuid())
  jockey           String
  hippoSlug        String // "overall" veya hippodrome slug (ankara, istanbul, ...)
  year             Int
  breed            String? // "INGILIZ" | "ARAP" | null = hepsi
  surface          String? // "CIM" | "KUM" | "SENTETIK" | null = hepsi
  rides            Int
  wins             Int
  place2           Int
  place3           Int
  place4           Int
  place5           Int
  tableCount       Int
  winRate          Float
  tableRate        Float
  prizeTl          Int
  performanceScore Float?
  confidenceLabel  String?
  updatedAt        DateTime  @updatedAt

  @@unique([jockey, hippoSlug, year, breed, surface])
  @@index([hippoSlug, year, breed, surface])
  @@index([jockey, year])
}

// ─── ANTRENÖR STAT SYNC (TJK'dan çekilen) ────────────────────────────────────

model TrainerStatSync {
  id        String   @id @default(cuid())
  trainer   String
  year      Int
  rides     Int
  wins      Int
  winRate   Float
  updatedAt DateTime @updatedAt

  @@unique([trainer, year])
  @@index([trainer, year])
}

// ─── PAGE VIEWS ───────────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  userId    String?
  path      String
  duration  Int?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([path])
  @@index([createdAt(sort: Desc)])
}
