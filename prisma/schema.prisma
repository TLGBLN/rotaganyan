generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  EDITOR
  ADMIN
}

enum Plan {
  FREE
  PREMIUM
}

enum Surface {
  CIM
  KUM
  SENTETIK
}

enum Breed {
  ARAP
  INGILIZ
}

enum Confidence {
  DUSUK
  ORTA
  YUKSEK
}

enum PedigreeRating {
  ZAYIF
  DUSUK
  ORTA
  GUCLU
  YUKSEK
  COK_YUKSEK
  SORU
  BILINMIYOR
}

enum ArticleType {
  EDUCATIONAL
  MAGAZINE
}

enum NotificationType {
  NEW_PREDICTION
  NEW_ARTICLE
  SYSTEM
  HORSE_RACE
}

// ─── AUTH & USERS ─────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  name             String?
  role             Role      @default(USER)
  plan             Plan      @default(FREE)
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  hasSeenIntro     Boolean   @default(false)
  marketingConsent Boolean   @default(false)
  // Takip edilen atlar bugün koşuyorsa girişte açılan popup — günde en fazla 1 kez
  // gösterilir (bkz. followed-horses-popup.actions.ts). hasSeenIntro'nun aksine KALICI
  // değil, her gün yeniden gösterilebilir olması gerektiği için tarih karşılaştırılıyor.
  followPopupShownAt DateTime?

  predictions   Prediction[]
  articles      Article[]
  articleLikes  ArticleLike[]
  notifications Notification[]
  horseFollows  HorseFollow[]
  accounts      Account[]
  sessions      Session[]
  loginLogs     LoginLog[]
  pageViews     PageView[]
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ip        String
  userAgent String   @default("")
  country   String?
  city      String?
  success   Boolean
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@index([success])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── RACE DOMAIN ──────────────────────────────────────────────────────────────

model Hippodrome {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  // 2026-09-29 kullanıcı talebi: TJK'nın kendi sitesinde zaten listelenen yurt dışı
  // simulcast fikstürleri (Chantilly, Bath, ...) de programa eklendi — additive alanlar.
  // isForeign: TR dışı bir hipodrom mu (program ingest'i bunu true yazar; TR hipodromları
  // false/default). country: TJK'nın verdiği ülke adı (ör. "Fransa"), yalnız yabancı
  // hipodromlarda dolu — /program'da başlık/etiket için. Model eğitimi/istatistik
  // GERCEK_OLMAYAN_HIPODROM_SLUGLARI ile AYNI mantıkla bu alanı da hariç tutar (bkz.
  // admin.service.ts, yakinsama-gecmis.ts, veri-tamligi.service.ts) — V5.46'nın TR'ye
  // özel sinyalleri (hız/jokey/antrenör/sire oranı) yabancı at/jokey için anlamsız olur.
  isForeign Boolean   @default(false)
  country   String?
  raceDays  RaceDay[]
}

model RaceDay {
  id                String   @id @default(cuid())
  date              DateTime
  hippodromeId      String
  createdAt         DateTime @default(now())
  surfaceConditions Json? // TJK "conditions-race" bloğu — [{label:"Çim", detail:"Normal 3,3"}, ...]
  weather           String? // örn. "Hava: 26C,Az Bulutlu,Nem%64"

  hippodrome Hippodrome @relation(fields: [hippodromeId], references: [id])
  races      Race[]

  @@unique([date, hippodromeId])
  // 2026-08-13 — Supabase lint uyarısı (unindexed foreign key) üzerine doğrudan
  // veritabanında (Supabase SQL editörü) eklendi; burada yalnız şemayı gerçek
  // durumla senkron tutmak için tanımlandı — prisma migrate ÇALIŞTIRILMADI.
  @@index([hippodromeId], map: "ix_RaceDay_hippodromeId")
}

model Race {
  id          String   @id @default(cuid())
  raceDayId   String
  raceNo      Int
  time        String?
  classType   String
  breed       Breed
  surface     Surface
  distance    Int
  conditions  String?
  ageWeight   String?
  trackRecord String?
  // 2026-08-24 kullanıcı talebi — TJK program sayfasının ".race-share" bloğu (Ikramiye/
  // Yetiştirici Primi/At Sahibi Primi, her biri 1.-5. sıra kırılımlı) — sınıf hiyerarşisi
  // ikramiye üzerinden de karşılaştırılabilsin diye. {ikramiye:number[5], yetistiriciPrimi:
  // number[5], atSahibiPrimi:number[5]} — index 0 = 1.lik. Değer yoksa null.
  ikramiyeDetay Json?
  createdAt   DateTime @default(now())

  // v6.99 — kullanıcı kararı 2026-08-10: eşzamanlılık kilidi (analysis-concurrency-lock.ts).
  // Aynı koşu için iki paralel analiz tetiklemesi (çift tık, cron+manuel çakışması) aynı
  // Claude çağrılarını tekrarlayabiliyordu — ClaudeUsageLog önbelleği bunu TAM engellemez
  // (iki istek aynı anda "önbellekte yok" görebilir). Basit metin alanı (gerçek Postgres
  // enum DEĞİL) — "IDLE"|"IN_PROGRESS", kod tarafında kontrol edilir.
  analysisStatus    String    @default("IDLE")
  analysisClaimedAt DateTime?

  raceDay        RaceDay         @relation(fields: [raceDayId], references: [id], onDelete: Cascade)
  runners        Runner[]
  prediction     Prediction?
  result         Result?
  pendingResult  PendingResult?
  accuraceRace   AccuraceRace?
  challengerRuns ChallengerRun[]
  yurtDisiPrediction YurtDisiPrediction?

  @@unique([raceDayId, raceNo])
}

model Runner {
  id                 String  @id @default(cuid())
  raceId             String
  no                 Int
  name               String
  sire               String?
  dam                String?
  damSire            String?
  adminNote          String?
  jockey             String?
  trainer            String?
  startNo            Int?
  disaridanStart     Boolean @default(false)
  weight             Float?
  weightChange       Float?
  equipment          String?
  equipmentAdded     String?
  equipmentRemoved   String?
  sameJockey         Boolean @default(false)
  agf                Float?
  raceStyle          Json?
  recentForm         String?
  jockeyChanged      Boolean @default(false)
  previousJockey     String?
  age                String?
  owner              String?
  hp                 Int?
  bestTime           String?
  recentFormSurfaces String?
  scratched          Boolean @default(false)
  ekuriGroup         Int?
  apprentice         Boolean @default(false)
  tjkAtId            Int?
  // 2026-09-29 — yalnız yurt dışı (isForeign) hipodromlardaki atlarda dolu (negatif TJK
  // ID, "AtKosuBilgileri_Y" sayfasından) — TR atları asla taşımaz, tjkAtId'den TAMAMEN
  // AYRI ve bağımsız (downstream TR servisleri buna hiç bakmaz). Bkz. tjk.adapter.ts.
  yurtDisiAtId       Int?
  idmanVideoUrl      String?

  race           Race                 @relation(fields: [raceId], references: [id], onDelete: Cascade)
  gallops        Gallop[]
  picks          Pick[]
  agfSnapshots   AgfSnapshot[]
  accuraceSplits AccuraceHorseSplit[]
  yurtDisiPicks  YurtDisiPick[]

  @@unique([raceId, no])
  @@index([name])
}

/**
 * Analiz Motoru YD V1.0 — yurt dışı koşular için TR'nin Prediction/Pick'inden TAMAMEN
 * AYRI bir tahmin kaydı (kullanıcı kararı, 2026-09-30). TR'deki editoryal alanların
 * (authorId/notes/confidence/banko/Anormal Pist Modu/Race Context Invalidation vb.)
 * HİÇBİRİ yok — bu tamamen otomatik/algoritmik, insan editörü olmayan bir skor.
 * Bkz. src/lib/methodology/yd-engine.ts.
 */
model YurtDisiPrediction {
  id            String   @id @default(cuid())
  raceId        String   @unique
  engineVersion String   @default("YD-1.0")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  race  Race           @relation(fields: [raceId], references: [id], onDelete: Cascade)
  picks YurtDisiPick[]
}

model YurtDisiPick {
  id           String @id @default(cuid())
  predictionId String
  rank         Int
  runnerId     String
  score        Float
  // yd-engine.ts'in YdSinyaller şekli — şeffaflık için: hangi sinyal ne puan verdi.
  signals      Json

  prediction YurtDisiPrediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  runner     Runner             @relation(fields: [runnerId], references: [id])

  @@unique([predictionId, rank])
}

/**
 * TJK'nın kendi Pedigri uç noktasından (Query/Pedigri/Pedigri?Atkodu=X) çekilen 3 kuşaklık
 * (14 atalı) tam soy ağacı — tjkAtId'ye göre KALICI olarak önbelleklenir (pedigri değişmez,
 * bir at kaç yarışa girerse girsin tek seferlik çekim yeterli). treeJson yapısı 14 alan:
 * sire/dam, sireSire/sireDam/damSire/damDam, ve 8 üçüncü kuşak — her biri
 * {name, year, note} veya null (bkz. src/server/services/ingest/tjk-pedigri.adapter.ts).
 */
model HorsePedigree {
  tjkAtId   Int      @id
  treeJson  Json
  updatedAt DateTime @default(now()) @updatedAt
}

/**
 * TJK "At Koşu Bilgileri" sayfasının kimlik/kazanç ve Zaman/Hipodrom/Jokey/Pist/Mesafe
 * kırılımlı istatistiklerinin KALICI önbelleği — pedigriden farklı olarak bu veri her yeni
 * koşudan sonra DEĞİŞİR, bu yüzden updatedAt'e göre periyodik olarak yeniden çekilir (bkz.
 * src/server/services/ingest/tjk-at-profil.adapter.ts, sync-horse-stats-cache cron'u).
 * Kullanıcı talebi 2026-07-30: "tüm atların tüm detayları çekilsin" — TJK'ya kullanıcı
 * tıkladıkça değil, arka planda toplu olarak gidilsin.
 */
model HorseStatsCache {
  tjkAtId           Int      @id
  profileJson       Json
  detailedStatsJson Json
  updatedAt         DateTime @default(now()) @updatedAt
}

/**
 * Bir atın istatistik/geçmiş çekimi ISRARLA (üst üste birkaç kez) başarısız olursa buraya
 * kaydedilir — kullanıcı talimatı 2026-07-30: "ısrarla başarısız olanları atla" — aksi halde
 * gerçekten hatalı/eksik bir TJK kaydı olan tek bir at, toplu dolum döngüsünü SONSUZA kadar
 * durdurmadan tekrar tekrar dener. attempts eşiği aşılınca o at gelecek taramalarda
 * `needsSync`'ten çıkarılır (syncHorseStatsCache) — sessizce değil, bu tabloda görünür kalır.
 */
model HorseSyncFailure {
  tjkAtId     Int      @id
  attempts    Int      @default(1)
  lastAttempt DateTime @default(now()) @updatedAt
}

/**
 * TJK'nın "At Koşu Bilgileri" tam yarış geçmişi tablosunun (tjk-at-performans.adapter.ts)
 * KALICI önbelleği — kullanıcı talebi 2026-07-30: analiz (Faz1/veri-toplama.ts) ve public
 * panellerin (H2H/Karşılaştır/Son Yarış Detayları) hepsi TJK'ya canlı gitmek yerine buradan
 * okusun, TJK'dan besleme yalnız arka plan cron'uyla (sync-horse-stats-cache) devam etsin.
 */
model HorseRaceHistoryCache {
  tjkAtId   Int      @id
  rowsJson  Json
  updatedAt DateTime @default(now()) @updatedAt
}

/**
 * Yurt dışı (simulcast) atların TJK "AtKosuBilgileri_Y" sayfasından (negatif AtId —
 * Runner.yurtDisiAtId, tjkAtId'den TAMAMEN AYRI/bağımsız) çekilen tam yarış geçmişi.
 * HorseRaceHistoryCache'in BİREBİR aynı deseni (id+rowsJson+updatedAt) — ama KASITLI
 * olarak AYRI bir tablo/adapter: TR akışına hiçbir şekilde karışmasın diye (bkz.
 * tjk-at-yurtdisi.adapter.ts, kullanıcı kararı 2026-09-29 "tr yarışları ile yabancı
 * yarışlar birbirinden ayrı olacak"). V5.46'dan TAMAMEN BAĞIMSIZ, ayrı bir yurt dışı
 * analiz motorunun (henüz yazılmadı) ham veri temeli — bu tablo yalnız VERİYİ tutar,
 * hiçbir skor/analiz mantığı içermez.
 */
model YurtDisiAtRaceHistoryCache {
  yurtDisiAtId Int      @id
  rowsJson     Json
  // 2026-09-29 — TR'de HorseStatsCache'in AYRI bir tablo+sayfa olarak tuttuğu kimlik/kariyer
  // özet istatistiği (K./1.lik/2.lik/3.lük/Kazanç — TOPLAM + yıl + PİST bazlı kırılım),
  // yurt dışı atlarda AYNI sayfada (AtKosuBilgileri_Y) geldiği için ayrı bir tabloya/isteğe
  // gerek kalmadan buraya eklendi. Bkz. tjk-at-yurtdisi.adapter.ts.
  profileJson  Json?
  updatedAt    DateTime @default(now()) @updatedAt
}

/**
 * AGF senkronizasyonu her çalıştığında (günde 4 kez) atılan an'lık AGF kaydı — zaman içindeki para hareketini (steam) görmek için.
 */
model AgfSnapshot {
  id         String   @id @default(cuid())
  runnerId   String
  agf        Float
  capturedAt DateTime @default(now())

  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@index([runnerId, capturedAt])
}

model Gallop {
  id       String   @id @default(cuid())
  runnerId String
  date     DateTime
  track    String?
  surface  Surface?
  jockey   String?
  form     String?
  splits   Json

  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@index([runnerId, date])
}

// Accurace.net (GPS/sektörel zamanlama sağlayıcısı) bir yarışın 100m'lik her
// bölümündeki sıra+geçiş süresini veriyor — TJK'nın resmi sitesi bunu hiç yayınlamıyor,
// yalnız bitiş derecesi/ganyan var. "raw" tam çözümlenmiş kaynak veriyi tutar (ileride
// yeniden işlemek — örn. yeni bir tempo metriği eklemek — için yeniden çekmeye gerek
// kalmasın diye); officialTimes TJK'nın resmi (Accurace'in KENDİ ölçümü değil) bitiş
// dereceleridir, sırayla (1.den sonuncuya) verilir.
model AccuraceRace {
  id            String   @id @default(cuid())
  raceId        String?  @unique
  date          DateTime
  citySlug      String
  hippodrome    String?
  raceNo        Int
  length        Int?
  ground        String?
  officialTimes Json?
  fetchedAt     DateTime @default(now())
  raw           Json

  race   Race?                @relation(fields: [raceId], references: [id], onDelete: SetNull)
  splits AccuraceHorseSplit[]

  @@unique([date, citySlug, raceNo])
}

// Bir atın bir yarıştaki her 100m'lik checkpoint'teki (kümülatif) geçiş süresi + o
// andaki sırası. checkpoints: [{checkpoint:100, timeReal:8443, place:1}, ...] (timeReal ms).
model AccuraceHorseSplit {
  id             String  @id @default(cuid())
  accuraceRaceId String
  runnerId       String?
  horseName      String
  horseNumber    Int
  place          Int
  finishTimeReal Int
  checkpoints    Json

  accuraceRace AccuraceRace @relation(fields: [accuraceRaceId], references: [id], onDelete: Cascade)
  runner       Runner?      @relation(fields: [runnerId], references: [id], onDelete: SetNull)

  @@unique([accuraceRaceId, horseNumber])
  @@index([horseName])
}

// ─── PREDICTION ───────────────────────────────────────────────────────────────

model Prediction {
  id           String     @id @default(cuid())
  raceId       String     @unique
  authorId     String
  confidence   Confidence @default(ORTA)
  notes        String
  tempo        String?
  couponNarrow String?
  couponNormal String?
  couponWide   String?
  isBanko      Boolean    @default(false)
  bankoNote    String?
  // 2026-08-23 — schema.prisma'dan silinmişti ama veritabanında hâlâ vardı (530 satır,
  // hepsi false, kodda hiç kullanılmıyor) — db push'un onu SİLMESİNİ önlemek için (ilgisiz
  // bir işlem sırasında istenmeyen veri kaybı riski) geri eklendi. Aktif olarak kullanılmıyor.
  manualOverride Boolean  @default(false)
  published    Boolean    @default(false)
  publishedAt  DateTime?
  // 2026-09-16 — Anormal Pist Modu v1 (bkz. src/lib/methodology/anormal-pist-risk.ts):
  // V5.46 skoruna HİÇ girmez, yalnız yayın anında hesaplanıp SAKLANAN bir risk
  // değerlendirmesi — Banko kapısını ve public rozetini besler. pistAnormalMi false
  // (büyük çoğunluk gün) ise diğer üçü hep null.
  pistAnormalMi      Boolean @default(false)
  pistDuyarliligi    String? // "STABIL" | "HASSAS" | "COK_HASSAS"
  gecmisRiskSeviyesi String? // "YETERLI" | "SINIRLI" | "YETERSIZ"
  pistUyariMesaji    String? // public'e gösterilecek, sayısal detay İÇERMEYEN gerekçe
  // 2026-09-21 — Race Context Invalidation Faz 1 (bkz. proje hafızası
  // project_race_context_invalidation_faz1.md): admin-only STALE tespiti, public/kupon
  // tarafına HİÇBİR otomatik davranış değişikliği getirmez (bkz. feedback_otomatik_stale_reddedildi).
  status              String    @default("ACTIVE") // ACTIVE | STALE
  criticalContextHash String?   // null = eski kayıt/baseline yok → cron STALE ÜRETMEZ
  marketSnapshotHash  String?   // yalnız AGF/pay — STALE ÜRETMEZ, Faz 2 audit'i için
  contextSnapshotJson Json?     // analizin üretildiği ANDAKİ kritik context
  staleAt             DateTime?
  staleReason         String?   // yapılı diff'in kısa özeti, ör. "surface: CIM→KUM"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  race    Race                @relation(fields: [raceId], references: [id], onDelete: Cascade)
  author  User                @relation(fields: [authorId], references: [id])
  picks   Pick[]
  history PredictionHistory[]

  @@index([published])
}

// 2026-09-21 — Race Context Invalidation Faz 1: supersede edilen Prediction içeriğinin
// append-only arşivi. Yalnız İLK ACTIVE→STALE geçişinde bir satır yazılır (idempotent —
// bkz. proje hafızası); başarılı yeniden-analiz İKİNCİ bir satır ÜRETMEZ.
model PredictionHistory {
  id                  String   @id @default(cuid())
  predictionId        String
  raceId              String
  criticalContextHash String
  snapshotJson        Json     // supersede edilen Prediction'ın TAM içeriği
  changedFieldsJson   Json?    // yapılı diff ({field, oldValue, newValue}[])
  archivedAt          DateTime @default(now())

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@index([raceId])
  @@index([predictionId])
}

model Pick {
  id             String         @id @default(cuid())
  predictionId   String
  rank           Int
  runnerId       String?
  runnerLabel    String
  score          Int?
  // 2026-09-13 kullanıcı bulgusu (İstanbul K5, MİHRA FARAH/POTOCHNITSA) — score Int'e
  // yuvarlanınca iki at aynı tam sayıya düşüp EKRANDA eşitmiş gibi görünebiliyor (11=11),
  // oysa gerçek olasılıkları farklı (%25.6 vs %24.8) — kupon otomatik doldurma/sıralama bu
  // sahte eşitliğe göre yanlış tercih yapabiliyor. Ham (yuvarlanmamış) olasılık*100 burada
  // ayrıca saklanıyor, yalnız V5AnalysisPanel'in kaydettiği YENİ pick'lerde dolu (nullable,
  // eski kayıtlar etkilenmez).
  scoreExact     Float?
  details        Json
  pedigreeRating PedigreeRating @default(BILINMIYOR)
  isTarget       Boolean        @default(false)

  // 2026-08-28 — V6 mimarisi (bkz. plan): P(WIN) zaten `score`'da (olasilik*100) donuyordu,
  // ama P(TOP2)/P(TOP3) hic modellenmiyordu (top3 yalnizca "ilk 3 siralamada mi" seklinde
  // TURETILIYORDU, kendi basina kalibre edilmis bir olasilik degildi). Plackett-Luce
  // ozyinelemeli kaldirma formuluyle, MEVCUT/zaten canli 12-ozellikli modelin ustune saf
  // matematikle hesaplaniyor - yeni egitim/veri gerektirmiyor. marketBlindProb1, AGF-turevi
  // ozelliklerin katkisi cikarilip TUM sahanin AYRICA softmax'tan gecirilmesiyle bulunan
  // "piyasayi hic gormeseydi ne derdi" skoru. featureSnapshot, kaydedilme anindaki ham/
  // standart vektor + katkilar + kullanilan agirlik seti - gelecekte bu tahmini yeniden
  // degerlendirmek icin CANLI veriyi tekrar cekmeye gerek kalmasin diye (bugun ogrenildi:
  // canli yeniden-hesaplama AGF'nin zamanla degismesi yuzunden guvenilmez, bkz. memory).
  // Hepsi nullable/additive - eski Pick'ler etkilenmez, assertPublishSafe DEGISMEDI.
  probTop2         Float?
  probTop3         Float?
  marketBlindProb1 Float?
  featureSnapshot  Json?

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  runner     Runner?    @relation(fields: [runnerId], references: [id])

  @@unique([predictionId, rank])
}

// 2026-08-28 — V6 champion/challenger altyapisi (bkz. plan). Prediction/Pick'e KASITLI
// olarak HIC dokunmuyor - bu yuzden yapisal olarak assertPublishSafe'i/published durumunu
// asla etkileyemez. Bir challenger (yeni ozellik/model varyanti denemesi) her gece,
// sonucu henuz gelmemis koşular icin SESSIZCE calisip kendi tahminini + o anki canli
// (champion) tahmini birlikte dondurur - hicbir kullaniciya/admin'e gosterilmez. Yeterli
// ornek (~250-300 sonuclanmis golge-kosu, bugunku Handikap n=307-yetersiz dersiyle
// tutarli) birikince B=500 bootstrap FARK testiyle degerlendirilir, terfi HER ZAMAN elle.
model ChallengerRun {
  id               String    @id @default(cuid())
  raceId           String
  challengerKey    String // ör. "v6-agfblind-test" - hangi deneme/varyant oldugunu isaretler
  computedAt       DateTime  @default(now())
  faz1Snapshot     Json // gatherFaz1V5 ciktisinin o anki dondurulmus hali
  championSnapshot Json // AYNI anda dondurulmus canli (mevcut/champion) faz2V5Sirala ciktisi
  challengerOutput Json // challenger'in kendi sirali/olasilik ciktisi
  raceDayDate      DateTime // ucuz sorgulama icin denormalize
  evaluatedAt      DateTime?

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, challengerKey])
  @@index([challengerKey, evaluatedAt])
}

// ─── RESULT ───────────────────────────────────────────────────────────────────

model Result {
  id          String   @id @default(cuid())
  raceId      String   @unique
  actualOrder Json
  winnerNo    Int? // birincil kazanan (geriye uyumluluk — beraberlikte winnerNos[0])
  winnerNos   Int[] @default([]) // TÜM kazananlar — at başı/beraberlik (dead heat) TJK'da birden fazla at aynı SONUCNO=1 alabilir
  ganyan      Float?
  time        String? // Müddet — kazananın resmi koşu süresi (örn. "1.20.11")
  farklar     String? // Farklar — ilk sıralar arasındaki mesafe farkları, TJK sırasıyla (örn. "Baş, 1, 2, Boyun")
  // "Geç Çıkış" — TJK'nın kendi resmi start-kalitesi tespiti (bkz. tjk-result.adapter.ts).
  // Bu koşuda geç kalkan at(lar), her biri {no, name, fark} — ör. [{"no":5,"name":"...","fark":"3 Boy"}].
  // Boş dizi/null = kimse geç kalkmadı (TJK'nın kendi işaretlemesine göre).
  gecCikanlar Json?
  hitTop1     Boolean  @default(false)
  hitInCoupon Boolean  @default(false)
  hitRanks    Json?
  errorTag    String?
  errorNote   String?
  cikan       String?
  enteredAt   DateTime @default(now())

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([hitTop1])
}

// 2026-09-06 kullanıcı bulgusu (İstanbul K5, MOLFIT/AZİMLİ) — TJK, bir koşunun sonucunu
// yayınladıktan SONRA (itiraz/foto-finiş incelemesi) değiştirebiliyor; result-sync.ts'in
// eski "ganyan varsa kesinleşmiştir" varsayımı bunu yakalayamadı — geçici/yanlış bir
// kazanan ganyan değeriyle birlikte gelip kalıcı Result olarak yazıldı. Artık HİÇBİR
// sonuç, aynı kazanan+ganyan İKİ ARDIŞIK senkronizasyonda (result-sync cron'u 5 dk'da
// bir çalışıyor) DEĞİŞMEDEN görülmeden Result'a yazılmıyor — bu, "yakala ve düzelt" değil
// "en baştan olmasın" prensibiyle eklendi (kullanıcı talebi: "bunlar olmasın, yakalanması
// değil olmayacak"). Bir koşu bu aşamada asla kalıp Result'a hiç geçmezse (TJK verisi
// sürekli değişiyorsa) admin panelinde ayrıca görünür olmalı — bkz. result-sync.ts.
model PendingResult {
  id          String   @id @default(cuid())
  raceId      String   @unique
  winnerNo    Int?
  winnerNos   Int[]    @default([])
  ganyan      Float?
  actualOrder Json
  firstSeenAt DateTime @default(now())

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
}

// ─── CONTENT ──────────────────────────────────────────────────────────────────

model Article {
  id              String      @id @default(cuid())
  type            ArticleType
  title           String
  slug            String      @unique
  excerpt         String?
  body            String
  coverImage      String?
  category        String?
  tags            String[]
  authorId        String
  published       Boolean     @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  // 2026-09-18 — başlangıç "sosyal kanıt" beğeni sayısı (5-13 arası, yayımlanınca elle
  // seed edilir) — gerçek kullanıcı beğenileri ayrı ArticleLike tablosunda, toplam
  // gösterilen sayı seedLikeCount + ArticleLike.count() (bkz. article-like.actions.ts).
  seedLikeCount   Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  author User          @relation(fields: [authorId], references: [id])
  likes  ArticleLike[]

  @@index([type, published])
}

// ─── ROTASTORE (2026-09-20 — yalnız katalog altyapısı: sepet/ödeme YOK, kullanıcı kararı) ──

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Float // TL
  image       String?
  category    String? // "Şapka" / "Anahtarlık" / "Tişört" vb. — serbest metin, sabit liste değil
  stock       Int      @default(0)
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model ArticleLike {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ─── HORSE FOLLOWS ────────────────────────────────────────────────────────────

model HorseFollow {
  id        String   @id @default(cuid())
  userId    String
  horseName String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, horseName])
  @@index([userId])
}

// ─── CLAUDE API BÜTÇE TAKİBİ ───────────────────────────────────────────────────
// Anthropic'in kendisi kalan kredi bakiyesini API üzerinden vermiyor (yalnızca
// Console'da gösteriliyor) — bu yüzden her çağrının token kullanımını burada
// kendimiz kaydedip, admin'in girdiği başlangıç bakiyeden düşerek TAHMİNİ bir
// kalan bakiye hesaplıyoruz. Gerçek Anthropic bakiyesiyle birebir aynı olacağının
// garantisi yoktur.

model ClaudeUsageLog {
  id                       String   @id @default(cuid())
  createdAt                DateTime @default(now())
  raceId                   String?
  phase                    String // "faz2" | "faz4"
  model                    String
  inputTokens              Int
  outputTokens             Int
  // Prompt cache (Faz2/Faz4 arasında paylaşılan bağlam) devreye girdikten sonra eklendi —
  // bunlar olmadan gerçek maliyet olduğundan DÜŞÜK görünüyordu, çünkü cache yazma/okuma
  // token'ları inputTokens'a hiç dahil değil (Anthropic bunları ayrı sayaçlarda döner).
  cacheCreationInputTokens Int      @default(0)
  cacheReadInputTokens     Int      @default(0)
  // cacheCreationInputTokens'ın 1 saatlik TTL'li kısmı (2x fiyat) — kalanı (toplam eksi bu)
  // 5 dakikalık TTL'li kısımdır (1.25x fiyat). Anthropic bu ikisini usage.cache_creation
  // altında ayrı ayrı döner (ephemeral_1h_input_tokens/ephemeral_5m_input_tokens) — doğru
  // maliyet hesaplamak için ayrı saklanır (v6.31, metodoloji bloğu artık 1sa cache'leniyor).
  cacheCreation1hInputTokens Int    @default(0)
  // Claude'un ham yanıt metni (extractText sonrası) — Vercel platform zaman aşımı
  // Claude başarıyla yanıtladıktan SONRA ama istemciye ulaşmadan ÖNCE fonksiyonu
  // kesebiliyor ("boşa ödeme"). Bu alan sayesinde hemen ardından gelen "tekrar dene"
  // Claude'u yeniden çağırıp ikinci kez ücretlendirmek yerine bu kaydı kullanabilir.
  resultText               String?  @db.Text
  // İsteğin gönderilmesinden yanıtın alınmasına kadar geçen süre (ms) — admin panelde
  // "hangi analiz kaç dakika sürdü" tablosu için (kullanıcı talebi). Eski kayıtlarda yok.
  durationMs               Int?

  @@index([createdAt])
  @@index([raceId, phase, createdAt])
}

model ClaudeBudget {
  id          String   @id @default(cuid())
  startingUsd Float
  resetAt     DateTime @default(now())
  note        String?
}

// v6.77 — kullanıcı kararı 2026-08-10: üçüncü parti bir siteden elle yapıştırılan eski
// SireStat/DamStat modelleri (aşağıdaki SireStatOwn/DamStatOwn'dan FARKLI — bunlar hiç
// kullanılmıyordu, analiz akışına zaten girmiyorlardı) admin sayfaları/formları/
// parser'larıyla birlikte koddan VE veritabanından tamamen kaldırıldı.

// rotaganyan'ın KENDİ Runner/Result verisinden hesaplanan aygır istatistiği. Yalnız
// irk×pist×mesafe kırılımı var (kendi örneklemimiz küçük, daha ince kırılım örneklemi
// anlamsızlaştırır). AEI/ikramiye hesaplanamıyor çünkü şemada hiçbir yerde ödül/purse verisi yok.
model SireStatOwn {
  id        String   @id @default(cuid())
  sireName  String
  irk       String
  pist      String // surfaceToPist() değeri
  mesafe    String // mesafeBucket() değeri
  start     Int
  birinci   Int
  ikinci    Int
  ucuncu    Int
  dorduncu  Int
  besinci   Int
  kYuzde    Float
  updatedAt DateTime @updatedAt

  @@unique([sireName, irk, pist, mesafe])
  @@index([sireName])
  @@index([irk, pist, mesafe])
}

// DamStatOwn — bkz. SireStatOwn yorumu, aynı mantık kısrak+kısrak babası için.
model DamStatOwn {
  id          String   @id @default(cuid())
  damName     String
  damSireName String
  irk         String
  pist        String
  mesafe      String
  start       Int
  birinci     Int
  ikinci      Int
  ucuncu      Int
  dorduncu    Int
  besinci     Int
  kYuzde      Float
  // 2026-07-24: kullanıcı isteği — "kazanan tay oranı" (kaç FARKLI yavrunun en az 1
  // galibiyeti var / toplam farklı yavru). start/birinci YARIŞ bazlı (aynı at birden
  // fazla start/galibiyet üretebilir) — bu ikisi ise AT (yavru) bazlı, distinct Runner.name
  // gruplamasıyla hesaplanır (yalnız kendi verimizde mümkün).
  yavruSayisi        Int @default(0)
  kazananYavruSayisi Int @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([damName, damSireName, irk, pist, mesafe])
  @@index([damName])
  @@index([irk, pist, mesafe])
}

// Damsire'nin (kısrağın babası) KENDİ BAŞINA etkisi — DamStatOwn'dan farklı olarak dam
// ADI hiç sayılmıyor, damSireName'e göre TÜM farklı kısraklardan gelen yavrular birlikte
// gruplanıyor (kullanıcı doktrini 2026-07-26: "damsire atın fiziksel/mizaç profili üzerinde
// önemli etki taşır, aygır+kısrak yanında üçüncü ayrı bir istatistik olarak izlenmeli").
// torunSayisi/kazananTorunSayisi = DamStatOwn'daki yavru kavramının bir kuşak ötesi hali.
model DamSireStatOwn {
  id            String   @id @default(cuid())
  damSireName   String
  irk           String
  pist          String
  mesafe        String
  start         Int
  birinci       Int
  ikinci        Int
  ucuncu        Int
  dorduncu      Int
  besinci       Int
  kYuzde        Float
  torunSayisi        Int @default(0)
  kazananTorunSayisi Int @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([damSireName, irk, pist, mesafe])
  @@index([damSireName])
}

// v6.78 — kullanıcı kararı 2026-08-10 ("site genelinde kullanılmayan veri" taraması):
// SireDosageStat (rafa kaldırılmış Dosage/DI-CD özelliği, hiç okunmuyordu),
// TrainerEquipmentStatOwn/JockeyPistMesafeSkkStatOwn/JokeyAntrenorKombinasyonStatOwn
// (üçü de gece cron'larıyla yazılıyordu ama hiçbir yerde okunmuyordu, v6.24/v6.26
// kararıyla analiz akışından zaten çıkarılmışlardı) tamamen kaldırıldı — modeller,
// onları besleyen cron rotaları/servisleri/action dosyaları koddan silindi.

// ─── METHODOLOGY ──────────────────────────────────────────────────────────────

model MethodologyVersion {
  id            String   @id @default(cuid())
  version       String   @unique
  effectiveDate DateTime
  content       String
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ─── ANASAYFA KUPON ───────────────────────────────────────────────────────────

// Admin'in manuel kurduğu çok ayaklı kombine kupon (Ekonomik/Normal/Geniş) — anasayfada gösterilir.
model HomeKupon {
  id             String   @id @default(cuid())
  hippodromeName String
  date           DateTime
  legs           Json // [{ raceNo: number, narrow: number[], normal: number[], wide: number[] }]
  slot           Int      @default(1) // 1 = 1. Altılı, 2 = 2. Altılı — her slot kendi başına aktif olabilir
  isActive       Boolean  @default(false)
  // TJK'nın resmi "6'lı Ganyan X TL vermiştir." cümlesi — yalnız gün sonu arşivlenirken
  // (archive-kupon cron) yakalanabilir, TJK'nın ilgili sayfası geçmişe dönük sorgu
  // desteklemiyor (her zaman "bugün"). Bu yüzden yalnız BUNDAN SONRAKİ arşivlenen
  // kayıtlarda dolu olur, geçmişe dönük doldurulamaz. null = yakalanamadı/henüz arşivlenmedi.
  ikramiye       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 2026-09-21 — Prediction-to-HomeKupon Auto Synchronization (bkz. plan). PoolKey =
  // (hippodromeName, date, slot). manualOverrides admin'in HAM/kalıcı checkbox niyeti
  // (asla budanmaz); sourcePredictionsHash + buildKey senkron/idempotency için.
  manualOverrides       Json?
  sourcePredictionsHash String?
  buildKey              String? @unique

  @@index([isActive])
  @@index([slot])
}

// Prisma DSL'de ifade edilemeyen bir kısmi (partial) unique index — `prisma db push`
// bunu OLUŞTURMAZ, bir kereye mahsus raw SQL ile eklenir (bkz. plan "Deploy checklist"):
//   CREATE UNIQUE INDEX IF NOT EXISTS homekupon_one_active_per_pool
//     ON "HomeKupon" ("hippodromeName", "date", "slot") WHERE "isActive" = true;
// Aynı (hippodromeName,date,slot) için en fazla 1 isActive=true satır garantisi burada.

// 2026-09-12 kullanıcı talebi — "Altılı Ne Verir?"'in AGF-tabanlı tahmini, gerçek TJK
// ikramiyesinden büyük sapma gösterebiliyor (24 örnekte medyan %61-76, ama varyans %30-116).
// Kullanıcı "Dağıtılacak Tutar"ı (havuz büyüklüğü) da girdi olarak kullanan daha iyi bir
// kalibrasyon istedi — TEK günün 2 gerçek örneğiyle denendi, havuz+katsayı+gerçek-ikramiye
// arasında STABİL bir ilişki bulunamadı (bkz. proje hafızası). Karar: geriye dönük TJK verisi
// çekilemediği için (yalnız "bugün" sorgulanabiliyor), BUNDAN SONRA sonuçlanan HER Altılı için
// bu üçlüyü kaydedip, yeterli örnek (20-30+) birikince GERÇEK bir regresyon kurulacak.
model AltiliIkramiyeLog {
  id             String   @id @default(cuid())
  hippodromeName String // TJK'nın sehirAdi'si (ör. "Ankara") — AltiliCityResult.sehirAdi ile aynı
  date           DateTime
  slot           Int // 1 veya 2 (1. Altılı / 2. Altılı)
  // Havuz kapanmadan ÖNCEKİ son bilinen "Dağıtılacak Tutar" — sonuçlandıktan sonra TJK'nın
  // kendi sayfası bu değeri artık göstermediği için, kapanmadan önce yakalanıp burada donar.
  havuzBuyuklugu Int?
  // Gerçek kazanan kombinasyonun AGF-bazlı katsayısı (Σ 100/effectiveAgf) — kendi Race/Runner
  // verimizden, sonuçlandıktan SONRA hesaplanır (leak yok, geçmişe dönük gerçek sonuç).
  katsayi        Float?
  // TJK'nın "X ₺ vermiştir" cümlesinden ayrıştırılan GERÇEK kombinasyon-başı ödeme.
  gercekIkramiye Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([hippodromeName, date, slot])
}

// ─── SITE SETTINGS ───────────────────────────────────────────────────────────

model SiteSetting {
  key       String   @id // örn. "banner_url"
  value     String
  updatedAt DateTime @updatedAt
}

// ─── BANNER SLIDES ───────────────────────────────────────────────────────────

model BannerSlide {
  id          String   @id @default(cuid())
  url         String
  storagePath String // Supabase'deki dosya yolu (silme için)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([active, order])
}

// ─── JOKEY STAT SYNC (TJK'dan çekilen) ───────────────────────────────────────

model JockeyStatSync {
  id               String    @id @default(cuid())
  jockey           String
  hippoSlug        String // "overall" veya hippodrome slug (ankara, istanbul, ...)
  year             Int
  breed            String? // "INGILIZ" | "ARAP" | null = hepsi
  surface          String? // "CIM" | "KUM" | "SENTETIK" | null = hepsi
  rides            Int
  wins             Int
  place2           Int
  place3           Int
  place4           Int
  place5           Int
  tableCount       Int
  winRate          Float
  tableRate        Float
  prizeTl          Int
  performanceScore Float?
  confidenceLabel  String?
  updatedAt        DateTime  @updatedAt

  @@unique([jockey, hippoSlug, year, breed, surface])
  @@index([hippoSlug, year, breed, surface])
  @@index([jockey, year])
}

// ─── DETAYLI DERECE İSTATİSTİKLERİ (TJK'dan çekilen, tüm ülke performans arşivi) ─────
// 2026-08-23 kullanıcı talebi: https://www.tjk.org/TR/YarisSever/Query/Page/DetayliDereceIst
// — TJK'nın TÜM ülke çapındaki koşu performanslarını (at/tarih/hipodrom/pist/PIST DURUMU/
// mesafe/derece/koşu cinsi) veren arşivi. Amaç: "zemin ağırlığı" (yağmurlu/ıslak pist)
// sinyalini test edebilmek için popülasyon-bazlı referans — kendi RaceDay.surfaceConditions
// verimiz çok seyrek (83 gün, yalnız 3 kayıt Normal-dışı) ama bu arşiv TEK YILDA (2026)
// binlerce Normal-dışı kayıt içeriyor (Nemli/Sulu/Islak/Yumuşak/Ağır çeşitleri, n~1128).
// tjkKayitId, TJK'nın sonuç sayfası linkindeki "#224900" gibi fragment kimliği — bu ID
// AT-BAZLI DEĞİL, KOŞU-BAZLI çıktı (aynı koşudaki farklı atlar aynı ID'yi paylaşıyor,
// 2026-08-23'te ilk yüklemede 7069 işlenen kayıt yalnız 3694 satıra düşünce fark edildi).
// Bu yüzden benzersiz anahtar (tjkKayitId, atAdi) ikilisi — aynı koşuda aynı isimde iki at
// olamayacağı için bu kombinasyon gerçekten benzersiz.
model TjkDereceKaydi {
  id          String   @id @default(cuid())
  tjkKayitId  String
  atAdi       String
  tarih       DateTime?
  kilo        String?
  irk         String
  cinsiyet    String
  yil         Int
  hipodrom    String
  pist        String
  pistDurumu  String
  mesafe      String
  derece      String?
  cinsAdi     String
  updatedAt   DateTime @updatedAt

  @@unique([tjkKayitId, atAdi])
  @@index([yil])
  @@index([pistDurumu])
  @@index([atAdi])
  @@index([tarih])
}

// ─── ANTRENÖR STAT SYNC (TJK'dan çekilen) ────────────────────────────────────

model TrainerStatSync {
  id        String   @id @default(cuid())
  trainer   String
  year      Int
  rides     Int
  wins      Int
  winRate   Float
  updatedAt DateTime @updatedAt

  @@unique([trainer, year])
  @@index([trainer, year])
}

// ─── PAGE VIEWS ───────────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  userId    String?
  path      String
  duration  Int?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([path])
  @@index([createdAt(sort: Desc)])
}

// ─── DEPLOY LOG ─────────────────────────────────────────────────────────────

// 2026-09-27 kullanıcı talebi ("backup yapısı kurmanı istiyorum... nerede olduğumuzu son
// güncellemenin ne olduğu kayıtlara alınsın") — tam-site-geri-alma vakasında "21.09'da
// tam olarak hangi commit canlıydı" sorusunu yanıtlamak için SAATLER harcandı (commit
// tarihlerini/dosya diff'lerini elle karşılaştırarak). Bu tablo HER production deploy'unda
// TEK bir satırla şunu kalıcı hale getirir: hangi commit, ne zaman, neden. Git log zaten
// "ne değişti"yi tutuyor — bu tablo "hangi commit NE ZAMAN CANLIYDI" sorusunu git
// arkeolojisi olmadan anında cevaplar. arac-deploy-kaydet.mts (yaz) / arac-deploy-tarihce.mts
// (oku) ile kullanılır — HER deploy'un SON adımı bu kayıt olmalı (CLAUDE.md'ye eklendi).
model DeployLog {
  id           String   @id @default(cuid())
  deployedAt   DateTime @default(now())
  gitSha       String // tam sha
  gitMessage   String // commit mesajının ilk satırı
  deploymentId String // Vercel dpl_... id
  tur          String // "feature" | "fix" | "revert" | "config"
  ozet         String // insan-okunur: ne değişti, neden (gelecekteki oturum için bağlam)

  @@index([deployedAt(sort: Desc)])
}

// ═══════════════════════════════════════════════════════════════════════════════
// YURT DIŞI VERİ BANKASI (Analiz Motoru YD V1.0'ın temeli) — 2026-09-30
// ═══════════════════════════════════════════════════════════════════════════════
// Kullanıcı kararı: "tr yarışları ile ilgili hiçbir şeyi bozmadan apayrı olarak
// yabancı yarışlar için altyapı kurulacak, birbirleri ile hiçbir bağlantısı
// olmayacak" + "hepsi tek seferde oluşturulacak". Bu bölümdeki HİÇBİR model
// yukarıdaki TR modellerinden (Hippodrome/Race/Runner/Prediction/Pick/...) birini
// import/relation ETMEZ — tamamen kendi kapalı grafı. HAM VERİ → KANONİK YARIŞ
// VERİSİ → İSTATİSTİK/PEDİGRİ BANKASI üç katmanlı mimari (kullanıcının kendi
// tasarım notu). NOT: bu bölüm ŞEMA/İSKELETTİR — her tabloyu dolduran ETL/senkron
// kodu AYRI, sonraki bir iş (bkz. proje hafızası) — tek seferde kurulan burada
// yalnız veri YAPISIdır, sabit ağırlıklı bir puanlama motoru DEĞİLDİR (kullanıcının
// kendi notu: "ilk günden keyfi puan vermeyeceğim, veri biriktikçe kalibre edilir").

// ─── RAW ─────────────────────────────────────────────────────────────────────

model YurtDisiSourceSnapshot {
  id           String   @id @default(cuid())
  source       String // "TJK" | "PEDIGREEQUERY" | vb.
  sourceKey    String // kaynağın kendi kimliği (at adı/atId/raceId vb.)
  fetchedAt    DateTime @default(now())
  payload      Json
  payloadHash  String
  parseVersion String
  createdAt    DateTime @default(now())

  @@index([source, sourceKey])
}

// ─── MASTER ──────────────────────────────────────────────────────────────────

model YurtDisiEquine {
  id             String    @id @default(cuid())
  canonicalName  String
  normalizedName String    @unique
  countryOfBirth String?
  birthDate      DateTime?
  birthYear      Int?
  sex            String?
  breed          String?
  sireId         String?
  damId          String?
  breederId      String?
  ownerId        String?
  sourceIds      Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sire          YurtDisiEquine?  @relation("YdSireOf", fields: [sireId], references: [id])
  dam           YurtDisiEquine?  @relation("YdDamOf", fields: [damId], references: [id])
  sireOffspring YurtDisiEquine[] @relation("YdSireOf")
  damOffspring  YurtDisiEquine[] @relation("YdDamOf")
  breeder       YurtDisiBreeder? @relation(fields: [breederId], references: [id])
  owner         YurtDisiOwner?   @relation(fields: [ownerId], references: [id])

  pedigreeEdgesAsChild YurtDisiPedigreeEdge[]
  runs                 YurtDisiHorseRun[]
  workouts             YurtDisiWorkout[]
  dosageSnapshots      YurtDisiDosageSnapshot[]
  linebreedingSnapshots YurtDisiLinebreedingSnapshot[]
  horseStats           YurtDisiHorseStatSnapshot[]
  runnerEntries        YurtDisiRunner[]

  @@index([canonicalName])
}

model YurtDisiJockey {
  id             String   @id @default(cuid())
  canonicalName  String
  normalizedName String   @unique
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  runnerEntries YurtDisiRunner[]
  statSnapshots YurtDisiJockeyStatSnapshot[]
  jtStats       YurtDisiJockeyTrainerStatSnapshot[]
}

model YurtDisiTrainer {
  id             String   @id @default(cuid())
  canonicalName  String
  normalizedName String   @unique
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  runnerEntries YurtDisiRunner[]
  statSnapshots YurtDisiTrainerStatSnapshot[]
  jtStats       YurtDisiJockeyTrainerStatSnapshot[]
}

model YurtDisiOwner {
  id             String   @id @default(cuid())
  canonicalName  String
  normalizedName String   @unique
  createdAt      DateTime @default(now())

  horses        YurtDisiEquine[]
  runnerEntries YurtDisiRunner[]
}

model YurtDisiBreeder {
  id             String   @id @default(cuid())
  canonicalName  String
  normalizedName String   @unique
  createdAt      DateTime @default(now())

  horses YurtDisiEquine[]
}

model YurtDisiTrack {
  id             String   @id @default(cuid())
  canonicalName  String
  normalizedName String   @unique
  country        String
  surfaceTypes   Json?
  timezone       String?
  createdAt      DateTime @default(now())

  races      YurtDisiRace[]
  trackStats YurtDisiTrackStatSnapshot[]
  drawStats  YurtDisiDrawStatSnapshot[]
}

// entityType: "HORSE"|"JOCKEY"|"TRAINER"|"OWNER"|"BREEDER"|"TRACK" — kasıtlı olarak
// Prisma ilişkisi DEĞİL (polimorfik), uygulama katmanında doğrulanır. "William Buick"/
// "W Buick"/"W. Buick" gibi aynı kişinin farklı kaynak yazımlarını TEK entityId'ye bağlar.
model YurtDisiEntityAlias {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  source         String
  sourceId       String?
  sourceName     String
  normalizedName String
  createdAt      DateTime @default(now())

  @@unique([source, sourceName, entityType])
  @@index([entityType, entityId])
}

// 2026-09-30 kullanıcı kararı (Entity Resolution V1.1) — "atlanmasın; UNRESOLVED olarak
// karantinaya alınsın... hiçbir kaydı sessizce kaybetmeyelim." Güvenilir kimlik kurulamayan
// (ör. kaynak ID'si olmayan runner) veya çakışma şüphesi olan (aynı isim ama ülke/doğum
// yılı uyuşmuyor) her durum burada GÖRÜNÜR kalır — otomatik/riskli bir birleştirme YAPILMAZ.
model YurtDisiUnresolvedEntity {
  id                 String   @id @default(cuid())
  entityType         String // "HORSE"|"JOCKEY"|"TRAINER"|"OWNER"|"TRACK"|"RUNNER"
  source             String
  sourceName         String
  normalizedName     String
  context            Json?
  candidateEntityIds Json?
  confidence         Float?
  status             String   @default("UNRESOLVED") // UNRESOLVED | REVIEWED | RESOLVED
  resolvedEntityId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([entityType, status])
  @@index([source, sourceName])
}

// ─── RACING ──────────────────────────────────────────────────────────────────

model YurtDisiRace {
  id                 String   @id @default(cuid())
  trackId            String
  raceDate           DateTime
  raceNo             Int?
  distance           Int?
  surface            String?
  going              String?
  classRaw           String?
  classNormalized    String?
  raceType           String?
  // 2026-09-30 kullanıcı notu — "Bugün ham purse kaybolursa ileride sınıf bankasını doğru
  // kuramayız": pozisyon bazlı ikramiye kırılımı (1.-4. sıra) ham olarak saklanır, tek bir
  // toplam alana indirgenmez — TR'deki Race.ikramiyeDetay ile AYNI fikir, ayrı alan.
  purse1             Float?
  purse2             Float?
  purse3             Float?
  purse4             Float?
  purseTotal         Float?
  currency           String?
  purseUsdEquivalent Float?
  pursePercentile    Float?
  raceValueIndex     Float?
  raceValueTier      String?
  sourceRaceKey      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  track     YurtDisiTrack           @relation(fields: [trackId], references: [id])
  runners   YurtDisiRunner[]
  classStat YurtDisiRaceClassStat?
  result    YurtDisiResult?

  @@unique([trackId, raceDate, raceNo])
}

model YurtDisiRunner {
  id               String   @id @default(cuid())
  raceId           String
  horseId          String
  draw             Int?
  weight           Float?
  jockeyId         String?
  trainerId        String?
  ownerId          String?
  rating           Float?
  odds             Float?
  finishPosition   Int?
  finishPercentile Float?
  status           String?
  createdAt        DateTime @default(now())

  race    YurtDisiRace     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  horse   YurtDisiEquine   @relation(fields: [horseId], references: [id])
  jockey  YurtDisiJockey?  @relation(fields: [jockeyId], references: [id])
  trainer YurtDisiTrainer? @relation(fields: [trainerId], references: [id])
  owner   YurtDisiOwner?   @relation(fields: [ownerId], references: [id])
  result  YurtDisiResult?
  marketSnapshots YurtDisiMarketSnapshot[]
  dataQuality     YurtDisiRunnerDataQuality?

  @@unique([raceId, horseId])
}

model YurtDisiResult {
  id             String   @id @default(cuid())
  raceId         String   @unique
  runnerId       String   @unique
  finishPosition Int?
  beatenDistance Float?
  time           String?
  status         String?
  createdAt      DateTime @default(now())

  race   YurtDisiRace   @relation(fields: [raceId], references: [id], onDelete: Cascade)
  runner YurtDisiRunner @relation(fields: [runnerId], references: [id], onDelete: Cascade)
}

// Atın TÜM ham geçmişi (kaynak ne olursa olsun) — YurtDisiRunner'dan BAĞIMSIZ, çünkü
// bir atın geçmiş yarışları bizim henüz "kanonik" YurtDisiRace'e işlemediğimiz
// hipodromlarda/tarihlerde de olabilir (kullanıcının notu: "at geçmiş yarışları" #1 öncelik).
model YurtDisiHorseRun {
  id               String   @id @default(cuid())
  horseId          String
  raceDate         DateTime
  trackId          String?
  trackNameRaw     String?
  distance         Int?
  surface          String?
  going            String?
  classRaw         String?
  draw             Int?
  weight           Float?
  jockeyName       String?
  trainerName      String?
  finishPosition   Int?
  fieldSize        Int?
  finishPercentile Float?
  beatenDistance   Float?
  raceTime         String?
  rating           Float?
  odds             Float?
  purseTotal       Float?
  currency         String?
  // 2026-09-30 kullanıcı kararı — ETL idempotent olmalı: aynı satır tekrar çekilince
  // yinelenmesin. TJK'nın kendi geçmiş sayfası satır başına stabil bir kimlik vermiyor,
  // bu yüzden tarih+şehir+koşu-no/adı birleşimi kaynak-kimliği olarak kullanılıyor.
  sourceKey        String?
  source           String
  createdAt        DateTime @default(now())

  horse YurtDisiEquine @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@unique([horseId, sourceKey])
  @@index([horseId, raceDate])
}

model YurtDisiWorkout {
  id            String   @id @default(cuid())
  horseId       String
  workoutDate   DateTime
  trackId       String?
  distance      Int?
  surface       String?
  time          String?
  rank          Int?
  totalWorkers  Int?
  workoutType   String?
  comment       String?
  source        String
  dataAvailable Boolean  @default(true)
  createdAt     DateTime @default(now())

  horse YurtDisiEquine @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([horseId, workoutDate])
}

model YurtDisiMarketSnapshot {
  id          String   @id @default(cuid())
  runnerId    String
  capturedAt  DateTime @default(now())
  odds        Float?
  marketRank  Int?
  marketShare Float?
  source      String

  runner YurtDisiRunner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@index([runnerId, capturedAt])
}

// ─── PEDIGREE ────────────────────────────────────────────────────────────────

model YurtDisiPedigreeEdge {
  id           String   @id @default(cuid())
  childId      String
  parentId     String
  relationType String // "SIRE" | "DAM"
  createdAt    DateTime @default(now())

  child YurtDisiEquine @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, relationType])
  @@index([parentId])
}

model YurtDisiChefDeRace {
  id            String    @id @default(cuid())
  equineId      String
  system        String // "ROMAN_MILLER" | "ANZ"
  category1     String // B|I|C|S|P
  category2     String?
  validFrom     DateTime?
  validTo       DateTime?
  source        String
  sourceVersion String
  createdAt     DateTime  @default(now())

  @@unique([equineId, system, sourceVersion])
}

// sourceDp/Di/Cd = PedigreeQuery'nin kendi gösterdiği (varsa) değer; calculatedDp/Di/Cd =
// bizim Chef-de-Race listemiz+Roman formülüyle KENDİ hesabımız — kaynak değişirse/
// uyuşmazsa matchesSource=false ile fark edilir, asla sessizce üzerine yazılmaz.
model YurtDisiDosageSnapshot {
  id                     String   @id @default(cuid())
  horseId                String
  asOfDate               DateTime
  system                 String
  chefListVersion        String
  dpBrilliant            Float
  dpIntermediate         Float
  dpClassic              Float
  dpSolid                Float
  dpProfessional         Float
  dosagePointsTotal      Float
  dosageIndex            Float
  centerOfDistribution   Float
  sourceDp               String?
  sourceDi               Float?
  sourceCd               Float?
  calculatedDp           String
  calculatedDi           Float
  calculatedCd           Float
  matchesSource          Boolean?
  pedigreeDepthAvailable Int
  chefCount              Int
  calculatorVersion      String
  source                 String
  createdAt              DateTime @default(now())

  horse      YurtDisiEquine             @relation(fields: [horseId], references: [id], onDelete: Cascade)
  components YurtDisiDosageComponent[]

  @@unique([horseId, calculatorVersion, chefListVersion])
}

model YurtDisiDosageComponent {
  id                 String @id @default(cuid())
  dosageSnapshotId   String
  ancestorId         String
  generation         Int
  pedigreePath       String
  chefCategory1      String
  chefCategory2      String?
  basePoints         Float
  brilliantPoints    Float
  intermediatePoints Float
  classicPoints      Float
  solidPoints        Float
  professionalPoints Float

  dosageSnapshot YurtDisiDosageSnapshot @relation(fields: [dosageSnapshotId], references: [id], onDelete: Cascade)

  @@index([dosageSnapshotId])
}

model YurtDisiLinebreedingSnapshot {
  id           String   @id @default(cuid())
  horseId      String
  asOfDate     DateTime
  ancestorId   String
  occurrences  Int
  paths        Json
  nearestCross String?
  source       String
  createdAt    DateTime @default(now())

  horse YurtDisiEquine @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([horseId])
}

model YurtDisiPedigreeStatSnapshot {
  id                  String   @id @default(cuid())
  ancestorId          String
  ancestorRole        String // SIRE|DAM|DAMSIRE|GRANDSIRE
  asOfDate            DateTime
  country             String?
  surface             String?
  goingBucket         String?
  distanceBucket      String?
  classBucket         String?
  ageBucket           String?
  uniqueProgeny       Int
  starts              Int
  wins                Int
  top3                Int
  winRate             Float
  top3Rate            Float
  avgFinishPercentile Float?
  sampleSize          Int
  shrunkWinRate       Float
  shrunkTop3Rate      Float
  createdAt           DateTime @default(now())

  @@index([ancestorId, ancestorRole, surface, distanceBucket])
}

model YurtDisiPedigreeCrossStat {
  id             String   @id @default(cuid())
  sireId         String
  damSireId      String
  country        String?
  surface        String?
  distanceBucket String?
  goingBucket    String?
  asOfDate       DateTime
  uniqueHorses   Int
  starts         Int
  wins           Int
  top3           Int
  winRate        Float
  top3Rate       Float
  sampleSize     Int
  createdAt      DateTime @default(now())

  @@index([sireId, damSireId])
}

// ─── STATISTICS (hepsi point-in-time: asOfDate'ten SONRAKİ hiçbir sonuç bu satırı etkilemez) ──

model YurtDisiHorseStatSnapshot {
  id                  String   @id @default(cuid())
  horseId             String
  asOfDate            DateTime
  starts              Int
  wins                Int
  top3                Int
  last30Starts        Int
  last90Starts        Int
  trackStarts         Int
  trackWins           Int
  surfaceStarts       Int
  surfaceWins         Int
  distanceStarts      Int
  distanceWins        Int
  goingStarts         Int
  goingWins           Int
  classStarts         Int
  classWins           Int
  avgFinishPercentile Float?
  daysSinceLastRun    Int?
  sampleSize          Int
  createdAt           DateTime @default(now())

  horse YurtDisiEquine @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([horseId, asOfDate])
}

model YurtDisiJockeyStatSnapshot {
  id                  String   @id @default(cuid())
  jockeyId            String
  asOfDate            DateTime
  country             String?
  trackId             String?
  surface             String?
  goingBucket         String?
  distanceBucket      String?
  classBucket         String?
  raceType            String?
  windowDays          Int
  starts              Int
  wins                Int
  top2                Int
  top3                Int
  winRate             Float
  top2Rate            Float
  top3Rate            Float
  avgFinishPosition   Float?
  avgFinishPercentile Float?
  sampleSize          Int
  createdAt           DateTime @default(now())

  jockey YurtDisiJockey @relation(fields: [jockeyId], references: [id], onDelete: Cascade)

  @@index([jockeyId, asOfDate])
}

model YurtDisiTrainerStatSnapshot {
  id                  String   @id @default(cuid())
  trainerId           String
  asOfDate            DateTime
  country             String?
  trackId             String?
  surface             String?
  goingBucket         String?
  distanceBucket      String?
  classBucket         String?
  windowDays          Int
  starts              Int
  wins                Int
  top3                Int
  winRate             Float
  top3Rate            Float
  avgFinishPercentile Float?
  sampleSize          Int
  createdAt           DateTime @default(now())

  trainer YurtDisiTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, asOfDate])
}

model YurtDisiJockeyTrainerStatSnapshot {
  id             String   @id @default(cuid())
  jockeyId       String
  trainerId      String
  asOfDate       DateTime
  country        String?
  trackId        String?
  surface        String?
  distanceBucket String?
  starts         Int
  wins           Int
  top3           Int
  winRate        Float
  top3Rate       Float
  sampleSize     Int
  createdAt      DateTime @default(now())

  jockey  YurtDisiJockey  @relation(fields: [jockeyId], references: [id], onDelete: Cascade)
  trainer YurtDisiTrainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([jockeyId, trainerId, asOfDate])
}

model YurtDisiTrackStatSnapshot {
  id                 String   @id @default(cuid())
  trackId            String
  country            String?
  surface            String?
  distanceBucket     String?
  going              String?
  asOfDate           DateTime
  raceCount          Int
  avgWinningTime     Float?
  avgFieldSize       Float?
  insideDrawWinRate  Float?
  middleDrawWinRate  Float?
  outsideDrawWinRate Float?
  frontRunnerWinRate Float?
  closerWinRate      Float?
  createdAt          DateTime @default(now())

  track YurtDisiTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, asOfDate])
}

model YurtDisiDrawStatSnapshot {
  id             String   @id @default(cuid())
  trackId        String
  distanceBucket String?
  surface        String?
  goingBucket    String?
  drawBucket     String
  starts         Int
  wins           Int
  top3           Int
  winRate        Float
  top3Rate       Float
  asOfDate       DateTime
  createdAt      DateTime @default(now())

  track YurtDisiTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, asOfDate])
}

// raceValueIndex = Percentile(Purse | Country, RaceType, Age/Breed, Season) — kullanıcının
// formülü. ClassMove (sınıf düşüşü/yükselişi) bu index'in geçmiş yarışlarla farkından
// hesaplanır (ayrı bir servis, bu tablo yalnız veriyi tutar).
model YurtDisiRaceClassStat {
  id                 String   @id @default(cuid())
  raceId             String   @unique
  country            String?
  year               Int?
  raceTypeRaw        String?
  raceTypeNormalized String?
  purseTotal         Float?
  currency           String?
  purseUsdEquivalent Float?
  pursePercentile    Float?
  raceValueIndex     Float?
  raceValueTier      String?
  fieldMedianValue   Float?
  createdAt          DateTime @default(now())

  race YurtDisiRace @relation(fields: [raceId], references: [id], onDelete: Cascade)
}

// ─── QUALITY ─────────────────────────────────────────────────────────────────

// "Bilgi yok" ile "gerçek değer 0" birbirine karışmasın diye — kullanıcının notu.
model YurtDisiRunnerDataQuality {
  id                String   @id @default(cuid())
  runnerId          String   @unique
  hasHistory        Boolean  @default(false)
  hasPedigree       Boolean  @default(false)
  hasJockey         Boolean  @default(false)
  hasTrainer        Boolean  @default(false)
  hasJockeyStats    Boolean  @default(false)
  hasTrainerStats   Boolean  @default(false)
  hasMarket         Boolean  @default(false)
  hasRating         Boolean  @default(false)
  hasDraw           Boolean  @default(false)
  hasWorkout        Boolean  @default(false)
  historyRaceCount  Int      @default(0)
  completenessScore Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  runner YurtDisiRunner @relation(fields: [runnerId], references: [id], onDelete: Cascade)
}
