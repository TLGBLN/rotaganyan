// terfisi yÃƒÂ¼zÃƒÂ¼nden ilk-6'nÃ„Â±n dÃ„Â±Ã…Å¸Ã„Â±na, 7.sÃ„Â±raya itildi Ã¢â‚¬â€ GERÃƒâ€¡EK kupon kaybÃ„Â±, hitTop1=false):
// dÃƒÂ¶rt terfi/garanti mekanizmasÃ„Â±nÃ„Â±n (agfTrendTerfisi ilk3/ilk6, safModelDegerTerfisi
// ilk3/ilk6) hiÃƒÂ§birinde "bu terfi kimin yerini alÃ„Â±yor, o at ne kadar gÃƒÂ¼ÃƒÂ§lÃƒÂ¼ydÃƒÂ¼" diye bir
// kontrol yoktu Ã¢â‚¬â€ trend/deÃ„Å¸er sinyali ne kadar bÃƒÂ¼yÃƒÂ¼k olsa da, adayÃ„Â±n ham olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â± yerini
// alacaÃ„Å¸Ã„Â± atÃ„Â±n ÃƒÂ§ok altÃ„Â±nda olsa bile (somut vaka: %4 vs %7, oran 0.57) terfi gerÃƒÂ§ekleÃ…Å¸iyordu.
// KullanÃ„Â±cÃ„Â±nÃ„Â±n kendi ifadesiyle: "%4'lÃƒÂ¼k atÃ„Â± %10'un ÃƒÂ¶nÃƒÂ¼ne koyuyorsan bu bir problemdir".
// Denenen Ã„Â°LK ÃƒÂ§ÃƒÂ¶zÃƒÂ¼m (adayÃ„Â±n ham olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â±nÃ„Â±n saha ortalamasÃ„Â±nÃ„Â±n altÃ„Â±nda olmasÃ„Â±nÃ„Â± engelleme)
// arac-terfi-denetimi.mts ile test edilince Ãƒâ€¡OK KATI ÃƒÂ§Ã„Â±ktÃ„Â± Ã¢â‚¬â€ aynÃ„Â± 20 gerÃƒÂ§ek koÃ…Å¸uda terfi
// sayÃ„Â±sÃ„Â±nÃ„Â± 28'den 3'e dÃƒÂ¼Ã…Å¸ÃƒÂ¼rdÃƒÂ¼, ÃƒÂ§ÃƒÂ¼nkÃƒÂ¼ kÃƒÂ¼ÃƒÂ§ÃƒÂ¼k/orta sahalarda favori dÃ„Â±Ã…Å¸Ã„Â± HER at zaten
// ortalamanÃ„Â±n altÃ„Â±nda kalÃ„Â±yor (daÃ„Å¸Ã„Â±lÃ„Â±m saÃ„Å¸a ÃƒÂ§arpÃ„Â±k). Bunun yerine adayÃ„Â±n olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â± doÃ„Å¸rudan
// YERÃ„Â°NÃ„Â° ALACAÃ„ÂI ATIN olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â±yla KIYASLANIYOR Ã¢â‚¬â€ mekanizmanÃ„Â±n kendi ilkesiyle (trend/deÃ„Å¸er
// bulma) tutarlÃ„Â± kalÃ„Â±p yalnÃ„Â±z "bariz derecede daha zayÃ„Â±f birini terfi ettirme" durumunu
// engelliyor. DISPLACED_ORAN_ESIGI=0.7 ile aynÃ„Â± 20 koÃ…Å¸uda doÃ„Å¸rulandÃ„Â± (bkz. commit notu).
const DISPLACED_ORAN_ESIGI = 0.7;

function terfiPenceresiV5<T extends { no: number; olasilik: number; ekuriGroup: number | null }>(
  sirali: T[],
  pencereBoyu: number,
  adayMi: (r: T, index: number) => boolean
): { sonuc: T[]; terfiEdenNolar: Set<number> } {
  const efektifSinir = efektifPencereSiniri(sirali, pencereBoyu);
  const disaridakiAdaylar = sirali
    .map((r, i) => ({ r, i }))
    .filter(({ r, i }) => i >= efektifSinir && adayMi(r, i));
  if (disaridakiAdaylar.length === 0) return { sonuc: sirali, terfiEdenNolar: new Set() };

  const enGuclusu = disaridakiAdaylar.reduce((a, b) => (b.r.olasilik > a.r.olasilik ? b : a));

  const yeriAlinacakAt = sirali[efektifSinir - 1];
  if (yeriAlinacakAt && enGuclusu.r.olasilik < yeriAlinacakAt.olasilik * DISPLACED_ORAN_ESIGI) {
    return { sonuc: sirali, terfiEdenNolar: new Set() };
  }

  const kopya = [...sirali];
  const [aday] = kopya.splice(enGuclusu.i, 1);
  kopya.splice(efektifSinir - 1, 0, aday);
  return { sonuc: kopya, terfiEdenNolar: new Set([aday.no]) };
}

/** V4'ÃƒÂ¼n kanÃ„Â±tlanmÃ„Â±Ã…Å¸ AGF-trend terfi kuralÃ„Â±nÃ„Â±n V5'e uyarlanmÃ„Â±Ã…Å¸ hÃƒÂ¢li Ã¢â‚¬â€ kullanÃ„Â±cÃ„Â± kararÃ„Â±
 *  2026-08-16: bÃƒÂ¼yÃƒÂ¼k AGF trendi taÃ…Å¸Ã„Â±yan atlar, YETERÃ„Â°NCE baÃ…Å¸ka sinyal de taÃ…Å¸Ã„Â±yorsa
 *  (bkz. AGF_TERFI_ILK3_SINYAL_ESIGI=4, V4'ÃƒÂ¼n backtest'i: n=663, %21.6/%53.8, kontrol
 *  %10.2/%30.7) modelin ham olasÃ„Â±lÃ„Â±k sÃ„Â±ralamasÃ„Â±nda geride kalsa bile ilk-3'e/ilk-6'ya
 *  taÃ…Å¸Ã„Â±nÃ„Â±r. Regresyon skorunu/olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â± DEÃ„ÂÃ„Â°Ã…ÂTÃ„Â°RMEZ Ã¢â‚¬â€ yalnÃ„Â±z GÃƒâ€“STERÃ„Â°M sÃ„Â±rasÃ„Â±nÃ„Â± ve kararÃ„Â±
 *  etkiler. Sinyal sayÃ„Â±sÃ„Â± YETERSÃ„Â°ZSE (KURUÃ…ÂHAN ÃƒÂ¶rneÃ„Å¸i: trend var ama yalnÃ„Â±z 2 sinyal) VE
 *  dÃƒÂ¼Ã…Å¸ÃƒÂ¼Ã…Å¸-iyi-pozisyon ÃƒÂ¶rÃƒÂ¼ntÃƒÂ¼sÃƒÂ¼ de yoksa terfi olmaz Ã¢â‚¬â€ bu KASITLI, trend TEK BAÃ…ÂINA V4'ÃƒÂ¼n
 *  kendi backtest'inde de ilk-3 iÃƒÂ§in yeterli deÃ„Å¸ildi. */
function agfTrendTerfisiUygula<
  T extends {
    no: number; agfTrendYonu: "yÃƒÂ¼kseliÃ…Å¸" | "dÃƒÂ¼Ã…Å¸ÃƒÂ¼Ã…Å¸" | null; sinyalSayisi: number;
    agfFark: number; agfSirasi: number; olasilik: number; ekuriGroup: number | null;
  }
>(sirali: T[]): (T & { agfTerfi: "ilk3" | "ilk6" | null })[] {
  const isaretli = sirali.map((r) => ({ ...r, agfTerfi: null as "ilk3" | "ilk6" | null }));

  // 2026-08-16 kullanÃ„Â±cÃ„Â± bulgusu (KINDBERO/ANGEL ON THE RIGHT, Ã„Â°zmir K3/K4): "dÃƒÂ¼Ã…Å¸ÃƒÂ¼Ã…Å¸ ama
  // hÃƒÂ¢lÃƒÂ¢ iyi AGF pozisyonu" (agfFark<=-1.0 VE agfSirasi<=4) TEK BAÃ…ÂINA (V4'ÃƒÂ¼n 4-sinyal
  // Ã…Å¸artÃ„Â± olmadan) ilk-3 iÃƒÂ§in yeterince gÃƒÂ¼ÃƒÂ§lÃƒÂ¼ Ã¢â‚¬â€ backtest: n=930, %19.9 galibiyet/%55.1
  // top3, kontrol grubu %9.3/%28.4 (V4'ÃƒÂ¼n kendi trend+4sinyal kuralÃ„Â±yla aynÃ„Â± seviyede).
  // NOT Ã¢â‚¬â€ 2026-08-19: bu, SKOR ÃƒÂ¶zelliÃ„Å¸i "agfDususVarMi"dan (toFeatureVector) FARKLI Ã¢â‚¬â€
  // o pozisyon Ã…Å¸artÃ„Â±nÃ„Â± kaldÃ„Â±rdÃ„Â±, ama bu GÃƒâ€“STERÃ„Â°M TERFÃ„Â°SÃ„Â° penceresi kendi ayrÃ„Â± backtest'i
  // (yukarÃ„Â±daki) yalnÃ„Â±z ilk-4 iÃƒÂ§in doÃ„Å¸rulandÃ„Â±Ã„Å¸Ã„Â±ndan bilerek pozisyon Ã…Å¸artlÃ„Â± BIRAKILDI.
  const dususAmaIyiPozisyonMu = (r: T) => r.agfFark <= -ANLAMLI_PUAN_ESIGI && r.agfSirasi <= 4;

  const { sonuc: ilk3Sonrasi, terfiEdenNolar: ilk3Terfi } = terfiPenceresiV5(
    isaretli,
    3,
    (r) => (r.agfTrendYonu != null && r.sinyalSayisi >= SINYAL_ESIGI) || dususAmaIyiPozisyonMu(r)
  );
  const ilk3Isaretli = ilk3Sonrasi.map((r) => (ilk3Terfi.has(r.no) ? { ...r, agfTerfi: "ilk3" as const } : r));

  const { sonuc: ilk6Sonrasi, terfiEdenNolar: ilk6Terfi } = terfiPenceresiV5(
    ilk3Isaretli,
    6,
    (r) => r.agfTrendYonu != null
  );
  return ilk6Sonrasi.map((r) => (ilk6Terfi.has(r.no) ? { ...r, agfTerfi: "ilk6" as const } : r));
}

// 2026-08-27 kullanÃ„Â±cÃ„Â± kararÃ„Â± ("V5.14'e dÃƒÂ¶n" Ã¢â‚¬â€ o dÃƒÂ¶nem canlÃ„Â± en yÃƒÂ¼ksek baÃ…Å¸arÃ„Â± oranÃ„Â±nÃ„Â±
// (n=32, top1 %46.9/top3 %81.3) gÃƒÂ¶steren versiyondu, AGF Trend Terfisi + bu kural birlikte
// aktifti): V5.20'de kaldÃ„Â±rÃ„Â±lmÃ„Â±Ã…Å¸tÃ„Â±, GÃƒÅ“NCEL (daha bÃƒÂ¼yÃƒÂ¼k, bug-dÃƒÂ¼zeltilmiÃ…Å¸) veriyle B=500
// bootstrap-CI ile yeniden doÃ„Å¸rulanÃ„Â±p geri getirildi Ã¢â‚¬â€ bkz. ENGINE_VERSIONS V5.22 notu.
// 2026-08-24 kullanÃ„Â±cÃ„Â± bulgusu (Bursa K10, KaÃ…Å¸mir Tay vakasÃ„Â±): AGF sÃ„Â±rasÃ„Â±=1 (favori) bir
// at, modelin ham olasÃ„Â±lÃ„Â±k sÃ„Â±ralamasÃ„Â±nda 4.sÃ„Â±raya dÃƒÂ¼Ã…Å¸mÃƒÂ¼Ã…Å¸tÃƒÂ¼ Ã¢â‚¬â€ at kazandÃ„Â±. agfTrendTerfisiUygula
// AGF-1'i BURADA KORUMAZ, ÃƒÂ§ÃƒÂ¼nkÃƒÂ¼ o mekanizma olasÃ„Â±lÃ„Â±Ã„Å¸a gÃƒÂ¶re YARIÃ…ÂIYOR (candidate havuzda
// en gÃƒÂ¼ÃƒÂ§lÃƒÂ¼ N tanesi kazanÃ„Â±yor) Ã¢â‚¬â€ AGF-1'in olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â± zaten dÃƒÂ¼Ã…Å¸ÃƒÂ¼kse yine dÃ„Â±Ã…Å¸arÃ„Â±da kalÃ„Â±r.
// Orijinal backtest (512 sonuÃƒÂ§lanmÃ„Â±Ã…Å¸ yarÃ„Â±Ã…Å¸, 2026-07-01 sonrasÃ„Â±, yayÃ„Â±nlanan Prediction.picks
// ile): AGF-1 favorisi %33.6 kazanÃ„Â±yor (gerÃƒÂ§ek), modelin top3'ÃƒÂ¼ bunlarÃ„Â±n %91.9'unu zaten
// yakalÃ„Â±yordu Ã¢â‚¬â€ geri kalan %8.1 (14 yarÃ„Â±Ã…Å¸) modelin top3'ÃƒÂ¼nde YOKTU. AGF-1'i KOÃ…ÂULSUZ
// 3.sÃ„Â±raya zorlarsak (mevcut #3'ÃƒÂ¼n yerini alarak): +14 yeni galibiyet yakalanÃ„Â±r, yalnÃ„Â±z
// 5 kez yerini aldÃ„Â±Ã„Å¸Ã„Â±mÃ„Â±z #3 zaten kazanandÃ„Â± Ã¢â‚¬â€ NET +9/512 (top3 isabeti %60.2Ã¢â€ â€™%61.9).
// OlasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â±/skoru DEÃ„ÂÃ„Â°Ã…ÂTÃ„Â°RMEZ, yalnÃ„Â±z GÃƒâ€“STERÃ„Â°M sÃ„Â±rasÃ„Â±nÃ„Â± etkiler (agfTrendTerfisiUygula
// ile aynÃ„Â± ilke) Ã¢â‚¬â€ ama o mekanizmadan FARKLI olarak koÃ…Å¸ulsuzdur, rekabete girmez.
function agfFavoriIlk3Garantisi<T extends { no: number; agfSirasi: number }>(
  sirali: T[]
): (T & { agfFavoriGarantisi: boolean })[] {
  const isaretsiz = sirali.map((r) => ({ ...r, agfFavoriGarantisi: false }));
  const idx = isaretsiz.findIndex((r) => r.agfSirasi === 1);
  if (idx < 0 || idx < 3) return isaretsiz;

  const kopya = [...isaretsiz];
  const [agf1] = kopya.splice(idx, 1);
  kopya.splice(2, 0, { ...agf1, agfFavoriGarantisi: true });
  return kopya;
}

// 2026-09-02 kullanÃ„Â±cÃ„Â± kararÃ„Â± (THEATER OF WAR vakasÃ„Â±, Ã„Â°stanbul Ã¢â‚¬â€ Saf Model marketBlindProb1
// atÃ„Â± 4.sÃ„Â±raya/%10.2 koyuyordu, AGF payÃ„Â± yalnÃ„Â±z %5.0'dÃ„Â±, harmanlanan nihai skor 8.sÃ„Â±raya
// gÃƒÂ¶mdÃƒÂ¼ Ã¢â‚¬â€ at gÃƒÂ¼nÃƒÂ¼n en iyi performanslarÃ„Â±ndan birini verdi). KullanÃ„Â±cÃ„Â±: "olumlu sinyaller
// varken agf piyasaya gÃƒÂ¶re at aÃ…Å¸aÃ„Å¸Ã„Â±lara ÃƒÂ§ekilmemeli en azÃ„Â±ndan 6. at dÃ„Â±Ã…Å¸Ã„Â±na atÃ„Â±lmamalÃ„Â±."
// SAF_MODEL_DEGER_ESIGI, V5AnalysisPanel'deki "Saf Model vs AGF" rozetinin Ã¢Å¡Â  eÃ…Å¸iÃ„Å¸iyle
// (fark=marketBlindProb1*100-agfPayi>=5) AYNI Ã¢â‚¬â€ o rozet o zamana kadar "yalnÃ„Â±z bilgi
// amaÃƒÂ§lÃ„Â±, sÃ„Â±ralamayÃ„Â± etkilemez" idi, kullanÃ„Â±cÃ„Â± bu kararla bunu tersine ÃƒÂ§evirdi.
// pistUzmani'nin kendisi (genel yÃƒÂ¼zey/hipodrom-baÃ„Å¸Ã„Â±msÃ„Â±z kazanma oranÃ„Â±) BÃ„Â°LEREK skorlamaya
// eklenmedi Ã¢â‚¬â€ bkz. sinyal-kutugu.service.ts "Genel Pist Tercihi (Hipodrom-BaÃ„Å¸Ã„Â±msÃ„Â±z YÃƒÂ¼zey
// Kazanma OranÃ„Â±)": GREEN GULET vakasÃ„Â±yla (aynÃ„Â± THEATER OF WAR tÃƒÂ¼rÃƒÂ¼ tetikleyici) test
// edilmiÃ…Å¸, leak-free B=500 bootstrap'ta iki segmentte de TAMAMEN anlamsÃ„Â±z ÃƒÂ§Ã„Â±kmÃ„Â±Ã…Å¸tÃ„Â±.
//
// DÃƒÅ“ZELTME (aynÃ„Â± gÃƒÂ¼n, canlÃ„Â±ya alÃ„Â±ndÃ„Â±ktan hemen sonra) Ã¢â‚¬â€ kullanÃ„Â±cÃ„Â± gerÃƒÂ§ek BAY UMUT/Ã„Â°stanbul
// K4 vakasÃ„Â±nÃ„Â± sordu: fark=+5.1pp olmasÃ„Â±na raÃ„Å¸men terfi etmemiÃ…Å¸ti. KÃƒÂ¶k neden: ilk sÃƒÂ¼rÃƒÂ¼m
// ikinci koÃ…Å¸ul olarak sinyalSayisi>=SINYAL_ESIGI kullanÃ„Â±yordu (agfTrendTerfisi'nden ÃƒÂ¶dÃƒÂ¼nÃƒÂ§
// alÃ„Â±nmÃ„Â±Ã…Å¸) Ã¢â‚¬â€ ama bu, V4/V2 dÃƒÂ¶neminden kalma DAR bir 8-maddelik kontrol listesi (Accurace/
// KGS-14-30/hipodrom-mesafe kazanma/aygÃ„Â±r-ÃƒÂ¼st-%20/galop/idman-jokeyi/AGF-trend/form) ve
// BAY UMUT'un marketBlindProb1'ini GERÃƒâ€¡EKTE yÃƒÂ¼kselten asÃ„Â±l sinyallerle (hizDerecesi=+1.24,
// h2hNetSkor=+1, antrenorOrani=%13.8) HÃ„Â°Ãƒâ€¡ Ãƒâ€“RTÃƒÅ“Ã…ÂMÃƒÅ“YOR Ã¢â‚¬â€ BAY UMUT'un sinyalSayisi'si 0 ÃƒÂ§Ã„Â±ktÃ„Â±,
// yanlÃ„Â±Ã…Å¸ kapÃ„Â±dan reddedildi. GerÃƒÂ§ek Ã„Â°stanbul K4 verisiyle (12 at) doÃ„Å¸rulandÃ„Â±: doÃ„Å¸ru soru
// "modelin AGF-hariÃƒÂ§ kendi gÃƒÂ¶rÃƒÂ¼Ã…Å¸ÃƒÂ¼ GERÃƒâ€¡EKTEN net pozitif mi" Ã¢â‚¬â€ bu zaten marketBlindProb1'in
// KENDÃ„Â° hesaplama yÃƒÂ¶ntemiyle (AGF_KATKI_INDEKSLERI hariÃƒÂ§ tutulan katkÃ„Â±lar toplamÃ„Â±) birebir
// ÃƒÂ¶lÃƒÂ§ÃƒÂ¼lebiliyor, ayrÃ„Â±/uyumsuz bir sinyal sayacÃ„Â± icat etmeye gerek yok. Yeni koÃ…Å¸ul: katkilar
// dizisinin AGF-dÃ„Â±Ã…Å¸Ã„Â± toplamÃ„Â± > 0 (yani modelin AGF'siz gÃƒÂ¶rÃƒÂ¼Ã…Å¸ÃƒÂ¼ GERÃƒâ€¡EKTEN, net olarak pozitif
// Ã¢â‚¬â€ yalnÃ„Â±z AGF'nin ortalamadan daha kÃƒÂ¶tÃƒÂ¼mser olmasÃ„Â± yÃƒÂ¼zÃƒÂ¼nden ORTAYA Ãƒâ€¡IKAN sahte bir fark
// deÃ„Å¸il). GerÃƒÂ§ek K4/K6 verisiyle ÃƒÂ§apraz kontrol edildi: BAY UMUT (+0.27) ve K4'teki
// Ã…ÂÃ„Â°MÃ…ÂEKKIRAN (+0.30) doÃ„Å¸ru Ã…Å¸ekilde nitelik kazanÃ„Â±yor; K4'teki DÃ„Â°LAN KIZ (toplam -0.14,
// fark yine de +5.9pp) ve K6'daki ANGEL OF DEFNE (negatif temel sinyaller) doÃ„Å¸ru Ã…Å¸ekilde
// DIÃ…ÂLANIYOR Ã¢â‚¬â€ ikisi de bÃƒÂ¼yÃƒÂ¼k farkÃ„Â± yalnÃ„Â±z AGF'nin ekstra kÃƒÂ¶tÃƒÂ¼mserliÃ„Å¸inden alÃ„Â±yor, modelin
// kendi (AGF'siz) gÃƒÂ¶rÃƒÂ¼Ã…Å¸ÃƒÂ¼ onlar iÃƒÂ§in de zaten olumsuz.
const SAF_MODEL_DEGER_ESIGI = 5;

// 2026-09-03 kullanÃ„Â±cÃ„Â± bulgusu (Ã„Â°zmir K5, KINDBERO Ã¢â‚¬â€ kazandÃ„Â± ama 4.sÃ„Â±rada kaldÃ„Â±): Saf
// Model onu 2.sÃ„Â±rada (%16.4) gÃƒÂ¶rÃƒÂ¼yordu, AGF yalnÃ„Â±z 5.sÃ„Â±raya koymuÃ…Å¸tu (fark=+8.2pp), 4.sÃ„Â±ra
// (ilk-6 iÃƒÂ§i) Saf Model DeÃ„Å¸er Terfisi'nin hiÃƒÂ§ devreye girmesini gerektirmiyordu Ã¢â‚¬â€ ama
// kullanÃ„Â±cÃ„Â± ilk-3 iÃƒÂ§in de aynÃ„Â± ilkeyi istedi. AYNI (koÃ…Å¸ulsuz splice) mekanizma, agfTrend
// Terfisi'nin ilk3Ã¢â€ â€™ilk6 Ã„Â°KÃ„Â° KADEMELÃ„Â° desenIYLE (bkz. agfTrendTerfisiUygula) birebir aynÃ„Â±
// yapÃ„Â±da: ÃƒÂ¶nce daha SIKI bir eÃ…Å¸ikle (8pp, KINDBERO'nun kendi rakamÃ„Â±yla uyumlu Ã¢â‚¬â€ ilk-3
// daha bÃƒÂ¼yÃƒÂ¼k bir iddia, yanlÃ„Â±Ã…Å¸-pozitif riski daha yÃƒÂ¼ksek) ilk-3 denenir, sonra (ilk-3'ÃƒÂ¼
// kazanamayan adaylar dahil) mevcut 5pp eÃ…Å¸iÃ„Å¸iyle ilk-6 denenir.
const SAF_MODEL_DEGER_ESIGI_ILK3 = 8;

function safModelDegerTerfisiUygula<
  T extends {
    no: number; olasilik: number; marketBlindProb1: number; agfPayi: number; katkilar: number[];
    ekuriGroup: number | null;
  }
>(sirali: T[]): (T & { degerTerfisi: "ilk3" | "ilk6" | null })[] {
  const nonAgfPozitifMi = (r: T) => {
    const nonAgfToplam = r.katkilar.reduce((toplam, k, i) => (AGF_KATKI_INDEKSLERI.includes(i) ? toplam : toplam + k), 0);
    return nonAgfToplam > 0;
  };
  const isaretsiz = sirali.map((r) => ({ ...r, degerTerfisi: null as "ilk3" | "ilk6" | null }));

  const { sonuc: ilk3Sonrasi, terfiEdenNolar: ilk3Terfi } = terfiPenceresiV5(isaretsiz, 3, (r) => {
    const fark = r.marketBlindProb1 * 100 - r.agfPayi;
    return fark >= SAF_MODEL_DEGER_ESIGI_ILK3 && nonAgfPozitifMi(r);
  });
  const ilk3Isaretli = ilk3Sonrasi.map((r) => (ilk3Terfi.has(r.no) ? { ...r, degerTerfisi: "ilk3" as const } : r));

  const { sonuc: ilk6Sonrasi, terfiEdenNolar: ilk6Terfi } = terfiPenceresiV5(ilk3Isaretli, 6, (r) => {
    const fark = r.marketBlindProb1 * 100 - r.agfPayi;
    return fark >= SAF_MODEL_DEGER_ESIGI && nonAgfPozitifMi(r);
  });
  return ilk6Sonrasi.map((r) => (ilk6Terfi.has(r.no) ? { ...r, degerTerfisi: "ilk6" as const } : r));
}

// 2026-08-26 kullanÃ„Â±cÃ„Â± bulgusu: "sistemin 1. seÃƒÂ§imi, AGF favorisinden daha isabetsiz"
// (dashboard'daki Sistem vs AGF Favorisi kartÃ„Â±: -4.2 puan, n=448). KÃƒÂ¶k neden araÃ…Å¸tÃ„Â±rÃ„Â±ldÃ„Â±:
// sorun Handikap'a ÃƒÂ¶zel deÃ„Å¸il (orada fark en KÃƒÅ“Ãƒâ€¡ÃƒÅ“K, -1.5) Ã¢â‚¬â€ asÃ„Â±l kanama, sistemin AGF
// favorisinden FARKLI bir at seÃƒÂ§tiÃ„Å¸i durumlarda, o atÃ„Â±n AGF sÃ„Â±rasÃ„Â±na gÃƒÂ¶re keskin biÃƒÂ§imde
// ayrÃ„Â±Ã…Å¸Ã„Â±yor. Split-half doÃ„Å¸rulandÃ„Â± (2 baÃ„Å¸Ã„Â±msÃ„Â±z dÃƒÂ¶nemde de aynÃ„Â± desen):
//   AGF sÃ„Â±rasÃ„Â± 2. seÃƒÂ§ilince: %38.5 / %20.5 isabet (gerÃƒÂ§ek deÃ„Å¸er bulma Ã¢â‚¬â€ dokunulmadÃ„Â±)
//   AGF sÃ„Â±rasÃ„Â± 3. seÃƒÂ§ilince: %25.0 / %15.4 isabet (hÃƒÂ¢lÃƒÂ¢ makul Ã¢â‚¬â€ dokunulmadÃ„Â±)
//   AGF sÃ„Â±rasÃ„Â± 4.+ seÃƒÂ§ilince: %2.9 / %0.0 isabet (n=60 toplam, 1 galibiyet) Ã¢â‚¬â€ bu "deÃ„Å¸er
//   bulma" deÃ„Å¸il, modelin derin bir longshot'a kÃƒÂ¶pÃƒÂ¼rmesi.
// Bu atlarÃ„Â± AGF favorisine ZORLAMIYORUZ (o da yalnÃ„Â±z %35 kurtarÃ„Â±yor, kalan %65'i BAÃ…ÂKA
// bir at kazanÃ„Â±yor Ã¢â‚¬â€ "her zaman AGF'ye gÃƒÂ¼ven" kullanÃ„Â±cÃ„Â±nÃ„Â±n reddettiÃ„Å¸i bir yaklaÃ…Å¸Ã„Â±m).
// Bunun yerine modelin KENDÃ„Â° sÃ„Â±ralÃ„Â± listesinde AGF sÃ„Â±rasÃ„Â±<=3 olan EN ÃƒÅ“ST adayÃ„Â±na inilir
// (ÃƒÂ§oÃ„Å¸unlukla AGF favorisiyle ÃƒÂ§akÃ„Â±Ã…Å¸Ã„Â±yor ama illa deÃ„Å¸il Ã¢â‚¬â€ model muhakemesi birincil kalÃ„Â±r).
// Geriye dÃƒÂ¶nÃƒÂ¼k simÃƒÂ¼lasyon (448 sonuÃƒÂ§lanmÃ„Â±Ã…Å¸ yarÃ„Â±Ã…Å¸): %28.6Ã¢â€ â€™%33.0 (net +20), AGF favorisinin
// kendi oranÃ„Â±nÃ„Â± (%32.8) hafifÃƒÂ§e geÃƒÂ§iyor. 2026-08-27'de kaldÃ„Â±rÃ„Â±lÃ„Â±p aynÃ„Â± gÃƒÂ¼n, GÃƒÅ“NCEL veride
// walk-forward + B=500 ile yeniden doÃ„Å¸rulanÃ„Â±p GERÃ„Â° getirildi (bkz. ENGINE_VERSIONS V5.23):
// 794 yarÃ„Â±Ã…Å¸lÃ„Â±k out-of-fold havuzda top1 net GA=[2,19] (sÃ„Â±fÃ„Â±rÃ„Â± iÃƒÂ§ermiyor), top3'e SIFIR
// maliyet (net GA=[0,0] Ã¢â‚¬â€ hiÃƒÂ§bir bootstrap ÃƒÂ¶rneÃ„Å¸inde top3 seti deÃ„Å¸iÃ…Å¸medi).
const DERIN_LONGSHOT_AGF_ESIGI = 3;

// 2026-08-27 kullanÃ„Â±cÃ„Â± KESÃ„Â°N kararÃ„Â± (Kocaeli 2.KoÃ…Å¸u ÃƒÂ¶rneÃ„Å¸i somut kanÃ„Â±t oldu Ã¢â‚¬â€ TEYZEOÃ„ÂLU
// %11.1 ile 1.sÃ„Â±rada, MAÃ…ÂÃ„Â°DE %23.5 ile 3.sÃ„Â±rada duruyordu): "sÃ„Â±ralama yÃƒÂ¼zdeye gÃƒÂ¶re olur,
// 1.sÃ„Â±radaki ata %24 vermelisin." O gÃƒÂ¼n Ã„Â°KÃ„Â° YÃƒâ€“NDE de deÃ„Å¸iÃ…Å¸ti (V5.20'de kaldÃ„Â±rÃ„Â±ldÃ„Â±, V5.21-23'te
// tek tek geri geldi, sonra KESÃ„Â°N olarak tekrar kaldÃ„Â±rÃ„Â±lmÃ„Â±Ã…Å¸tÃ„Â±) Ã¢â‚¬â€ ÃƒÂ¼ÃƒÂ§ÃƒÂ¼nÃƒÂ¼n kendi backtest kanÃ„Â±tÃ„Â±
// (n=663/428/448) o zaman da GEÃƒâ€¡ERLÃ„Â° sayÃ„Â±lÃ„Â±yordu, yalnÃ„Â±z kullanÃ„Â±cÃ„Â± ham yÃƒÂ¼zdeden SAPMA
// istemiyordu (prensip vetosu, istatistik deÃ„Å¸il).
//
// 2026-08-30 Ã¢â‚¬â€ kullanÃ„Â±cÃ„Â± bu ÃƒÂ¼ÃƒÂ§ kuralÃ„Â± tek tek yeniden deÃ„Å¸erlendirdi, TEK bir ortak
// anahtar yerine ÃƒÅ“Ãƒâ€¡ AYRI anahtara bÃƒÂ¶lÃƒÂ¼ndÃƒÂ¼ ki karar ÃƒÂ¼ÃƒÂ§ÃƒÂ¼ iÃƒÂ§in de aynÃ„Â± olmak zorunda kalmasÃ„Â±n:
// - AGF Trend Terfisi: GERÃ„Â° AÃƒâ€¡ILDI. Kocaeli-tipi bir ÃƒÂ§akÃ„Â±Ã…Å¸maya YOL AÃƒâ€¡MAZ (agfSirasi'na gÃƒÂ¶re
//   koÃ…Å¸ulsuz deÃ„Å¸il, adayÃ„Â±n olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â± diÃ„Å¸er adaylarla YARIÃ…ÂIR Ã¢â‚¬â€ bkz. terfiPenceresiV5/
//   agfTrendTerfisiUygula'nÃ„Â±n kendi notu) ve n=663 kanÃ„Â±tÃ„Â± hÃƒÂ¢lÃƒÂ¢ geÃƒÂ§erli.
// - AGF Favorisi Ã„Â°lk-3 Garantisi: KAPALI KALDI. Tam olarak Kocaeli 2.KoÃ…Å¸u'daki gibi bir
//   durumda (AGF favorisi ham sÃ„Â±ralamada top3 dÃ„Â±Ã…Å¸Ã„Â±na dÃƒÂ¼Ã…Å¸ÃƒÂ¼nce) modelin kendi yÃƒÂ¼zdesini
//   YOK SAYIP o atÃ„Â± KOÃ…ÂULSUZ 3.sÃ„Â±raya ÃƒÂ§eker Ã¢â‚¬â€ kullanÃ„Â±cÃ„Â±nÃ„Â±n reddettiÃ„Å¸i davranÃ„Â±Ã…Å¸Ã„Â±n ta kendisi.
// - Derin AGF-Longshot DÃƒÂ¼zeltmesi: KAPALI KALDI, hem aynÃ„Â± prensip gerekÃƒÂ§esiyle hem de
//   artÃ„Â±k istatistiksel kanÃ„Â±tÃ„Â± da yok (gÃƒÂ¼ncel/tazelenmiÃ…Å¸ veride GA=[-3,11], sÃ„Â±fÃ„Â±rÃ„Â± iÃƒÂ§eriyor).
const AGF_TREND_TERFISI_AKTIF = true;
const AGF_FAVORI_ILK3_GARANTISI_AKTIF = false;
const DERIN_LONGSHOT_DUZELTMESI_AKTIF = false;
// 2026-09-02 kullanÃ„Â±cÃ„Â± kararÃ„Â± (THEATER OF WAR) Ã¢â‚¬â€ bkz. safModelDegerTerfisiUygula'nÃ„Â±n
// ÃƒÂ¼stÃƒÂ¼ndeki not. AGF_FAVORI_ILK3_GARANTISI_AKTIF/DERIN_LONGSHOT_DUZELTMESI_AKTIF'Ã„Â±n
// AKSÃ„Â°NE bu KAPALI DEÃ„ÂÃ„Â°L: farklÃ„Â± bir ilkeye dayanÃ„Â±yor (piyasa payÃ„Â±nÃ„Â± YOK SAYMIYOR,
// piyasanÃ„Â±n GÃƒâ€“RMEDÃ„Â°Ã„ÂÃ„Â° baÃ„Å¸Ã„Â±msÃ„Â±z modeli deÃ„Å¸eri + ayrÃ„Â± sinyal kanÃ„Â±tÃ„Â±nÃ„Â± birlikte arÃ„Â±yor).
const SAF_MODEL_DEGER_TERFISI_AKTIF = true;

function derinLongshotDuzelt<T extends { no: number; agfSirasi: number }>(sirali: T[]): T[] {
  if (sirali.length === 0 || sirali[0].agfSirasi <= DERIN_LONGSHOT_AGF_ESIGI) return sirali;
  const idx = sirali.findIndex((r, i) => i > 0 && r.agfSirasi <= DERIN_LONGSHOT_AGF_ESIGI);
  if (idx < 0) return sirali; // uygun aday yoksa (ÃƒÂ¶r. tÃƒÂ¼m sahada AGF verisi eksik) dokunma
  const kopya = [...sirali];
  [kopya[0], kopya[idx]] = [kopya[idx], kopya[0]];
  return kopya;
}

// 2026-08-29/30 Ã¢â‚¬â€ "B katmanÃ„Â±" (bkz. plan: A/B/C Sinyal Katmanlama Mimarisi). sireOrani
// bugÃƒÂ¼n 8 aday arasÃ„Â±nda en gÃƒÂ¼ÃƒÂ§lÃƒÂ¼ gÃƒÂ¶rÃƒÂ¼ndÃƒÂ¼ ama KALICI araÃƒÂ§la (n=1060, segment-bazlÃ„Â±, gerÃƒÂ§ek
// train/test) yeniden test edilince dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art'ta da anlamsÃ„Â±z ÃƒÂ§Ã„Â±ktÃ„Â± (nokta=0.0477,
// GA=[-0.1352,0.2045]). KullanÃ„Â±cÃ„Â± KARARIYLA (zeminToleransi emsaliyle, AYNI oturumda
// AskUserQuestion ile teyit alÃ„Â±ndÃ„Â±) yine de dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art'a Ãƒâ€“ZEL, mevcut 12-ÃƒÂ¶zellikli A
// katmanÃ„Â±na KARIÃ…ÂMADAN (13. terim olarak yeniden fit EDÃ„Â°LMEDEN Ã¢â‚¬â€ bu, bugÃƒÂ¼n 7/8 adayda
// "kÃƒÂ¼ÃƒÂ§ÃƒÂ¼k ÃƒÂ¶rneklemde gÃƒÂ¼ÃƒÂ§ kaybÃ„Â±" sorununa yol aÃƒÂ§an yÃƒÂ¶ntemdi) ayrÃ„Â± bir katman olarak eklendi.
// KatsayÃ„Â±, bugÃƒÂ¼nÃƒÂ¼n gerÃƒÂ§ek dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art eÃ„Å¸itiminden (nokta tahmini, kanÃ„Â±tsÃ„Â±z ama KEYFÃ„Â°
// DEÃ„ÂÃ„Â°L) alÃ„Â±ndÃ„Â±. Ortalama/sapma, model-veri.json'daki dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art runner satÃ„Â±rlarÃ„Â±ndan
// (n=10612) tek seferlik hesaplandÃ„Â± Ã¢â‚¬â€ WEIGHTS_DUSUK_SART.means/stds ile AYNI kaynak,
// yalnÃ„Â±z sireOrani A katmanÃ„Â±nÃ„Â±n dÃ„Â±Ã…Å¸Ã„Â±nda tutulduÃ„Å¸u iÃƒÂ§in ayrÃ„Â± sabitlendi.
const B_SIREORANI_KATSAYI = 0.0477;
const B_SIREORANI_ORTALAMA = 11.6305;
const B_SIREORANI_SAPMA = 3.6563;

/** Bir koÃ…Å¸unun dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art aÃ„Å¸Ã„Â±rlÃ„Â±Ã„Å¸Ã„Â± Ã¢â‚¬â€ agirlikSetleriSec ile AYNI mantÃ„Â±k (saf dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art=1,
 *  hibrit Maiden/SatÃ„Â±Ã…Å¸=0.5 [harmanliSkorla'nÃ„Â±n kendi ortalamasÃ„Â±yla tutarlÃ„Â±], diÃ„Å¸er=0). */
function bAgirlikOrani(classType: string): number {
  if (hibritMaidenSatisMi(classType)) return 0.5;
  const kategori = kategoriTespit(classType);
  return kategori === "1a" || kategori === "1b" ? 1 : 0;
}

// 2026-08-30 kullanÃ„Â±cÃ„Â± KARARI: Zemin+Mesafe Deneyimi (bkz. zemin-mesafe-deneyimi.actions.ts,
// C katmanÃ„Â±/v6-zemin-mesafe-deneyimi challenger'Ã„Â±) nÃ¢â€°Â¥250-300 gÃƒÂ¶lge-koÃ…Å¸u/B=500 kanÃ„Â±tÃ„Â±
// beklenmeden DERHAL canlÃ„Â±ya alÃ„Â±nmasÃ„Â± istendi Ã¢â‚¬â€ sireOrani/zeminToleransi ile AYNI tÃƒÂ¼rden
// bilinÃƒÂ§li, kanÃ„Â±tsÃ„Â±z bir istisna (standart "ÃƒÂ¶nce backtest" kuralÃ„Â±nÃ„Â±n aÃƒÂ§Ã„Â±k ihlali, kullanÃ„Â±cÃ„Â±
// kararÃ„Â±yla). sireOrani'nin AKSÃ„Â°NE dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art'a ÃƒÂ¶zgÃƒÂ¼ deÃ„Å¸il Ã¢â‚¬â€ kavram (bugÃƒÂ¼nkÃƒÂ¼ tam pist+zemin+
// mesafe koÃ…Å¸ulunda kanÃ„Â±tlanmÃ„Â±Ã…Å¸ deneyim) TÃƒÅ“M kategorilerde anlamlÃ„Â±, bu yÃƒÂ¼zden oran HER ZAMAN
// 1 (bAgirlikOrani'ye tabi deÃ„Å¸il). KatsayÃ„Â± (0.02), challenger'da test edilen AYNI
// kanÃ„Â±tlanmamÃ„Â±Ã…Å¸ varsayÃ„Â±m.
// 2026-09-12 DÃƒÅ“ZELTME: "doÃ„Å¸al olarak ~0 merkezli" varsayÃ„Â±mÃ„Â± hiÃƒÂ§ Ãƒâ€“LÃƒâ€¡ÃƒÅ“LMEMÃ„Â°Ã…ÂTÃ„Â° Ã¢â‚¬â€ gerÃƒÂ§ek
// veride (n=4482 veri-olan at, model-veri-yg4.json) ortalama -0.515 (std=2.624) ÃƒÂ§Ã„Â±ktÃ„Â±,
// yani her ata kÃƒÂ¼ÃƒÂ§ÃƒÂ¼k bir sistematik CEZA biniyordu. ArtÃ„Â±k sireOrani ile AYNI desende
// merkezleniyor (yalnÃ„Â±z GERÃƒâ€¡EK veri olan atlarda Ã¢â‚¬â€ "veri yok" iÃƒÂ§in 0 nÃƒÂ¶tr kalmalÃ„Â±, aksi
// halde eksik veriye sahte bir sinyal binerdi).
const B_ZEMINMESAFE_KATSAYI = 0.02;
const B_ZEMINMESAFE_ORTALAMA = -0.515;

/** B katmanÃ„Â±nÃ„Â± (sireOrani/dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art + zeminMesafeDeneyim/TÃƒÅ“M kategoriler) softmax'a girmeden
 *  Ãƒâ€“NCE skora ekler. softmax(skor+Ãâ€) Ã¢Ë†Â softmax(skor)Ãƒâ€”exp(Ãâ€) olduÃ„Å¸u iÃƒÂ§in bu, "olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â±
 *  ÃƒÂ§arpmak" ile matematiksel olarak AYNI Ã…Å¸ey Ã¢â‚¬â€ ama A'nÃ„Â±n kendi regresyonuna karÃ„Â±Ã…Å¸madan, ayrÃ„Â±
 *  kalibre edilmiÃ…Å¸ terimler olarak. */
function bKatmaniUygula(
  skorlar: number[],
  runners: Faz1RunnerV5[],
  classType: string
): { skorlar: number[]; uygulandi: boolean[]; zeminMesafeUygulandi: boolean[]; sireKatkilar: number[]; zeminMesafeKatkilar: number[] } {
  const sireOran = bAgirlikOrani(classType);
  const sireKatkilar = runners.map((r) =>
    sireOran === 0 ? 0 : sireOran * B_SIREORANI_KATSAYI * ((r.sireOrani - B_SIREORANI_ORTALAMA) / B_SIREORANI_SAPMA)
  );
  const zeminMesafeKatkilar = runners.map((r) =>
    r.zeminMesafeDeneyimSeviyesi === "yok" ? 0 : B_ZEMINMESAFE_KATSAYI * (r.zeminMesafeDeneyim - B_ZEMINMESAFE_ORTALAMA)
  );
  const yeniSkorlar = skorlar.map((skor, i) => skor + sireKatkilar[i] + zeminMesafeKatkilar[i]);
  return {
    skorlar: yeniSkorlar,
    uygulandi: runners.map(() => sireOran > 0),
    zeminMesafeUygulandi: runners.map((r) => r.zeminMesafeDeneyim !== 0),
    sireKatkilar,
    zeminMesafeKatkilar,
  };
}

export function faz2V5Sirala(faz1: Faz1SonucV5): Faz1RunnerV5Sirali[] {
  const setler = agirlikSetleriSec(faz1.race.classType);
  const harmanlar = faz1.runners.map((r) => harmanliSkorla(toFeatureVector(r), setler));
  const handikapMi = kategoriTespit(faz1.race.classType) === "2";
  const liderEsigi = handikapMi ? ASIRI_GUVEN_LIDER_ESIGI_HANDIKAP : ASIRI_GUVEN_LIDER_ESIGI;
  const skorlarHam = harmanlar.map((h) => h.skor);
  const {
    skorlar,
    uygulandi: bKatmaniUygulandi,
    zeminMesafeUygulandi,
    sireKatkilar: bSireKatkilar,
    zeminMesafeKatkilar: bZeminMesafeKatkilar,
  } = bKatmaniUygula(skorlarHam, faz1.runners, faz1.race.classType);
  const probs = softmax(skorlar, liderEsigi);
  const etkinSkorlar = effektifSkorlar(skorlar, liderEsigi);
  const top2Marjinal = plackettLuceTopKMarginals(etkinSkorlar, 2);
  const top3Marjinal = plackettLuceTopKMarginals(etkinSkorlar, 3);
  const marketBlindProbs = marketBlindOlasiliklariHesapla(
    skorlar,
    harmanlar.map((h) => h.katkilar),
    liderEsigi
  );

  const enriched = faz1.runners.map((r, i) => {
    const sinyal = hesaplaSinyalSayisi(
      {
        no: r.no,
        recentForm: r.recentForm,
        accuraceSonYarisEnHizliKapanis: r.accurace === 1,
        gunAralik: r.kgsVarMi ? r.kgs : null,
        hipodromMesafedeKazandi: r.hipodromMesafedeKazandi,
        sireKazanmaOrani: r.sireKazanmaOraniHam,
        sireOrneklemKendiVeri: r.sireOrneklemKendiVeri,
        keskinGalopZinciri: r.galop === 1,
        idmanJokeyiUyumu: r.idmJokey === 1,
      },
      r.agfTrendYonu ? { fark: r.agfTrendFark!, yon: r.agfTrendYonu } : undefined
    );
    return {
      ...r,
      olasilik: probs[i],
      probTop2: top2Marjinal[i],
      probTop3: top3Marjinal[i],
      marketBlindProb1: marketBlindProbs[i],
      bKatmaniUygulandiMi: bKatmaniUygulandi[i],
      zeminMesafeBKatmaniUygulandiMi: zeminMesafeUygulandi[i],
      bSireKatkisi: bSireKatkilar[i],
      bZeminMesafeKatkisi: bZeminMesafeKatkilar[i],
      standartVektor: harmanlar[i].standartVektor,
      katkilar: harmanlar[i].katkilar,
      sinyalSayisi: sinyal.sayi,
    };
  });

  const sirali = [...enriched].sort((a, b) => (b.olasilik !== a.olasilik ? b.olasilik - a.olasilik : a.no - b.no));

  const terfili = AGF_TREND_TERFISI_AKTIF
    ? agfTrendTerfisiUygula(sirali)
    : sirali.map((r) => ({ ...r, agfTerfi: null as "ilk3" | "ilk6" | null }));

  const garantili = AGF_FAVORI_ILK3_GARANTISI_AKTIF
    ? agfFavoriIlk3Garantisi(terfili)
    : terfili.map((r) => ({ ...r, agfFavoriGarantisi: false }));

  const duzeltilmis = DERIN_LONGSHOT_DUZELTMESI_AKTIF ? derinLongshotDuzelt(garantili) : garantili;

  const degerliSiralanmis = SAF_MODEL_DEGER_TERFISI_AKTIF
    ? safModelDegerTerfisiUygula(duzeltilmis)
    : duzeltilmis.map((r) => ({ ...r, degerTerfisi: null as "ilk3" | "ilk6" | null }));

  // 2026-09-02 EKÃƒÅ“RÃ„Â° DÃƒÅ“ZELTMESÃ„Â° (Ã„Â°stanbul K6, THEATER OF WAR) Ã¢â‚¬â€ bkz. efektifPencereSiniri
  // ÃƒÂ¼stÃƒÂ¼ndeki not. Bir ekÃƒÂ¼ri ÃƒÂ§ifti ilk-6 iÃƒÂ§inde iki ayrÃ„Â± ham pozisyon tutuyorsa, hemen
  // ardÃ„Â±ndan gelen at (THEATER OF WAR gibi) GERÃƒâ€¡EKTE ilk-6'nÃ„Â±n iÃƒÂ§inde sayÃ„Â±lÃ„Â±r Ã¢â‚¬â€ teknikSira
  // (ham 1..N sÃ„Â±ra) DEÃ„ÂÃ„Â°Ã…ÂMEZ, yalnÃ„Â±z "Orta/YÃƒÂ¼ksek Risk Ã¢â€ â€™ DÃƒÂ¼Ã…Å¸ÃƒÂ¼k Risk" kararÃ„Â±, tÃ„Â±pkÃ„Â± ilk6
  // terfisi/deÃ„Å¸er terfisi almÃ„Â±Ã…Å¸ bir at gibi, ona da uygulanÃ„Â±r.
  const ilk6EfektifSinir = efektifPencereSiniri(degerliSiralanmis, 6);

  // 2026-09-03 kullanÃ„Â±cÃ„Â± bulgusu (Ã„Â°zmir K7, PRENSES BERRÃ„Â°N): agfTrendTerfisiUygula ilk6
  // ADIMINDA onu 6.sÃ„Â±raya taÃ…Å¸Ã„Â±mÃ„Â±Ã…Å¸tÃ„Â± (agfTerfi="ilk6" damgalandÃ„Â±) Ã¢â‚¬â€ ama HEMEN ARDINDAN
  // ÃƒÂ§alÃ„Â±Ã…Å¸an safModelDegerTerfisiUygula, AYNI 6.slotu YURTKURAN iÃƒÂ§in kullanÃ„Â±p onu sessizce
  // 7.sÃ„Â±raya GERÃ„Â° itti. agfTerfi/degerTerfisi bayraklarÃ„Â± o ANDAKÃ„Â° (artÃ„Â±k BAYAT) durumu
  // taÃ…Å¸Ã„Â±maya devam etti Ã¢â‚¬â€ PRENSES BERRÃ„Â°N son halde 7.sÃ„Â±rada (ilk-6 DIÃ…ÂINDA) olmasÃ„Â±na
  // raÃ„Å¸men "DÃƒÂ¼Ã…Å¸ÃƒÂ¼k Risk" kararÃ„Â± ve "ilk-6'ya terfi" gerekÃƒÂ§e metni GÃƒâ€“STERMEYE devam etti,
  // bu YANILTICIYDI. DÃƒÂ¼zeltme: bayraklar burada GERÃƒâ€¡EK son pozisyona (i) gÃƒÂ¶re YENÃ„Â°DEN
  // hesaplanÃ„Â±yor Ã¢â‚¬â€ bir terfi sonraki bir mekanizma tarafÃ„Â±ndan geri alÃ„Â±nmÃ„Â±Ã…Å¸sa (evict
  // edilmiÃ…Å¸se) bayrak da onunla birlikte sÃ„Â±fÃ„Â±rlanÃ„Â±r (ya alt kademeye Ã¢â‚¬â€ ilk3Ã¢â€ â€™ilk6 Ã¢â‚¬â€ iner
  // ya da tamamen null olur), muhakeme metni/karar artÃ„Â±k HER ZAMAN gerÃƒÂ§ek son durumu yansÃ„Â±tÃ„Â±r.
  return degerliSiralanmis.map((r, i) => {
    const gercekAgfTerfi: "ilk3" | "ilk6" | null = r.agfTerfi != null ? (i < 3 ? "ilk3" : i < 6 ? "ilk6" : null) : null;
    const gercekDegerTerfisi: "ilk3" | "ilk6" | null = r.degerTerfisi != null ? (i < 3 ? "ilk3" : i < 6 ? "ilk6" : null) : null;
    let karar = kararUret(r.olasilik);
    if (gercekAgfTerfi === "ilk3" || gercekDegerTerfisi === "ilk3") karar = "GÃƒÂ¼ÃƒÂ§lÃƒÂ¼ Aday";
    else if ((gercekAgfTerfi === "ilk6" || gercekDegerTerfisi === "ilk6") && (karar === "Orta Risk" || karar === "YÃƒÂ¼ksek Risk")) karar = "DÃƒÂ¼Ã…Å¸ÃƒÂ¼k Risk";
    const ekuriIlk6Efektif = i < ilk6EfektifSinir;
    if (ekuriIlk6Efektif && (karar === "Orta Risk" || karar === "YÃƒÂ¼ksek Risk")) karar = "DÃƒÂ¼Ã…Å¸ÃƒÂ¼k Risk";
    return { ...r, teknikSira: i + 1, karar, ekuriIlk6Efektif, agfTerfi: gercekAgfTerfi, degerTerfisi: gercekDegerTerfisi };
  });
}

