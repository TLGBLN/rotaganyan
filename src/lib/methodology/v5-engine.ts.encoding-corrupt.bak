  agfSirasi: "AGF SÃ„Â±rasÃ„Â±", accurace: "Accurace (son yarÃ„Â±Ã…Å¸ en hÃ„Â±zlÃ„Â± kapanÃ„Â±Ã…Å¸)",
  formEgimi: "Form EÃ„Å¸imi", formEgimi2: "Form EÃ„Å¸imi (karesi, doÃ„Å¸rusal-olmayan etki)",
