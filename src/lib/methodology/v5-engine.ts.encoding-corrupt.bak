export type TumOzellikDetay = { kod: string; etiket: string; hamDeger: number; standartDeger: number; katki: number };

export function tumOzellikleriListele(r: Faz1RunnerV5Sirali): TumOzellikDetay[] {
  const ham = toFeatureVector(r);
  return FEATURE_NAMES.map((kod, i) => ({
    kod,
    etiket: FEATURE_LABELS[kod] ?? kod,
    hamDeger: Math.round(ham[i] * 1000) / 1000,
    standartDeger: Math.round(r.standartVektor[i] * 1000) / 1000,
    katki: Math.round(r.katkilar[i] * 10000) / 10000,
  }));
}

const GUCLU_ESIK = 0.3;
const ORTA_ESIK = 0.1;

export function muhakemeUretV5(r: Faz1RunnerV5Sirali, sahaBuyuklugu: number): PickDetailsV2 {
  const gruplar = OZELLIK_GRUPLARI.map((g) => ({
    ...g,
    katki: g.ozellikIndeksleri.reduce((s, i) => s + r.katkilar[i], 0),
    metin: g.aciklama(r),
  })).filter((g) => g.metin != null);

  const satirlar: MuhakemeSatiri[] = [];

  // 2026-08-16 kullanÃ„Â±cÃ„Â± kararÃ„Â±: AGF trendi (en ÃƒÂ§ok yÃƒÂ¼kselenler/dÃƒÂ¼Ã…Å¸enler) HER ZAMAN
  // gerekÃƒÂ§enin en ÃƒÂ¶nÃƒÂ¼nde gÃƒÂ¶sterilir. Modelin kendi ÃƒÂ¶Ã„Å¸rendiÃ„Å¸i agfFark katsayÃ„Â±sÃ„Â± (ham/
  // sÃƒÂ¼rekli hÃƒÂ¢liyle) istatistiksel olarak anlamsÃ„Â±z ÃƒÂ§Ã„Â±ktÃ„Â± (agfSirasi ile yÃƒÂ¼ksek
  // korelasyon/multicollinearity yÃƒÂ¼zÃƒÂ¼nden olasÃ„Â±) Ã¢â‚¬â€ bu satÃ„Â±r o yÃƒÂ¼zden katkÃ„Â± sÃ„Â±ralamasÃ„Â±na
  // deÃ„Å¸il, V4'ÃƒÂ¼n kendi doÃ„Å¸rulanmÃ„Â±Ã…Å¸ backtest bulgusuna dayanÃ„Â±yor (trend+4sinyal: n=663,
  // %21.6 galibiyet/%53.8 top3, kontrol %10.2/%30.7). Skoru/olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â± DEÃ„ÂÃ„Â°Ã…ÂTÃ„Â°RMEZ Ã¢â‚¬â€
  // yalnÃ„Â±z gerekÃƒÂ§e metninin ÃƒÂ¶nceliÃ„Å¸ini belirler, kodGarantili:true (Claude'un/modelin
  // satÃ„Â±rÃ„Â± deÃ„Å¸il, kural-enjekte).
  if (r.agfTrendYonu) {
    satirlar.push({
      kod: ["AGFTREND"],
      tip: "destek",
      guven: "tam",
      kodGarantili: true,
      aciklama: `Bahis payÃ„Â± (AGF) son saatlerde ${r.agfTrendYonu === "yÃƒÂ¼kseliÃ…Å¸" ? "yÃƒÂ¼kseliyor" : "dÃƒÂ¼Ã…Å¸ÃƒÂ¼yor"} (${r.agfTrendFark! >= 0 ? "+" : ""}${r.agfTrendFark} puan) Ã¢â‚¬â€ bu at, piyasada en ÃƒÂ§ok ${r.agfTrendYonu === "yÃƒÂ¼kseliÃ…Å¸" ? "raÃ„Å¸bet gÃƒÂ¶renler" : "terk edilenler"} arasÃ„Â±nda`,
    });
  }

  // 2026-08-30 kullanÃ„Â±cÃ„Â± talebi ("o pist, zemin koÃ…Å¸ul ve mesafede yarÃ„Â±Ã…Å¸ geÃƒÂ§miÃ…Å¸i olan daha
  // tecrÃƒÂ¼beli gÃƒÂ¶rÃƒÂ¼lmeli... mesafede ilk defa koÃ…Å¸acaksa mevcut mesafelere gÃƒÂ¶re analiz
  // yapÃ„Â±lacak") Ã¢â‚¬â€ bkz. zemin-mesafe-deneyimi.actions.ts. KullanÃ„Â±cÃ„Â± KARARIYLA, nÃ¢â€°Â¥250-300
  // gÃƒÂ¶lge-koÃ…Å¸u/B=500 kanÃ„Â±tÃ„Â± BEKLENMEDEN B katmanÃ„Â±na (TÃƒÅ“M kategoriler, bkz. bKatmaniUygula
  // iÃƒÂ§indeki B_ZEMINMESAFE_KATSAYI notu) eklendi Ã¢â‚¬â€ sireOrani/zeminToleransi ile AYNI tÃƒÂ¼rden
  // bilinÃƒÂ§li, kanÃ„Â±tsÃ„Â±z istisna. AGFTREND ile AYNI doÃ„Å¸rudan-enjekte deseni kullanÃ„Â±ldÃ„Â± ÃƒÂ§ÃƒÂ¼nkÃƒÂ¼
  // bu terim OZELLIK_GRUPLARI/A katmanÃ„Â±nÃ„Â±n katkÃ„Â±-eÃ…Å¸ikli sÃ„Â±ralamasÃ„Â±nÃ„Â±n DIÃ…ÂINDA (B katmanÃ„Â±,
  // ayrÃ„Â± kalibre edilmiÃ…Å¸ bir terim) Ã¢â‚¬â€ o mekanizmadan asla geÃƒÂ§emezdi.
  if (r.zeminMesafeDeneyimSeviyesi !== "yok") {
    satirlar.push({
      kod: ["ZEMINMESAFE"],
      tip: r.zeminMesafeDeneyim >= 0 ? "destek" : "risk",
      guven: r.zeminMesafeDeneyimSeviyesi === "tam" ? "tam" : "orta",
      kodGarantili: true,
      aciklama:
        r.zeminMesafeDeneyimSeviyesi === "tam"
          ? `BugÃƒÂ¼nkÃƒÂ¼ pist, zemin ve mesafenin aynÃ„Â±sÃ„Â±nda daha ÃƒÂ¶nce koÃ…Å¸muÃ…Å¸ (${r.zeminMesafeOrnekSayisi} koÃ…Å¸u): o yarÃ„Â±Ã…Å¸larda diÃ„Å¸er atlara gÃƒÂ¶re ${r.zeminMesafeDeneyim > 0 ? "+" : ""}${r.zeminMesafeDeneyim.toFixed(1)}% ${r.zeminMesafeDeneyim > 0 ? "daha hÃ„Â±zlÃ„Â±" : "daha yavaÃ…Å¸"} (deneysel bir gÃƒÂ¶zlem, henÃƒÂ¼z kanÃ„Â±tlanmamÃ„Â±Ã…Å¸)`
          : `BugÃƒÂ¼nkÃƒÂ¼ pist ve zeminde tecrÃƒÂ¼beli ama bu mesafede ilk kez koÃ…Å¸acak Ã¢â‚¬â€ diÃ„Å¸er mesafelerdeki performansÃ„Â±na bakÃ„Â±larak deÃ„Å¸erlendirildi (${r.zeminMesafeOrnekSayisi} koÃ…Å¸u): diÃ„Å¸er atlara gÃƒÂ¶re ${r.zeminMesafeDeneyim > 0 ? "+" : ""}${r.zeminMesafeDeneyim.toFixed(1)}% ${r.zeminMesafeDeneyim > 0 ? "daha hÃ„Â±zlÃ„Â±" : "daha yavaÃ…Å¸"} (deneysel bir gÃƒÂ¶zlem, henÃƒÂ¼z kanÃ„Â±tlanmamÃ„Â±Ã…Å¸)`,
    });
  }

  // 2026-08-21 kullanÃ„Â±cÃ„Â± kararÃ„Â±: dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art/maiden segmentinde sireOrani ELLE en gÃƒÂ¼ÃƒÂ§lÃƒÂ¼
  // katsayÃ„Â± yapÃ„Â±ldÃ„Â± (bkz. weights/v5-weights-dusuksart.json notu) Ã¢â‚¬â€ SIRE iÃ…Å¸aretine
  // bakÃ„Â±lmaksÃ„Â±zÃ„Â±n (destek/risk) AGFTREND/ZEMINMESAFE'den hemen sonra sabit sÃ„Â±rada gÃƒÂ¶sterilir
  // (Ã…ÂENGÃƒÅ“L SULTAN/Bursa vakasÃ„Â± Ã¢â‚¬â€ "ÃƒÂ¶ncelikli deÃ„Å¸il" diye iÃ…Å¸aretlenmemeli, katkÃ„Â±sÃ„Â± bu
  // segmentte zaten en bÃƒÂ¼yÃƒÂ¼k).
  // 2026-08-30 (V5.30) Ã¢â‚¬â€ Opus denetimi BUG BULDU: SIRE grubu 2026-08-28'de A katmanÃ„Â±nÃ„Â±n
  // 12-ÃƒÂ¶zelliÃ„Å¸e kÃƒÂ¼ÃƒÂ§ÃƒÂ¼ltÃƒÂ¼lmesiyle OZELLIK_GRUPLARI'ndan TAMAMEN kaldÃ„Â±rÃ„Â±ldÃ„Â± (sireOrani zaten
  // A'da deÃ„Å¸il, B katmanÃ„Â±nda) ama bu blok hÃƒÂ¢lÃƒÂ¢ `gruplar.find(g => g.kod === "SIRE")`
  // arÃ„Â±yordu Ã¢â‚¬â€ HER ZAMAN undefined dÃƒÂ¶ndÃƒÂ¼, yani bu blok 2026-08-28'den beri Ãƒâ€“LÃƒÅ“ KODDU.
  // bKatmaniUygula skoru gerÃƒÂ§ekten deÃ„Å¸iÃ…Å¸tirmeye devam etti ama gerekÃƒÂ§e metninde/
  // pick.details'te hiÃƒÂ§ gÃƒÂ¶rÃƒÂ¼nmedi Ã¢â‚¬â€ sessizce yanlÃ„Â±Ã…Å¸ olsa fark edilemezdi. ZEMINMESAFE
  // ile AYNI doÃ„Å¸rudan-enjekte desenine geÃƒÂ§irildi: gerÃƒÂ§ek B katmanÃ„Â± katkÃ„Â±sÃ„Â±na (r.bSireKatkisi,
  // bkz. bKatmaniUygula) doÃ„Å¸rudan bakÃ„Â±lÃ„Â±yor, OZELLIK_GRUPLARI/gruplar'a baÃ„Å¸Ã„Â±mlÃ„Â± deÃ„Å¸il.
  if (r.bKatmaniUygulandiMi && Math.abs(r.bSireKatkisi) >= 0.03) {
    satirlar.push({
      kod: ["SIRE"],
      tip: r.bSireKatkisi >= 0 ? "destek" : "risk",
      guven: Math.abs(r.bSireKatkisi) >= GUCLU_ESIK ? "tam" : Math.abs(r.bSireKatkisi) >= ORTA_ESIK ? "orta" : "zayif",
      kodGarantili: true,
      aciklama: `BabasÃ„Â±nÃ„Â±n bu tip yarÃ„Â±Ã…Å¸lardaki kazanma oranÃ„Â± (dengelenmiÃ…Å¸ rakam, deneysel bir gÃƒÂ¶zlem): %${r.sireOrani.toFixed(1)}`,
    });
  }
  const gruplarSiresiz = gruplar; // SIRE zaten 2026-08-28'den beri OZELLIK_GRUPLARI'nda yok

  // 2026-08-31 kullanÃ„Â±cÃ„Â± talebi ("en belirgin 5 pozitif + 2 negatif katkÃ„Â±yÃ„Â± hepsi olacak
  // gerÃƒÂ§ek nedenleriyle sÃ„Â±ralamalar belirlenecek, her at iÃƒÂ§in"): eskiden burada yalnÃ„Â±z
  // ÃƒÂ¼st-5 pozitif + ÃƒÂ¼st-2 negatif katkÃ„Â± gÃƒÂ¶steriliyordu, geri kalanÃ„Â± METÃ„Â°NDE hiÃƒÂ§
  // gÃƒÂ¶rÃƒÂ¼nmÃƒÂ¼yordu (skor/sÃ„Â±ralama HÃ„Â°Ãƒâ€¡ etkilenmedi Ã¢â‚¬â€ r.katkilar zaten her zaman TÃƒÅ“M 12
  // sinyalden hesaplanÃ„Â±yordu, bu yalnÃ„Â±z gÃƒÂ¶sterim kÃ„Â±sÃ„Â±tÃ„Â±ydÃ„Â±). ArtÃ„Â±k ihmal edilebilir
  // olmayan (positif iÃƒÂ§in Ã¢â€°Â¥0.03, negatif iÃƒÂ§in ORTA_ESIK'i aÃ…Å¸an) TÃƒÅ“M katkÃ„Â±lar, HER at
  // iÃƒÂ§in, hiÃƒÂ§bir ÃƒÂ¼st sÃ„Â±nÃ„Â±r olmadan gÃƒÂ¶steriliyor.
  const pozitifSirali = gruplarSiresiz.filter((g) => g.katki > 0).sort((a, b) => b.katki - a.katki);
  for (const g of pozitifSirali) {
    if (g.katki < 0.03) continue; // ihmal edilebilir katkÃ„Â±, gÃƒÂ¶sterime deÃ„Å¸mez
    satirlar.push({
      kod: [g.kod],
      tip: "destek",
      guven: g.katki >= GUCLU_ESIK ? "tam" : g.katki >= ORTA_ESIK ? "orta" : "zayif",
      aciklama: g.metin!,
    });
  }

  const negatifSirali = gruplarSiresiz.filter((g) => g.katki < -ORTA_ESIK).sort((a, b) => a.katki - b.katki);
  for (const g of negatifSirali) {
    satirlar.push({
      kod: [g.kod],
      tip: "risk",
      guven: g.katki <= -GUCLU_ESIK ? "tam" : "orta",
      aciklama: g.metin!,
    });
  }

  // AGF-trend terfi denetim satÃ„Â±rÃ„Â± Ã¢â‚¬â€ bkz. agfTrendTerfisiUygula (2026-08-16, KURUÃ…ÂHAN
  // dersi; 2026-08-27'de kaldÃ„Â±rÃ„Â±lÃ„Â±p aynÃ„Â± gÃƒÂ¼n GERÃ„Â° getirildi, bkz. faz2V5Sirala ÃƒÂ¼stÃƒÂ¼ndeki
  // not). kodGarantili:true, sayaca dahil deÃ„Å¸il (AGFTREND kodu zaten yukarÃ„Â±da var).
  if (r.agfTerfi === "ilk3") {
    const dususAmaIyiPozisyonMu = r.agfFark <= -ANLAMLI_PUAN_ESIGI && r.agfSirasi <= 4;
    satirlar.push({
      kod: ["AGFTERFI"],
      tip: "destek",
      guven: "tam",
      kodGarantili: true,
      aciklama: dususAmaIyiPozisyonMu
        ? `DÃƒÂ¼Ã…Å¸ÃƒÂ¼Ã…Å¸e raÃ„Å¸men hÃƒÂ¢lÃƒÂ¢ iyi AGF pozisyonu (sÃ„Â±ra ${r.agfSirasi}) Ã¢â‚¬â€ ilk-3'e terfi (backtest: n=930, %19.9 galibiyet/%55.1 top3, kontrol %9.3/%28.4)`
        : `AGF trend + ${r.sinyalSayisi} sinyal Ã¢â‚¬â€ ilk-3'e terfi (V4 backtest: n=663, %21.6 galibiyet/%53.8 top3)`,
    });
  } else if (r.agfTerfi === "ilk6") {
    satirlar.push({
      kod: ["AGFTERFI"],
      tip: "destek",
      guven: "orta",
      kodGarantili: true,
      aciklama: `AGF trend taÃ…Å¸Ã„Â±yor ama yalnÃ„Â±z ${r.sinyalSayisi} sinyal (ilk-3 iÃƒÂ§in en az 4 gerekir) Ã¢â‚¬â€ ilk-6'ya terfi (V4 backtest: n=3210, %16.1 galibiyet/%44.6 top3)`,
    });
  }

  // AGF favorisi ilk-3 garantisi Ã¢â‚¬â€ bkz. agfFavoriIlk3Garantisi (2026-08-24, KaÃ…Å¸mir Tay
  // dersi; 2026-08-27'de kaldÃ„Â±rÃ„Â±lÃ„Â±p aynÃ„Â± gÃƒÂ¼n "V5.14'e dÃƒÂ¶n" kararÃ„Â±yla GERÃ„Â° getirildi).
  // agfTrendTerfisiUygula'dan FARKLI: koÃ…Å¸ulsuz, olasÃ„Â±lÃ„Â±kla yarÃ„Â±Ã…Å¸maz.
  if (r.agfFavoriGarantisi) {
    satirlar.push({
      kod: ["AGFFAVORI"],
      tip: "destek",
      guven: "tam",
      kodGarantili: true,
      aciklama: `AGF favorisi (sÃ„Â±ra 1, %${r.agfPayi.toFixed(1)} pay) Ã¢â‚¬â€ modelin ham sÃ„Â±ralamasÃ„Â± geride bÃ„Â±raksa da ilk-3'e koÃ…Å¸ulsuz alÃ„Â±nÃ„Â±r (backtest: n=512, AGF-1 galibiyetlerinin %8.1'i top3 dÃ„Â±Ã…Å¸Ã„Â±nda kalÃ„Â±yordu, garanti net +9/512 top3 isabeti)`,
    });
  }

  // Her zaman garanti Ã¢â‚¬â€ hem assertPublishSafe (7) hem UI Ã…Å¸effaflÃ„Â±Ã„Å¸Ã„Â± iÃƒÂ§in: modelin
  // ham ÃƒÂ§Ã„Â±ktÃ„Â±sÃ„Â± (olasÃ„Â±lÃ„Â±k + saha iÃƒÂ§i sÃ„Â±ra), kodGarantili (Claude'un satÃ„Â±rÃ„Â± deÃ„Å¸il).
  satirlar.push({
    kod: ["OLASILIK"],
    tip: "notr",
    guven: "tam",
    kodGarantili: true,
    aciklama: `V5 modeli tahmini kazanma olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â±: %${(r.olasilik * 100).toFixed(1)} (${sahaBuyuklugu} atlÃ„Â±k sahada ${r.teknikSira}. sÃ„Â±ra)`,
  });

  return { versiyon: 2, karar: r.karar, satirlar };
}
