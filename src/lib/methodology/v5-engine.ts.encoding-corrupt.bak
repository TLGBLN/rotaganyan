   *  ÃƒÂ¶nlemek iÃƒÂ§in (kullanÃ„Â±cÃ„Â± bulgusu 2026-08-24: "+27.5 toplam kilo diye belirtilmesi
   *  kullanÃ„Â±cÃ„Â±lar tarafÃ„Â±ndan farklÃ„Â± anlaÃ…Å¸Ã„Â±labilir"). Skora girmez. */
  h2hKiloKarsilasmaSayisi: number;
  /** 2026-08-28 Ã¢â‚¬â€ Zemin ToleransÃ„Â±: atÃ„Â±n Normal-dÃ„Â±Ã…Å¸Ã„Â± (Ã„Â±slak/aÃ„Å¸Ã„Â±r/yumuÃ…Å¸ak) pist
   *  koÃ…Å¸ullarÃ„Â±ndaki geÃƒÂ§miÃ…Å¸ performansÃ„Â±, TjkDereceKaydi arÃ…Å¸ivinden (hesaplaZeminToleransiMap,
   *  leak-free, kilo-ayarlÃ„Â±, kategori bazlÃ„Â±). Split-half gÃƒÂ¼venilirlik testinde GERÃƒâ€¡EK bir
   *  at-bazlÃ„Â± ÃƒÂ¶zellik olduÃ„Å¸u doÃ„Å¸rulandÃ„Â± (r=0.467, n=286) ama V5'in mevcut 22 ÃƒÂ¶zelliÃ„Å¸ine
   *  eklenip test edildiÃ„Å¸inde Ã„Â°KÃ„Â° KEZ (2026-08-23 B=50, 2026-08-28 B=500/n=1059 koÃ…Å¸u)
   *  katsayÃ„Â± %95 GA'sÃ„Â± sÃ„Â±fÃ„Â±rÃ„Â± iÃƒÂ§erdi Ã¢â‚¬â€ istatistiksel olarak ANLAMSIZ. KullanÃ„Â±cÃ„Â± bu sonucu
   *  bilerek, aÃƒÂ§Ã„Â±k bir kural istisnasÃ„Â± olarak eklenmesini istedi (AskUserQuestion ile
   *  teyit edildi) Ã¢â‚¬â€ normalde bu oturumun standart kuralÃ„Â± ("ÃƒÂ¶nce backtest, iyi ÃƒÂ§Ã„Â±kmazsa
   *  ekleme") bunu dÃ„Â±Ã…Å¸lardÃ„Â±. Risk: model bu ÃƒÂ¶zelliÃ„Å¸e gereksiz aÃ„Å¸Ã„Â±rlÃ„Â±k verebilir veya
   *  hiÃƒÂ§bir fayda saÃ„Å¸lamadan gÃƒÂ¼rÃƒÂ¼ltÃƒÂ¼ ekleyebilir. */
  zeminToleransi: number;
  /** 2026-08-30 Ã¢â‚¬â€ Zemin+Mesafe Deneyimi (bkz. zemin-mesafe-deneyimi.actions.ts): atÃ„Â±n
   *  BUGÃƒÅ“NKÃƒÅ“ tam (pist, zemin koÃ…Å¸ulu, mesafe) kombinasyonunda kanÃ„Â±tlanmÃ„Â±Ã…Å¸ deneyimi.
   *  "tam" = bu mesafede de koÃ…Å¸muÃ…Å¸, "kismi" = pist+zemin'de koÃ…Å¸muÃ…Å¸ ama baÃ…Å¸ka mesafede,
   *  "yok" = bu pist+zemin'de hiÃƒÂ§ kaydÃ„Â± yok. HENÃƒÅ“Z CANLI SKORA GÃ„Â°RMÃ„Â°YOR (C katmanÃ„Â±/
   *  gÃƒÂ¶lge-test adayÃ„Â±) Ã¢â‚¬â€ yalnÃ„Â±z muhakeme metninde Ã…Å¸effaflÃ„Â±k iÃƒÂ§in taÃ…Å¸Ã„Â±nÃ„Â±r. */
  zeminMesafeDeneyimSeviyesi: "tam" | "kismi" | "yok";
  /** zeminMesafeDeneyimSeviyesi hesaplanÃ„Â±rken kullanÃ„Â±lan geÃƒÂ§miÃ…Å¸ koÃ…Å¸u sayÃ„Â±sÃ„Â±. Skora girmez. */
  zeminMesafeOrnekSayisi: number;
  /** Zemin+Mesafe Deneyimi'nin HAM sayÃ„Â±sal deÃ„Å¸eri (popÃƒÂ¼lasyona gÃƒÂ¶re gÃƒÂ¶reli pace %,
   *  zeminToleransi ile AYNI ÃƒÂ¶lÃƒÂ§ek) Ã¢â‚¬â€ C katmanÃ„Â± challenger'Ã„Â±nÃ„Â±n (v6-zemin-mesafe-deneyimi)
   *  gerÃƒÂ§ek girdisi budur, tier (seviye) yalnÃ„Â±z muhakeme metni iÃƒÂ§in. Skora HENÃƒÅ“Z girmez. */
  zeminMesafeDeneyim: number;
  /** 2026-09-01 kullanÃ„Â±cÃ„Â± tasarÃ„Â±mÃ„Â± Ã¢â‚¬â€ "YarÃ„Â±Ã…Å¸ GidiÃ…Å¸atÃ„Â±": saha-geneli tempo senaryosu (Rahat
   *  Liderlik/YavaÃ…Å¸ Tempo/Dengeli/MÃƒÂ¼cadeleli/Ãƒâ€¡ok YÃƒÂ¼ksek/DaÃ„Å¸Ã„Â±lma Riski, Accurace geÃƒÂ§miÃ…Å¸inden
   *  kural-tabanlÃ„Â± olasÃ„Â±lÃ„Â±k daÃ„Å¸Ã„Â±lÃ„Â±mÃ„Â±, bkz. pace-analizi.ts hesaplaYarisGidisati) Ãƒâ€” atÃ„Â±n kendi
   *  stil daÃ„Å¸Ã„Â±lÃ„Â±mÃ„Â±nÃ„Â±n uyum-matrisiyle aÃ„Å¸Ã„Â±rlÃ„Â±klÃ„Â± beklenen deÃ„Å¸eri Ãƒâ€” mesafe katsayÃ„Â±sÃ„Â±. B=500
   *  bootstrap testi (bkz. arac-model-egit-segment.mjs'teki not) Ã„Â°KÃ„Â° segmentte de sÃ„Â±fÃ„Â±rÃ„Â±
   *  iÃƒÂ§eren GA verdi Ã¢â‚¬â€ KANITLANMADI, ama iki segmentte de AYNI YÃƒâ€“NDE (pozitif) ve diÃ„Å¸er
   *  segmentte neredeyse anlamlÃ„Â± (alt sÃ„Â±nÃ„Â±r sÃ„Â±fÃ„Â±ra 0.002 kala). zeminToleransi/yakÃ„Â±nsama/
   *  sonIdmanSprint/takÃ„Â± ile AYNI tÃƒÂ¼rden BÃ„Â°LÃ„Â°NÃƒâ€¡LÃ„Â° istisna, kullanÃ„Â±cÃ„Â± kararÃ„Â±yla eklendi. */
  yarisGidisatiSkoru: number;
};

export type Faz1SonucV5 = {
  race: {
    id: string;
    hippodromeName: string;
    raceNo: number;
    classType: string;
    breed: string;
    surface: string;
    distance: number;
  };
  runners: Faz1RunnerV5[];
};

const JOKEY_POP_ORT = 0.1;
const TRAINER_POP_ORT = 0.1;
const SIRE_POP_ORT = 0.14;

export async function gatherFaz1V5(raceId: string): Promise<Faz1SonucV5 | null> {
  // 2026-08-18 kullanÃ„Â±cÃ„Â± talebi (SELLYGIRL/Kocaeli K3 vakasÃ„Â±): AGF trend, analiz anÃ„Â±ndaki
  // en son veriyle hesaplanÃ„Â±yor Ã¢â‚¬â€ post saatinden ÃƒÂ¶nce yapÃ„Â±lan bir analizde henÃƒÂ¼z eÃ…Å¸iÃ„Å¸i
  // geÃƒÂ§memiÃ…Å¸ bir hareket, analizden SONRA gelen bir ÃƒÂ¶lÃƒÂ§ÃƒÂ¼mle eÃ…Å¸iÃ„Å¸i geÃƒÂ§ebiliyor ve
  // yakalanamÃ„Â±yor. Analiz baÃ…Å¸lamadan Ã„Â°LK ADIM olarak bu koÃ…Å¸unun hipodromu iÃƒÂ§in AGF'yi
  // tazeliyoruz (3dk soÃ„Å¸uma ile Ã¢â‚¬â€ aynÃ„Â± hipodromda art arda analiz TJK'yÃ„Â± gereksiz yormaz).
  // Hata durumunda sessizce yutulur (syncAgfForRace kendi iÃƒÂ§inde try/catch'li) Ã¢â‚¬â€ bu adÃ„Â±m
  // analizi ASLA bloke etmez, DB'deki mevcut veriyle devam eder.
  await syncAgfForRace(raceId);

  const race = await db.race.findUnique({
    where: { id: raceId },
    select: {
      id: true, raceNo: true, classType: true, breed: true, distance: true, surface: true, ikramiyeDetay: true,
      raceDay: { select: { date: true, hippodrome: { select: { name: true } }, surfaceConditions: true } },
      runners: {
        where: { scratched: false },
        orderBy: { no: "asc" },
        select: {
          id: true, no: true, name: true, jockey: true, trainer: true, sire: true, agf: true, recentForm: true,
          raceStyle: true, weight: true, ekuriGroup: true,
          gallops: { select: { date: true, jockey: true, splits: true, track: true }, orderBy: { date: "desc" } },
        },
      },
    },
  });
  if (!race) return null;
  const runners = race.runners;
  if (runners.length === 0) return { race: { id: race.id, hippodromeName: race.raceDay.hippodrome.name.trim(), raceNo: race.raceNo, classType: race.classType, breed: race.breed, surface: race.surface, distance: race.distance }, runners: [] };

  const bugunIkramiye1 = (race.ikramiyeDetay as { ikramiye?: number[] } | null)?.ikramiye?.[0] ?? null;

  const [sonYarisDetaylari, sireOzetleri, agfTrend, jockeyStats, trainerStats, accKayitlar, h2hEncounters, hizByNo, zeminToleransiByAd, yakinsamaGecmis, tempoTasimaGucuByAd] = await Promise.all([
    getSonYarisDetaylariForRace(raceId).catch(() => []),
    getSireStatOzetleriForRace(runners.map((r) => r.sire), race.breed, race.surface, race.distance).catch(() =>
      runners.map(() => ({ ozet: null, ornekKendiVeri: null, kYuzde: null }))
    ),
    getAgfTrendForRace(raceId).catch(() => ({ atlar: [], enCokDusenler: [], enCokYukselenler: [] })),
    getJockeyStats([...new Set(runners.map((r) => r.jockey).filter((x): x is string => !!x))]).catch(
      () => ({}) as Record<string, { overall: { wins: number; rides: number } }>
    ),
    getTrainerStats([...new Set(runners.map((r) => r.trainer).filter((x): x is string => !!x))]).catch(
      () => ({}) as Record<string, { wins: number; rides: number }>
    ),
    fetchAccuraceGecmisKayitlari(runners.map((r) => r.name), race.raceDay.date),
    getH2HForRace(raceId, null).catch(() => []),
    getHizDerecesiForRace(raceId).catch(() => new Map<number, number>()),
    hesaplaZeminToleransiMap(runners.map((r) => r.name), race.raceDay.date).catch(() => new Map<string, number>()),
    yakinsamaGecmisHesapla(db, runners.map((r) => ({ no: r.no, name: r.name, jockey: r.jockey })), race.raceDay.date, bugunIkramiye1).catch(
      () => new Map<number, { sinifDususu: boolean; ajiGalibiyetVarMi: boolean }>()
    ),
    // 2026-09-11 Ã¢â‚¬â€ Tempo TaÃ…Å¸Ã„Â±ma GÃƒÂ¼cÃƒÂ¼ (bkz. tempo-tasima-gucu.actions.ts), artÃ„Â±k AYRI bir
    // ÃƒÂ¶zellik deÃ„Å¸il Ã¢â‚¬â€ yarisGidisatiSkoru'nun KENDÃ„Â° formÃƒÂ¼lÃƒÂ¼ne girdi (bkz. gidisatSonucu notu).
    hesaplaTempoTasimaGucuMap(runners.map((r) => r.name), race.raceDay.date).catch(() => new Map<string, number>()),
  ]);

  // 2026-08-30 kullanÃ„Â±cÃ„Â± talebi ("kum Ã„Â±slak ise Ã„Â±slak kum koÃ…Å¸ularÃ„Â±na gÃƒÂ¶re H2H yapacaksÃ„Â±n
  // kilo ve H2H Net Skor yanÃ„Â±nda, dereceleri de ekleyeceksin"): H2H Net Skor/Kilo-AyarlÃ„Â±
  // H2H artÃ„Â±k Ãƒâ€“NCE bugÃƒÂ¼nÃƒÂ¼n zemin koÃ…Å¸uluyla EÃ…ÂLEÃ…ÂEN geÃƒÂ§miÃ…Å¸ karÃ…Å¸Ã„Â±laÃ…Å¸malarÃ„Â± kullanÃ„Â±r. BugÃƒÂ¼nÃƒÂ¼n
  // zemin durumu bilinmiyorsa (RaceDay.surfaceConditions henÃƒÂ¼z TJK'dan yayÃ„Â±mlanmadÃ„Â±ysa,
  // "seyrek" Ã¢â‚¬â€ bkz. horse-detail.actions.ts notu) filtre uygulanmaz, tÃƒÂ¼m karÃ…Å¸Ã„Â±laÃ…Å¸malar
  // kullanÃ„Â±lÃ„Â±r (eski davranÃ„Â±Ã…Å¸). BugÃƒÂ¼nÃƒÂ¼n durumu biliniyor ama HÃ„Â°Ãƒâ€¡BÃ„Â°R geÃƒÂ§miÃ…Å¸ karÃ…Å¸Ã„Â±laÃ…Å¸ma o
  // koÃ…Å¸ulla eÃ…Å¸leÃ…Å¸miyorsa da yine TÃƒÅ“M karÃ…Å¸Ã„Â±laÃ…Å¸malara dÃƒÂ¶nÃƒÂ¼lÃƒÂ¼r Ã¢â‚¬â€ bilgi kaybÃ„Â± olmasÃ„Â±n diye
  // (0 karÃ…Å¸Ã„Â±laÃ…Å¸malÃ„Â± bir sinyal, "veri yok" ile "eÃ…Å¸it" ayrÃ„Â±mÃ„Â±nÃ„Â± bozar).
  const bugunZeminDetay = zeminDetayiBul(
    race.raceDay.surfaceConditions as { label: string; detail: string }[] | null,
    race.surface
  );
  // 2026-09-13 kullanÃ„Â±cÃ„Â± bulgusu (Ã„Â°stanbul K9, SENSEÃ„Â° BAHA "yeniden analiz et" sonrasÃ„Â± hiÃƒÂ§
  // deÃ„Å¸iÃ…Å¸medi) Ã¢â‚¬â€ kÃƒÂ¶k neden zeminMesafeDeneyimi'nin kendi tabanÃ„Â± DEÃ„ÂÃ„Â°L, buradaki null'du.
  // GerÃƒÂ§ek veriyle doÃ„Å¸rulandÃ„Â±: son 30 gÃƒÂ¼nÃƒÂ¼n Sentetik pistli GÃƒÅ“NÃƒÅ“NÃƒÅ“N HÃ„Â°Ãƒâ€¡BÃ„Â°RÃ„Â°NDE (28/28)
  // RaceDay.surfaceConditions'ta "Sentetik" etiketi yok Ã¢â‚¬â€ Sentetik pist hava koÃ…Å¸ullarÃ„Â±ndan
  // etkilenmediÃ„Å¸i iÃƒÂ§in TJK muhtemelen bu pist iÃƒÂ§in zemin durumu HÃ„Â°Ãƒâ€¡ yayÃ„Â±nlamÃ„Â±yor (Ãƒâ€¡im/Kum'un
  // aksine, "henÃƒÂ¼z yayÃ„Â±mlanmadÃ„Â±, sonra gelir" durumu deÃ„Å¸il, YAPISAL OLARAK HÃ„Â°Ãƒâ€¡ GELMÃ„Â°YOR).
  // Eskiden bu null, Ãƒâ€¡im/Kum'daki "TJK henÃƒÂ¼z yayÃ„Â±mlamadÃ„Â±" (geÃƒÂ§ici/"seyrek") durumuyla AYNI
  // Ã…Å¸ekilde iÃ…Å¸leniyordu Ã¢â‚¬â€ zeminMesafeDeneyimi (ve aÃ…Å¸aÃ„Å¸Ã„Â±daki H2H zemin-filtresi) TÃƒÅ“M Sentetik
  // koÃ…Å¸ularÃ„Â±nda baÃ…Å¸tan "yok"/filtresiz kalÃ„Â±yordu. Sentetik iÃƒÂ§in null artÃ„Â±k "bilinmiyor"
  // deÃ„Å¸il, HER ZAMAN "Normal" (1.0) sayÃ„Â±lÃ„Â±yor Ã¢â‚¬â€ zeminKatsayisi(null) zaten aynÃ„Â± varsayÃ„Â±lanÃ„Â±
  // dÃƒÂ¶nÃƒÂ¼yordu, yalnÃ„Â±z BURADAKÃ„Â° ternary onu gÃƒÂ¶rmeden null'a sabitliyordu. Ãƒâ€¡im/Kum'daki gerÃƒÂ§ek
  // "seyrek" (geÃƒÂ§ici) null davranÃ„Â±Ã…Å¸Ã„Â± DEÃ„ÂÃ„Â°Ã…ÂMEDÃ„Â°.
  const bugunZeminKatsayi = bugunZeminDetay
    ? zeminKatsayisi(bugunZeminDetay).katsayi
    : race.surface === "SENTETIK"
    ? 1.0
    : null;
  const zeminEslesenEncounters =
    bugunZeminKatsayi != null
      ? h2hEncounters.filter((enc) => zeminKatsayisi(zeminDetayiSatirdanCikar(enc.surface)).katsayi === bugunZeminKatsayi)
      : [];
  const h2hZeminFiltresiUygulandiMi = zeminEslesenEncounters.length > 0;
  const h2hEncountersKullanilan = h2hZeminFiltresiUygulandiMi ? zeminEslesenEncounters : h2hEncounters;

  // 2026-08-30 kullanÃ„Â±cÃ„Â± talebi (H2H zemin-duyarlÃ„Â±lÃ„Â±Ã„Å¸Ã„Â±nÃ„Â±n hemen ardÃ„Â±ndan): "o pist, zemin
  // koÃ…Å¸ul ve mesafede yarÃ„Â±Ã…Å¸ geÃƒÂ§miÃ…Å¸i olan daha tecrÃƒÂ¼beli gÃƒÂ¶rÃƒÂ¼lmeli... mesafede ilk defa
  // koÃ…Å¸acaksa mevcut mesafelere gÃƒÂ¶re analiz yapÃ„Â±lacak" Ã¢â‚¬â€ bkz. zemin-mesafe-deneyimi.actions.ts.
  // V5.46'dan beri CANLI skora giriyor (bKatmaniUygula, softmax ÃƒÂ¶ncesi, B=500 ile doÃ„Å¸rulandÃ„Â± Ã¢â‚¬â€
  // bkz. engine-versions.data.ts). ÃƒÅ“stteki yorum ("henÃƒÂ¼z canlÃ„Â± skora girmiyor") artÃ„Â±k YANLIÃ…Â,
  // bu oturumda dÃƒÂ¼zeltildi. bugunIrk (2026-09-13 eklendi): TjkDereceKaydi'de kaydÃ„Â± olmayan
  // atlar iÃƒÂ§in HorseRaceHistoryCache'e ek kaynak olarak bakabilmesi iÃƒÂ§in gerekiyor.
  const zeminMesafeDeneyimByAd = await hesaplaZeminMesafeDeneyimiMap(
    runners.map((r) => r.name),
    race.raceDay.date,
    surfaceToPist(race.surface),
    bugunZeminKatsayi,
    race.distance,
    race.breed === "ARAP" ? "Arap" : "Ã„Â°ngiliz"
  );

  const raceNameToNo = new Map(runners.map((r) => [r.name, r.no]));
  function h2hNetSkorHesapla(kendiAd: string): { skor: number; zeminEslesti: boolean; kendiDerece: string | null; karsilastirma: number } {
    let skor = 0;
    let kendiDerece: string | null = null;
    let karsilastirma = 0; // 2026-10-07 (V5.46.1) Ã¢â‚¬â€ gÃƒÂ¶zlem sayacÃ„Â±, V5.46 davranÃ„Â±Ã…Å¸Ã„Â±nÃ„Â± DEÃ„ÂÃ„Â°Ã…ÂTÃ„Â°RMEZ
    for (const enc of h2hEncountersKullanilan) {
      const beniIceren = enc.results.find((e) => e.horseName === kendiAd);
      if (!beniIceren) continue;
      const benimPos = parseInt(beniIceren.finishPos, 10);
      if (isNaN(benimPos)) continue;
      if (kendiDerece == null && beniIceren.time) kendiDerece = beniIceren.time;
      for (const other of enc.results) {
        if (other.horseName === kendiAd) continue;
        if (!raceNameToNo.has(other.horseName)) continue;
        const otherPos = parseInt(other.finishPos, 10);
        if (isNaN(otherPos)) continue;
        karsilastirma++;
        skor += benimPos < otherPos ? 1 : benimPos > otherPos ? -1 : 0;
      }
    }
    return { skor, zeminEslesti: h2hZeminFiltresiUygulandiMi, kendiDerece, karsilastirma };
  }

  // 2026-08-24 Ã¢â‚¬â€ Kilo-ayarlÃ„Â± H2H (bkz. Faz1RunnerV5.h2hKiloDegisimi ÃƒÂ¼stÃƒÂ¼ndeki not).
  // H2HResult.weight zaten getH2HForRace'ten geliyor (TJK "At KoÃ…Å¸u Bilgileri" Ã¢â‚¬â€ ekstra
  // istek YOK), yalnÃ„Â±z o veriyi kullanan bir hesap eksikti.
  function parseKiloSayi(w: string | null | undefined): number | null {
    if (!w) return null;
    const n = parseFloat(w.replace(",", "."));
    return isNaN(n) ? null : n;
  }
  const bugunKiloByNo = new Map(runners.map((r) => [r.no, r.weight]));
  function h2hKiloDegisimiHesapla(kendiAd: string, kendiBugunKilo: number | null): { toplam: number; sayi: number } {
    if (kendiBugunKilo == null) return { toplam: 0, sayi: 0 };
    let toplam = 0;
    let sayi = 0;
    for (const enc of h2hEncountersKullanilan) {
      const beni = enc.results.find((e) => e.horseName === kendiAd);
      if (!beni) continue;
      const kendiOKilo = parseKiloSayi(beni.weight);
      if (kendiOKilo == null) continue;
      for (const other of enc.results) {
        if (other.horseName === kendiAd) continue;
        const otherNo = raceNameToNo.get(other.horseName);
        if (otherNo == null) continue;
        const otherOKilo = parseKiloSayi(other.weight);
        if (otherOKilo == null) continue;
        const otherBugunKilo = bugunKiloByNo.get(otherNo);
        if (otherBugunKilo == null) continue;
        const todayAdvantage = otherBugunKilo - kendiBugunKilo;
        const histAdvantage = otherOKilo - kendiOKilo;
        toplam += todayAdvantage - histAdvantage;
        sayi++;
      }
    }
    return { toplam, sayi };
  }

  const sonYarisByNo = new Map(sonYarisDetaylari.map((d) => [d.runnerNo, d]));
  const sireOzetByRunnerId = new Map(runners.map((r, i) => [r.id, sireOzetleri[i]]));
  const accuraceMap = hesaplaAccuraceSonYarisEnHizliKapanisMap(
    runners.map((r) => r.name),
    accKayitlar.son800AccuraceKayitlari,
    accKayitlar.son800Siblings
  );
  const agfFarkByNo = new Map(agfTrend.atlar.map((a) => [a.runnerNo, a.fark ?? 0]));
  const trendYonByNo = new Map<number, "yÃƒÂ¼kseliÃ…Å¸" | "dÃƒÂ¼Ã…Å¸ÃƒÂ¼Ã…Å¸">([
    ...agfTrend.enCokYukselenler.map((y): [number, "yÃƒÂ¼kseliÃ…Å¸"] => [y.runnerNo, "yÃƒÂ¼kseliÃ…Å¸"]),
    ...agfTrend.enCokDusenler.map((d): [number, "dÃƒÂ¼Ã…Å¸ÃƒÂ¼Ã…Å¸"] => [d.runnerNo, "dÃƒÂ¼Ã…Å¸ÃƒÂ¼Ã…Å¸"]),
  ]);
  // 2026-08-30 kullanÃ„Â±cÃ„Â± bulgusu (Ã„Â°stanbul 2.KoÃ…Å¸u, MAKÃ„Â°NÃ„Â°ST+SÃƒÅ“PER HAN ekÃƒÂ¼ri): agfSirasi
  // ekuriGroup'u hiÃƒÂ§ dikkate almÃ„Â±yordu Ã¢â‚¬â€ TJK'nÃ„Â±n kendi AGF tablosu ekÃƒÂ¼ri ortaklarÃ„Â±nÃ„Â±n
  // paylarÃ„Â±nÃ„Â± TOPLU deÃ„Å¸erlendirip market favorisini buna gÃƒÂ¶re belirliyor (bugÃƒÂ¼nkÃƒÂ¼ ÃƒÂ¶rnek:
  // ekÃƒÂ¼ri birleÃ…Å¸ik %36.06, DOÃ„ÂANHAN'Ã„Â±n bireysel %24.02'sinden YÃƒÅ“KSEK Ã¢â‚¬â€ TJK'nÃ„Â±n gerÃƒÂ§ek
  // 1.favorisi ekÃƒÂ¼ri iken, eski kod yanlÃ„Â±Ã…Å¸lÃ„Â±kla DOÃ„ÂANHAN'Ã„Â± 1.sÃ„Â±raya koyuyordu). Bu bir BUG
  // DÃƒÅ“ZELTMESÃ„Â° (yeni bir sinyal deÃ„Å¸il) Ã¢â‚¬â€ agfPayi (ham %, her at kendi bireysel deÃ„Å¸erini
  // korur) DEÃ„ÂÃ„Â°Ã…ÂMEDÃ„Â°, yalnÃ„Â±z agfSirasi'nin (piyasa favorisi SIRASI) ekÃƒÂ¼ri-farkÃ„Â±nda olmasÃ„Â±
  // dÃƒÂ¼zeltildi. EkÃƒÂ¼ri ortaklarÃ„Â± AYNI sÃ„Â±rayÃ„Â± paylaÃ…Å¸Ã„Â±r (TJK'nÃ„Â±n kendi gÃƒÂ¶sterimiyle tutarlÃ„Â±).
  // 2026-10-07 Ã¢â‚¬â€ paylaÃ…Å¸Ã„Â±lan hesap (bkz. agf-sirasi.ts) Ã¢â‚¬â€ train/live parity iÃƒÂ§in TEK kaynak.
  const agfSiraMap = hesaplaAgfSirasi(runners.map((r) => ({ id: r.id, agf: r.agf, ekuriGroup: r.ekuriGroup })));
  // birinciAgf/ikinciAgf Ã„Â°Ãƒâ€¡Ã„Â°N (agfSirasi'nden AYRI amaÃƒÂ§): bireysel AGF'ye gÃƒÂ¶re ham sÃ„Â±ralama.
  const agfSirali = [...runners].filter((r) => r.agf != null).sort((a, b) => (b.agf ?? 0) - (a.agf ?? 0));
  const sahaOrtasi = Math.ceil(runners.length / 2);
  // 2026-08-26 kullanÃ„Â±cÃ„Â± bulgusu: kacakAtMi (tek parÃƒÂ§a "kaÃƒÂ§ak at mÃ„Â±") YERÃ„Â°NE kacakYalniz Ã¢â‚¬â€
  // derinlemesine backtest (saha bÃƒÂ¼yÃƒÂ¼klÃƒÂ¼Ã„Å¸ÃƒÂ¼ sabit tutularak kontrol edilmiÃ…Å¸, deneyimsiz
  // atlarda bile split-half tutarlÃ„Â± +12-14 puan fark) sahada RAKÃ„Â°PSÃ„Â°Z kaÃƒÂ§ak olmanÃ„Â±n gerÃƒÂ§ek
  // avantaj taÃ…Å¸Ã„Â±dÃ„Â±Ã„Å¸Ã„Â±nÃ„Â±, RAKÃ„Â°PLÃ„Â° kaÃƒÂ§ak olmanÃ„Â±n (birden fazla at ÃƒÂ¶ne geÃƒÂ§meye ÃƒÂ§alÃ„Â±Ã…Å¸Ã„Â±rken) taÃ…Å¸Ã„Â±madÃ„Â±Ã„Å¸Ã„Â±nÃ„Â±
  // gÃƒÂ¶sterdi (dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art nokta=+0.145, GA=[0.031,0.266] anlamlÃ„Â±). SÃ„Â±zÃ„Â±ntÃ„Â± riski yok Ã¢â‚¬â€ bugÃƒÂ¼nkÃƒÂ¼
  // sahanÃ„Â±n kompozisyonu zaten ÃƒÂ¶nceden bilinen bir Ã…Å¸ey.
  const kacakSayisiSahada = runners.filter(
    (rr) => (rr.raceStyle as { style?: string } | null)?.style === "KACAK_AT"
  ).length;
  // 2026-09-01 kullanÃ„Â±cÃ„Â± tasarÃ„Â±mÃ„Â± Ã¢â‚¬â€ YarÃ„Â±Ã…Å¸ GidiÃ…Å¸atÃ„Â±: kacakYalniz Ã„Â°LE AYNI kaynaktan
  // (Runner.raceStyle, sÃ„Â±zÃ„Â±ntÃ„Â±sÃ„Â±z Ã¢â‚¬â€ accurace-sync.service.ts her atÃ„Â±n KENDÃ„Â° geÃƒÂ§miÃ…Å¸inden
  // hesaplayÃ„Â±p yazÃ„Â±yor) ama artÃ„Â±k TÃƒÅ“M stil daÃ„Å¸Ã„Â±lÃ„Â±mÃ„Â±nÃ„Â± (dagilim) + erken hÃ„Â±z gÃƒÂ¼cÃƒÂ¼nÃƒÂ¼
  // (erkenHizGucu) kullanÃ„Â±yor. SahanÃ„Â±n KOMPOZÃ„Â°SYONU (kaÃƒÂ§ kaÃƒÂ§ak, ne kadar gÃƒÂ¼ÃƒÂ§lÃƒÂ¼) zaten
  // ÃƒÂ¶nceden bilinen bir Ã…Å¸ey Ã¢â‚¬â€ sÃ„Â±zÃ„Â±ntÃ„Â± riski yok, tÃ„Â±pkÃ„Â± kacakSayisiSahada gibi.
  const tempoProfilleri: (AtTempoProfili | null)[] = runners.map((rr) => {
    const rs = rr.raceStyle as { dagilim?: Record<TekYarisStil, number>; erkenHizGucu?: number | null; veri?: number } | null;
    if (!rs?.dagilim) return null;
    return { dagilim: rs.dagilim, erkenHizGucu: rs.erkenHizGucu ?? null, n: rs.veri ?? 0 };
  });
  // 2026-09-11 (V5.45) Ã¢â‚¬â€ Tempo TaÃ…Å¸Ã„Â±ma GÃƒÂ¼cÃƒÂ¼ artÃ„Â±k yarisGidisatiSkoru'nun Ã„Â°Ãƒâ€¡Ã„Â°NE (zorluk-
  // aÃ„Å¸Ã„Â±rlÃ„Â±klÃ„Â±, bkz. pace-analizi.ts) giriyor; AYRI regresyon ÃƒÂ¶zelliÃ„Å¸i olarak denendiÃ„Å¸inde
  // (B=500) her iki segmentte de anlamsÃ„Â±z/ters ÃƒÂ§Ã„Â±kmÃ„Â±Ã…Å¸tÃ„Â± (diÃ„Å¸er 17 sinyal zaten aynÃ„Â± bilgiyi
  // aÃƒÂ§Ã„Â±klÃ„Â±yordu) Ã¢â‚¬â€ bkz. proje hafÃ„Â±zasÃ„Â±: project_accurace_tempo_yarisgidisati.md. BirleÃ…Å¸tirilmiÃ…Å¸
  // haliyle retrain: "diÃ„Å¸er" segmentte ARTIK anlamlÃ„Â± (GA=[0.005,0.184], ÃƒÂ¶nceden GA=[-0.009,0.166]
  // idi), dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art hÃƒÂ¢lÃƒÂ¢ sÃ„Â±nÃ„Â±rda ama TERS DEÃ„ÂÃ„Â°L (aynÃ„Â± yarisGidisatiSkoru'nun ilk kabul
  // standardÃ„Â± Ã¢â‚¬â€ "iki segmentte de aynÃ„Â± yÃƒÂ¶nde" Ã¢â‚¬â€ karÃ…Å¸Ã„Â±lanÃ„Â±yor/aÃ…Å¸Ã„Â±lÃ„Â±yor).
  const tempoTasimaListesi = runners.map((rr) => tempoTasimaGucuByAd.get(rr.name) ?? null);
  const gidisatSonucu = hesaplaYarisGidisati(tempoProfilleri, race.distance, tempoTasimaListesi);
  const gidisatByRunnerId = new Map(runners.map((rr, i) => [rr.id, gidisatSonucu.atSonuclari[i]]));
  // 2026-08-19 kullanÃ„Â±cÃ„Â± bulgusu (BODUBEY/EL LEON) Ã¢â‚¬â€ bkz. Faz1RunnerV5.agfPayi ÃƒÂ¼stÃƒÂ¼ndeki not.
  const birinciAgf = agfSirali[0]?.agf ?? null;
  const ikinciAgf = agfSirali[1]?.agf ?? null;

  const yakinsamaOnHesaplar = new Map<number, { pistUzmaniPoz: boolean; agfTrendPoz: boolean; ajiPoz: boolean; sinifDususuPoz: boolean }>();

  const faz1Runners: Faz1RunnerV5[] = runners.map((r) => {
    const sonYaris = sonYarisByNo.get(r.no);
    // 2026-09-01 kullanÃ„Â±cÃ„Â± talebi (KIZIM BÃ„Â°NDAL vakasÃ„Â±) Ã¢â‚¬â€ takÃ„Â± deÃ„Å¸iÃ…Å¸ikliÃ„Å¸i (SonYarisDetay)
    // ÃƒÂ¶nceden yalnÃ„Â±z GÃƒâ€“STERÃ„Â°M iÃƒÂ§indi (kgs/pistUzmani gibi diÃ„Å¸er alanlarÃ„Â± zaten kullanÃ„Â±yorduk,
    // eklenenTaki/cikarilanTaki'yi hiÃƒÂ§ almamÃ„Â±Ã…Å¸tÃ„Â±k). arac-model-veri-olustur.mts'te ZATEN
    // hesaplanÃ„Â±yordu (takiEklendiMi/takiCikarildiMi) Ã¢â‚¬â€ burada AYNI mantÃ„Â±kla ekleniyor.
    const takiEklendiMi: 0 | 1 = (sonYaris?.eklenenTaki?.length ?? 0) > 0 ? 1 : 0;
    const takiCikarildiMi: 0 | 1 = (sonYaris?.cikarilanTaki?.length ?? 0) > 0 ? 1 : 0;
    const sireOzet = sireOzetByRunnerId.get(r.id);
    const jockeyStat = r.jockey ? jockeyStats[r.jockey] : undefined;
    const trainerStat = r.trainer ? trainerStats[r.trainer] : undefined;

    const gecerliGaloplar = r.gallops.filter((g) => g.date < race.raceDay.date);
    const enSonGalop = gecerliGaloplar[0];
    let keskinGalop: 0 | 1 = 0;
    if (enSonGalop) {
      const s = (enSonGalop.splits as Record<string, string | null> | null) ?? {};
      const q = galopQuality("400", s["400"] ?? null, race.breed, s["ic_dis"] === "Ã„Â°ÃƒÂ§");
      keskinGalop = q === "cok_iyi" || q === "iyi" ? 1 : 0;
    }
    const idmJokey: 0 | 1 = gecerliGaloplar.some((g) => isSameJockey(g.jockey, r.jockey)) ? 1 : 0;
    // 2026-09-01 kullanÃ„Â±cÃ„Â± talebi (ESENYIL vakasÃ„Â±) Ã¢â‚¬â€ son idmanÃ„Â±n TÃƒÅ“RÃƒÅ“ (TJK "Ã„Â°dman TÃƒÂ¼rÃƒÂ¼")
    // Sprint/SÃƒÂ¼rat mi. Backtest (n=9148, karma hariÃƒÂ§, leak-free) yÃƒÂ¶nÃƒÂ¼ DOÃ„ÂRULAMADI: Sprint
    // grubu top1 %9.5 vs diÃ„Å¸er %11.1 (fark Ã¢Ë†â€™1.5pp, GA [Ã¢Ë†â€™3.3,+0.5] sÃ„Â±fÃ„Â±rÃ„Â± kapsÃ„Â±yor, nokta
    // tahmini HAFÃ„Â°F NEGATÃ„Â°F). KullanÃ„Â±cÃ„Â± yine de B-katmanÃ„Â± kural istisnasÃ„Â± olarak eklenmesini
    // istedi Ã¢â‚¬â€ GERÃƒâ€¡EK (veriden fit edilen) katsayÃ„Â± kullanÃ„Â±lÃ„Â±yor, elle pozitif YAPILMADI.
    const sonIdmanSprint: 0 | 1 = enSonGalop ? (isSprintIdman(enSonGalop.track) ? 1 : 0) : 0;
    const h2hKiloHesap = h2hKiloDegisimiHesapla(r.name, r.weight);
    const h2hNetSkorHesap = h2hNetSkorHesapla(r.name);

    const kgsVal = sonYaris?.gunFarki ?? -1;
    const kgsVarMi: 0 | 1 = sonYaris?.gunFarki != null ? 1 : 0;
    const uzunAraGalopKatkisi = kgsVarMi && kgsVal > 30 ? gecerliGaloplar.length : 0;

    const sireOrani =
      sireOzet?.kYuzde != null && sireOzet?.ornekKendiVeri != null
        ? shrink(Math.round((sireOzet.kYuzde / 100) * sireOzet.ornekKendiVeri), sireOzet.ornekKendiVeri, SIRE_POP_ORT) * 100
        : SIRE_POP_ORT * 100 * 0.5;
    const jokeyOrani =
      jockeyStat && jockeyStat.overall.rides > 0
        ? shrink(jockeyStat.overall.wins, jockeyStat.overall.rides, JOKEY_POP_ORT) * 100
        : JOKEY_POP_ORT * 100;
    const antrenorOrani =
      trainerStat && trainerStat.rides > 0
        ? shrink(trainerStat.wins, trainerStat.rides, TRAINER_POP_ORT) * 100
        : TRAINER_POP_ORT * 100;

    const yGecmis = yakinsamaGecmis.get(r.no);
    yakinsamaOnHesaplar.set(r.no, {
      pistUzmaniPoz: sonYaris?.kazandi === "EVET",
      agfTrendPoz: (agfFarkByNo.get(r.no) ?? 0) >= ANLAMLI_PUAN_ESIGI,
      ajiPoz: yGecmis?.ajiGalibiyetVarMi ?? false,
      sinifDususuPoz: yGecmis?.sinifDususu ?? false,
    });

    return {
      id: r.id, no: r.no, ad: r.name, jockey: r.jockey, trainer: r.trainer, agf: r.agf,
      ekuriGroup: r.ekuriGroup,
      agfFark: agfFarkByNo.get(r.no) ?? 0,
      agfSirasi: agfSiraMap.get(r.id) ?? sahaOrtasi,
      agfPayi: r.agf ?? 0,
      agfFarkiIkinciye:
        r.agf != null && birinciAgf != null && r.agf === birinciAgf && ikinciAgf != null
          ? birinciAgf - ikinciAgf
          : 0,
      accurace: accuraceMap.get(r.name) === true ? 1 : 0,
      formEgimi: formEgimi(r.recentForm),
      kgs: kgsVal, kgsVarMi,
      pistUzmani: sonYaris?.kazandi === "EVET" ? 1 : 0,
      yakinsama2Plus: 0, // aÃ…Å¸aÃ„Å¸Ã„Â±da, TÃƒÅ“M runner'lar hazÃ„Â±r olduktan sonra (sahaya-gÃƒÂ¶reli pedigri sÃ„Â±rasÃ„Â± gerekiyor) dolduruluyor
      sonIdmanSprint, sonIdmanSprintGozlemli: enSonGalop != null, takiEklendiMi, takiCikarildiMi,
      sireOrani, galop: keskinGalop, idmJokey,
      galopSayisi: gecerliGaloplar.length, uzunAraGalopKatkisi,
      jokeyOrani, antrenorOrani,
      agfTrendYonu: trendYonByNo.get(r.no) ?? null,
      agfTrendFark: trendYonByNo.has(r.no) ? (agfFarkByNo.get(r.no) ?? null) : null,
      recentForm: r.recentForm,
      hipodromMesafedeKazandi: sonYaris?.kazandi ?? "KOSMADI",
      sireKazanmaOraniHam: sireOzet?.kYuzde ?? null,
      sireOrneklemKendiVeri: sireOzet?.ornekKendiVeri ?? null,
      kacakYalniz: (r.raceStyle as { style?: string } | null)?.style === "KACAK_AT" && kacakSayisiSahada === 1 ? 1 : 0,
      h2hNetSkor: h2hNetSkorHesap.skor,
      h2hKarsilastirmaSayisi: h2hNetSkorHesap.karsilastirma,
      h2hZeminEslesmesiVarMi: h2hNetSkorHesap.zeminEslesti,
      h2hKendiDerece: h2hNetSkorHesap.kendiDerece,
      hizDerecesi: hizByNo.get(r.no) ?? 0,
      h2hKiloDegisimi: h2hKiloHesap.toplam,
      h2hKiloKarsilasmaSayisi: h2hKiloHesap.sayi,
      zeminToleransi: zeminToleransiByAd.get(r.name) ?? 0,
      zeminMesafeDeneyimSeviyesi: zeminMesafeDeneyimByAd.get(r.name)?.seviye ?? "yok",
      zeminMesafeOrnekSayisi: zeminMesafeDeneyimByAd.get(r.name)?.ornekSayisi ?? 0,
      zeminMesafeDeneyim: zeminMesafeDeneyimByAd.get(r.name)?.deger ?? 0,
      yarisGidisatiSkoru: gidisatByRunnerId.get(r.id)?.finalSkor ?? 0,
    };
  });

  // YakÃ„Â±nsama'nÃ„Â±n pedigri bileÃ…Å¸eni saha-Ã„Â°Ãƒâ€¡Ã„Â° gÃƒÂ¶reli (sireOrani'ne gÃƒÂ¶re ilk-2) Ã¢â‚¬â€ tÃƒÂ¼m
  // runner'lar hazÃ„Â±r olmadan hesaplanamaz, bu yÃƒÂ¼zden ayrÃ„Â± bir son geÃƒÂ§iÃ…Å¸.
  const sireSiraliYakinsama = [...faz1Runners].sort((a, b) => b.sireOrani - a.sireOrani);
  const sireRankByNoYakinsama = new Map(sireSiraliYakinsama.map((r, i) => [r.no, i + 1]));
  for (const r of faz1Runners) {
    const on = yakinsamaOnHesaplar.get(r.no);
    if (!on) continue;
    const sirePoz = (sireRankByNoYakinsama.get(r.no) ?? 999) <= 2;
    const sayi = [on.pistUzmaniPoz, sirePoz, on.ajiPoz, on.agfTrendPoz, on.sinifDususuPoz].filter(Boolean).length;
    r.yakinsama2Plus = sayi >= 2 ? 1 : 0;
  }

  return {
    race: {
      id: race.id, hippodromeName: race.raceDay.hippodrome.name.trim(), raceNo: race.raceNo,
      classType: race.classType, breed: race.breed, surface: race.surface, distance: race.distance,
    },
    runners: faz1Runners,
  };
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Faz2 Ã¢â‚¬â€ koÃ…Å¸ullu logit skoru + softmax Ã¢â€ â€™ olasÃ„Â±lÃ„Â±k, atlar BÃ„Â°RBÃ„Â°RÃ„Â°NE gÃƒÂ¶re kÃ„Â±yaslanÃ„Â±r Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

const ANLAMLI_PUAN_ESIGI = 1.0; // agf-trend.actions.ts'teki ANLAMLI_PUAN_ESIGI ile aynÃ„Â±

// 2026-08-28 kullanÃ„Â±cÃ„Â± kararÃ„Â± ("faydasÃ„Â± yoksa sil, tutarlÃ„Â± ol"): projenin bugÃƒÂ¼ne kadar bir
// sinyali EKLEMEK iÃƒÂ§in kullandÃ„Â±Ã„Å¸Ã„Â± baraj hep "kendi katkÃ„Â±sÃ„Â± B=500'de kanÃ„Â±tlandÃ„Â± mÃ„Â±" idi
// (agfPayi2, h2hKiloDegisimi hep bÃƒÂ¶yle eklendi). AynÃ„Â± barajÃ„Â± ÃƒÂ§Ã„Â±karmaya da uyguluyoruz Ã¢â‚¬â€
// "silmenin ayrÃ„Â±ca modelin genelini iyileÃ…Å¸tirdiÃ„Å¸ini kanÃ„Â±tla" ek Ã…Å¸artÃ„Â± tutarsÃ„Â±zdÃ„Â± (hiÃƒÂ§bir
// eklenen sinyalden bu istenmemiÃ…Å¸ti). B=500'de Ã„Â°KÃ„Â° segmentte de %95 GA'sÃ„Â± sÃ„Â±fÃ„Â±rÃ„Â± iÃƒÂ§eren
// 11 ÃƒÂ¶zellik (accurace, formEgimi, formEgimi2, kgs, kgs2, pistUzmani, sireOrani, galop,
// uzunAraGalopKatkisi, agfYukselisVarMi, agfDususVarMi) toFeatureVector'DAN Ãƒâ€¡IKARILDI.
// Ek doÃ„Å¸rulama: bootstrap FARK testi (23 vs 12 ÃƒÂ¶zellik, aynÃ„Â± resample'la ikisi de eÃ„Å¸itilip
// kÃ„Â±yaslandÃ„Â±) top1/top3'te zarar GÃƒâ€“STERMEDÃ„Â° (ortalama fark pozitif: dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art +2.74pp,
// diÃ„Å¸er +0.15pp Ã¢â‚¬â€ ikisi de GA sÃ„Â±fÃ„Â±rÃ„Â± iÃƒÂ§eriyor ama YÃƒâ€“N tutarlÃ„Â±, h2hKiloDegisimi'nin kabul
// edilme gerekÃƒÂ§esiyle aynÃ„Â± desen). Ham alanlar Faz1RunnerV5/arac-model-veri-olustur.mts'te
// HÃƒâ€šLÃƒâ€š TOPLANIYOR (maliyetsiz) Ã¢â‚¬â€ yalnÃ„Â±z skorlamadan ÃƒÂ§Ã„Â±karÃ„Â±ldÃ„Â±. zeminToleransi kullanÃ„Â±cÃ„Â±nÃ„Â±n
// bilinÃƒÂ§li istisnasÃ„Â± olduÃ„Å¸u iÃƒÂ§in (bkz. ÃƒÂ¼stteki not) KORUNDU.
export function toFeatureVector(r: Faz1RunnerV5): number[] {
  return [
    r.agfSirasi,
    r.idmJokey,
    r.jokeyOrani,
    r.antrenorOrani,
    r.agfPayi,
    r.h2hNetSkor,
    r.hizDerecesi,
    r.agfPayi * r.agfPayi,
    r.zeminToleransi,
    r.yakinsama2Plus,
    r.sonIdmanSprint,
    r.takiCikarildiMi - r.takiEklendiMi,
    r.yarisGidisatiSkoru,
  ];
}

function standardize(v: number[], ws: AgirlikSeti): number[] {
  return v.map((x, i) => (ws.stds[i] > 1e-9 ? (x - ws.means[i]) / ws.stds[i] : 0));
}

function softmaxHam(scores: number[]): number[] {
  const max = Math.max(...scores);
  const exps = scores.map((s) => Math.exp(s - max));
  const sum = exps.reduce((a, b) => a + b, 0);
  return exps.map((e) => e / sum);
}

// 2026-08-19 kullanÃ„Â±cÃ„Â± talebi (BODUBEY/EL LEON sonrasÃ„Â± kapsamlÃ„Â± kalibrasyon denetimi):
// %80+ tahmin dilimi gerÃƒÂ§ek galibiyet oranÃ„Â±ndan belirgin yÃƒÂ¼ksek ÃƒÂ§Ã„Â±kÃ„Â±yordu (n=78, tahmin
// %88.1 vs gerÃƒÂ§ek %67.9, %95 GA bunu dÃ„Â±Ã…Å¸lÃ„Â±yordu Ã¢â‚¬â€ tÃƒÂ¼m 35.453 satÃ„Â±rlÃ„Â±k veride doÃ„Å¸rulandÃ„Â±).
// KÃƒÂ¶k neden aranÃ„Â±rken ÃƒÂ¼ÃƒÂ§ ayrÃ„Â± dÃƒÂ¼zeltme denendi (aygÃ„Â±rÃƒâ€”AGF etkileÃ…Å¸im terimi, aygÃ„Â±r/antrenÃƒÂ¶r
// kare terimleri, L2 gevÃ…Å¸etme) Ã¢â‚¬â€ ÃƒÂ¼ÃƒÂ§ÃƒÂ¼ de sorunu ÃƒÂ§ÃƒÂ¶zmedi, kare terim durumu KÃƒâ€“TÃƒÅ“LEÃ…ÂTÃ„Â°RDÃ„Â°.
// Bu, sorunun katsayÃ„Â±/ÃƒÂ¶zellik eksikliÃ„Å¸i deÃ„Å¸il, softmax'Ã„Â±n kendi uÃƒÂ§-nokta aÃ…Å¸Ã„Â±rÃ„Â±-gÃƒÂ¼veni
// olduÃ„Å¸unu gÃƒÂ¶sterdi. Ãƒâ€¡ÃƒÂ¶zÃƒÂ¼m: yalnÃ„Â±z LÃ„Â°DERÃ„Â° zaten %70+ olan koÃ…Å¸ularda (T=1.5) sÃ„Â±caklÃ„Â±k
// ÃƒÂ¶lÃƒÂ§eklendirmesi Ã¢â‚¬â€ softmax sÃ„Â±ralamayÃ„Â± KORUR (T monoton, top1/top3 hiÃƒÂ§ deÃ„Å¸iÃ…Å¸mez), yalnÃ„Â±z
// mutlak olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â± yumuÃ…Å¸atÃ„Â±r. Backtest: sabit %80+ grubunun ort. tahmini %88.1Ã¢â€ â€™%70.3
// (gerÃƒÂ§ek %67.9'a ÃƒÂ§ok yakÃ„Â±n), genel top1 DEÃ„ÂÃ„Â°Ã…ÂMEDÃ„Â° (%38.9), genel logloss KÃƒâ€“TÃƒÅ“LEÃ…ÂMEDÃ„Â°
// (1.7132Ã¢â€ â€™1.7131, hafif iyileÃ…Å¸me). DiÃ„Å¸er koÃ…Å¸ulara (lider <%70) hiÃƒÂ§ dokunulmuyor.
const ASIRI_GUVEN_LIDER_ESIGI = 0.7;
const ASIRI_GUVEN_SICAKLIGI = 1.5;

// 2026-08-26 kullanÃ„Â±cÃ„Â± bulgusu: yukarÃ„Â±daki %70+ genel eÃ…Å¸iÃ„Å¸i Handikap'ta yetersiz kalÃ„Â±yordu Ã¢â‚¬â€
// "GÃƒÂ¼ÃƒÂ§lÃƒÂ¼ Aday" (>=%30) etiketi alan Handikap yarÃ„Â±Ã…Å¸larÃ„Â±nda (n=22, mevcut %70 eÃ…Å¸iÃ„Å¸iyle) ortalama
// tahmin %39.7 iken gerÃƒÂ§ek isabet yalnÃ„Â±z %27.3 (-12.4 puan aÃ…Å¸Ã„Â±rÃ„Â±-gÃƒÂ¼ven). Ã„Â°ki baÃ„Å¸Ã„Â±msÃ„Â±z ÃƒÂ¶lÃƒÂ§ÃƒÂ¼m
// (kayÃ„Â±tlÃ„Â± skorlardan n=20, yeniden inÃ…Å¸a edilen ham skordan n=15) aynÃ„Â± yÃƒÂ¶nde ama kÃƒÂ¼ÃƒÂ§ÃƒÂ¼k
// ÃƒÂ¶rneklem yÃƒÂ¼zÃƒÂ¼nden YENÃ„Â° bir sÃ„Â±caklÃ„Â±k katsayÃ„Â±sÃ„Â± UYDURULMADI Ã¢â‚¬â€ zaten doÃ„Å¸rulanmÃ„Â±Ã…Å¸ aynÃ„Â±
// ASIRI_GUVEN_SICAKLIGI (1.5), yalnÃ„Â±z Handikap'a ÃƒÂ¶zel DAHA DÃƒÅ“Ã…ÂÃƒÅ“K bir eÃ…Å¸ikte (0.35) tetikleniyor.
// Backtest (51 Handikap yarÃ„Â±Ã…Å¸Ã„Â±, yeniden inÃ…Å¸a): "GÃƒÂ¼ÃƒÂ§lÃƒÂ¼ Aday" grubu n=22Ã¢â€ â€™13'e dÃƒÂ¼Ã…Å¸tÃƒÂ¼, kalibrasyon
// -12.4'ten +3.7 puana geldi (n=13, gÃƒÂ¼rÃƒÂ¼ltÃƒÂ¼ sÃ„Â±nÃ„Â±rÃ„Â±nda ama makul). Genel top1 isabeti
// DEÃ„ÂÃ„Â°Ã…ÂMEDÃ„Â° (%21.6, 11/51 Ã¢â‚¬â€ sÃ„Â±caklÃ„Â±k sÃ„Â±ralamayÃ„Â± korur, yalnÃ„Â±z gÃƒÂ¶sterilen yÃƒÂ¼zdeyi dÃƒÂ¼zeltir).
const ASIRI_GUVEN_LIDER_ESIGI_HANDIKAP = 0.35;

// 2026-08-29 Ã¢â‚¬â€ V6 AÃ…Å¸ama 2 (bkz. plan): softmax'Ã„Â±n iÃƒÂ§indeki sÃ„Â±caklÃ„Â±k-ÃƒÂ¶lÃƒÂ§eklendirme kararÃ„Â±nÃ„Â±
// (lider zaten %70+/%35+ ise sÃ„Â±caklÃ„Â±Ã„Å¸Ã„Â± uygula) dÃ„Â±Ã…Å¸arÃ„Â± ÃƒÂ§Ã„Â±karÃ„Â±r Ã¢â‚¬â€ SAF REFAKTOR, davranÃ„Â±Ã…Å¸
// deÃ„Å¸iÃ…Å¸medi (softmax artÃ„Â±k bunu birebir ÃƒÂ§aÃ„Å¸Ã„Â±rÃ„Â±yor). AmaÃƒÂ§: yeni P(TOP2)/P(TOP3) hesabÃ„Â±nÃ„Â±n
// (plackettLuceTopKMarginals) AYNI etkin/sÃ„Â±caklÃ„Â±k-sonrasÃ„Â± skor vektÃƒÂ¶rÃƒÂ¼nÃƒÂ¼ kullanabilmesi Ã¢â‚¬â€
// yoksa k=1 durumu mevcut `olasilik`'le bit-bit eÃ…Å¸leÃ…Å¸mez.
function effektifSkorlar(scores: number[], liderEsigi = ASIRI_GUVEN_LIDER_ESIGI): number[] {
  const ham = softmaxHam(scores);
  if (Math.max(...ham) < liderEsigi) return scores;
  return scores.map((s) => s / ASIRI_GUVEN_SICAKLIGI);
}

function softmax(scores: number[], liderEsigi = ASIRI_GUVEN_LIDER_ESIGI): number[] {
  return softmaxHam(effektifSkorlar(scores, liderEsigi));
}

// 2026-08-29 Ã¢â‚¬â€ V6 AÃ…Å¸ama 2: Plackett-Luce KESÃ„Â°N (Monte Carlo deÃ„Å¸il) top-k marjinal olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â±.
// Saha kÃƒÂ¼ÃƒÂ§ÃƒÂ¼k olduÃ„Å¸u iÃƒÂ§in (Ã¢â€°Â¤~20-24 at) kÃ¢â€°Â¤3 iÃƒÂ§in maliyet n*(n-1)*(n-2) mertebesinde, ÃƒÂ¶nemsiz.
// YÃƒÂ¶ntem: sÃ„Â±rayla "kim ÃƒÂ¶nde" olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â±nÃ„Â± daÃ„Å¸Ã„Â±t, o atÃ„Â± ÃƒÂ§Ã„Â±karÃ„Â±p kalanlarÃ„Â± yeniden normalize et
// (ÃƒÂ¶zyinelemeli kaldÃ„Â±rma) Ã¢â‚¬â€ her atÃ„Â±n topK[i]'si, o atÃ„Â±n 1..k sÃ„Â±ralarÃ„Â±ndan HERHANGÃ„Â° birinde
// bitirme olasÃ„Â±lÃ„Â±klarÃ„Â±nÃ„Â±n toplamÃ„Â±. k=1 iÃƒÂ§in topK[i], softmaxHam(scores)[i] ile BÃ„Â°REBÃ„Â°R aynÃ„Â±
// ÃƒÂ§Ã„Â±kar (aynÃ„Â± aÃ„Å¸Ã„Â±rlÃ„Â±klar, tek adÃ„Â±m) Ã¢â‚¬â€ bu birim testinde doÃ„Å¸rulanÃ„Â±yor.
export function plackettLuceTopKMarginals(scores: number[], k: number): number[] {
  const n = scores.length;
  const topK = new Array(n).fill(0);
  if (n === 0 || k <= 0) return topK;

  const max = Math.max(...scores);
  const weights = scores.map((s) => Math.exp(s - max));
  const kEtkin = Math.min(k, n);

  function recurse(remaining: number[], remainingSum: number, pathProb: number, depth: number) {
    if (depth >= kEtkin) return;
    for (const i of remaining) {
      const p = pathProb * (weights[i] / remainingSum);
      topK[i] += p;
      if (depth + 1 < kEtkin) {
        recurse(
          remaining.filter((j) => j !== i),
          remainingSum - weights[i],
          p,
          depth + 1
        );
      }
    }
  }

  recurse(
    Array.from({ length: n }, (_, i) => i),
    weights.reduce((a, b) => a + b, 0),
    1,
    0
  );
  return topK;
}

// 2026-08-29 Ã¢â‚¬â€ V6 AÃ…Å¸ama 2: "piyasayÃ„Â± hiÃƒÂ§ gÃƒÂ¶rmeseydi model ne derdi" skoru. harmanliSkorla
// zaten her ÃƒÂ¶zelliÃ„Å¸in standart-vektÃƒÂ¶r katkÃ„Â±sÃ„Â±nÃ„Â± (katkilar) dÃƒÂ¶ndÃƒÂ¼rÃƒÂ¼yor Ã¢â‚¬â€ AGF-tÃƒÂ¼revi 3
// ÃƒÂ¶zelliÃ„Å¸in (agfSirasi/agfPayi/agfPayi2) katkÃ„Â±sÃ„Â± toplam skordan ÃƒÂ§Ã„Â±karÃ„Â±lÃ„Â±p TÃƒÅ“M saha AYRICA
// (kendi effektifSkorlarÃ¢â€ â€™softmaxHam hattÃ„Â±ndan) yeniden normalize edilir. Favori
// deÃ„Å¸iÃ…Å¸ebileceÃ„Å¸i iÃƒÂ§in bu `olasilik`'in basit bir ÃƒÂ¶lÃƒÂ§eklemesi DEÃ„ÂÃ„Â°L, tam yeni bir softmax.
export function marketBlindOlasiliklariHesapla(
  skorlar: number[],
  katkilarListesi: number[][],
  liderEsigi: number
): number[] {
  const marketBlindSkorlar = skorlar.map(
    (skor, i) => skor - AGF_KATKI_INDEKSLERI.reduce((toplam, idx) => toplam + katkilarListesi[i][idx], 0)
  );
  return softmaxHam(effektifSkorlar(marketBlindSkorlar, liderEsigi));
}

