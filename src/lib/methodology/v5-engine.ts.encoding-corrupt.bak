// %48-65], top3 %90.2 Ã¢â‚¬â€ ÃƒÂ¶rneklem-dÃ„Â±Ã…Å¸Ã„Â± (son %25) %64.3, V5 dÃƒÂ¶neminde (ÃƒÂ§evrimdÃ„Â±Ã…Å¸Ã„Â±) %66.7.
// YukarÃ„Â±daki 2026-08-22 notundaki "n=178, %34.8" ve "n=106, %23.6" rakamlarÃ„Â± BAYAT (o zamanki
// 23-ÃƒÂ¶zellikli modelden) Ã¢â‚¬â€ gÃƒÂ¼ncel referans bu. AyrÃ„Â±ca eÃ…Å¸ik taramasÃ„Â± TEMÃ„Â°Z monoton ÃƒÂ§Ã„Â±ktÃ„Â±:
// %55'te 78 tetik/%57.7, %60'ta 41 tetik (%3.9)/%65.9 (ÃƒÂ¶rneklem-dÃ„Â±Ã…Å¸Ã„Â± %85.7, V5'te %100 n=6).
// Bu yÃƒÂ¼zden ayrÃ„Â±, daha gÃƒÂ¼ÃƒÂ§lÃƒÂ¼ bir "GÃƒÂ¼ÃƒÂ§lÃƒÂ¼ Banko" kademesi eklendi (mevcut %50 eÃ…Å¸iÃ„Å¸i/mantÃ„Â±Ã„Å¸Ã„Â±
// DEÃ„ÂÃ„Â°Ã…ÂMEDÃ„Â°, ÃƒÂ¼stÃƒÂ¼ne ek bir kademe). Test edilip DESTEKLENMEYEN ÃƒÂ¶neriler (AGF-favorisi Ã…Å¸artÃ„Â±,
// Ã¢â€°Â¥2-farklÃ„Â±-aile baÃ„Å¸Ã„Â±msÃ„Â±z sinyal Ã…Å¸artÃ„Â±, pistUzmani/kaÃƒÂ§ak-tek kapÃ„Â±larÃ„Â±, negatif-sinyal
// diskalifiye kapÃ„Â±sÃ„Â±) BÃ„Â°LEREK eklenmedi Ã¢â‚¬â€ hiÃƒÂ§biri isabeti artÃ„Â±rmadÃ„Â±, ÃƒÂ§oÃ„Å¸u tetik sayÃ„Â±sÃ„Â±nÃ„Â±
// 2-6 kat dÃƒÂ¼Ã…Å¸ÃƒÂ¼rdÃƒÂ¼ (bkz. sinyal-kutugu.service.ts).
const BANKO_OLASILIK_ESIGI = 0.5;
const GUCLU_BANKO_OLASILIK_ESIGI = 0.6;
const AGF_OZELLIK_KODLARI = new Set(["agfSirasi", "agfPayi", "agfYukselisVarMi", "agfDususVarMi"]);

export type V5BankoSonuc = { bankoAdayi: boolean; gucluBanko?: boolean; sebep: string; birinci?: { no: number; ad: string; karar: string } };

export function v5BankoAdayiTespit(sirali: Faz1RunnerV5Sirali[]): V5BankoSonuc {
  const birinci = sirali[0];
  if (!birinci) return { bankoAdayi: false, sebep: "Veri yok." };

  const bagimsizGuclu = tumOzellikleriListele(birinci).find(
    (o) => !AGF_OZELLIK_KODLARI.has(o.kod) && o.katki >= GUCLU_ESIK
  );

  if (birinci.olasilik >= BANKO_OLASILIK_ESIGI && bagimsizGuclu) {
    const gucluBanko = birinci.olasilik >= GUCLU_BANKO_OLASILIK_ESIGI;
    // 2026-08-31 Ã¢â‚¬â€ "AGF favoriliÃ„Å¸i ... ile doÃ„Å¸rulanÃ„Â±yor" cÃƒÂ¼mlesi eskiden atÃ„Â±n AGF
    // favorisi OLDUÃ„ÂUNU varsayÃ„Â±yordu, ama bu koÃ…Å¸ul yalnÃ„Â±z modelin #1 seÃƒÂ§imine (birinci)
    // bakÃ„Â±yor Ã¢â‚¬â€ o her zaman AGF favorisi deÃ„Å¸il (Opus: pÃ¢â€°Â¥%50 havuzunda AGF favorisi
    // OLMAYAN 9 bankonun isabeti %66.7, favori olanlardan bile YÃƒÅ“KSEK). Metin artÃ„Â±k
    // gerÃƒÂ§ek AGF durumuna gÃƒÂ¶re deÃ„Å¸iÃ…Å¸iyor.
    const agfCumlesi =
      birinci.agfSirasi === 1
        ? `AGF favoriliÃ„Å¸i "${bagimsizGuclu.etiket}" (baÃ„Å¸Ã„Â±msÃ„Â±z sinyal) ile doÃ„Å¸rulanÃ„Â±yor`
        : `AGF favorisi olmamasÃ„Â±na raÃ„Å¸men "${bagimsizGuclu.etiket}" (baÃ„Å¸Ã„Â±msÃ„Â±z sinyal) taÃ…Å¸Ã„Â±yor`;
    return {
      bankoAdayi: true,
      gucluBanko,
      sebep: `#${birinci.no} ${birinci.ad} Ã¢â‚¬â€ model tahmini %${(birinci.olasilik * 100).toFixed(1)}, ${agfCumlesi} (bu profildeki geÃƒÂ§miÃ…Å¸ isabet: ÃƒÂ§evrimdÃ„Â±Ã…Å¸Ã„Â± n=122 koÃ…Å¸uda %56.6, V5 dÃƒÂ¶neminde canlÃ„Â± n=33'te %51.5)${gucluBanko ? ` Ã¢â‚¬â€ olasÃ„Â±lÃ„Â±k %${(GUCLU_BANKO_OLASILIK_ESIGI * 100).toFixed(0)}'Ã„Â±n da ÃƒÂ¼stÃƒÂ¼nde, GÃƒÅ“Ãƒâ€¡LÃƒÅ“ BANKO (bu eÃ…Å¸ikte isabet %60-100 arasÃ„Â±, tetik ÃƒÂ§ok daha nadir)` : ""}. YalnÃ„Â±z bir iÃ…Å¸aret Ã¢â‚¬â€ muhakeme metnindeki riskleri kendiniz teyit edin.`,
      birinci: { no: birinci.no, ad: birinci.ad, karar: birinci.karar },
    };
  }
  if (birinci.olasilik >= BANKO_OLASILIK_ESIGI && !bagimsizGuclu) {
    return {
      bankoAdayi: false,
      sebep: `#${birinci.no} ${birinci.ad} olasÃ„Â±lÃ„Â±Ã„Å¸Ã„Â± yÃƒÂ¼ksek (%${(birinci.olasilik * 100).toFixed(1)}) ama SADECE AGF favoriliÃ„Å¸inden gÃƒÂ¼ÃƒÂ§ alÃ„Â±yor, baÃ„Å¸Ã„Â±msÃ„Â±z gÃƒÂ¼ÃƒÂ§lÃƒÂ¼ bir sinyal (hÃ„Â±z/antrenÃƒÂ¶r/jokey) yok Ã¢â‚¬â€ banko sayÃ„Â±lmÃ„Â±yor.`,
      birinci: { no: birinci.no, ad: birinci.ad, karar: birinci.karar },
    };
  }
  return {
    bankoAdayi: false,
    sebep: `#${birinci.no} ${birinci.ad} en yÃƒÂ¼ksek olasÃ„Â±lÃ„Â±klÃ„Â± ama %${(birinci.olasilik * 100).toFixed(1)}, banko eÃ…Å¸iÃ„Å¸inin (%${(BANKO_OLASILIK_ESIGI * 100).toFixed(0)}) altÃ„Â±nda Ã¢â‚¬â€ net bir banko iÃ…Å¸areti yok.`,
    birinci: { no: birinci.no, ad: birinci.ad, karar: birinci.karar },
  };
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Muhakeme metni Ã¢â‚¬â€ ÃƒÂ¶zellik-katkÃ„Â± ayrÃ„Â±Ã…Å¸tÃ„Â±rmasÃ„Â±, Claude'suz Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

type OzellikGrubu = {
  kod: string;
  ozellikIndeksleri: number[];
  aciklama: (r: Faz1RunnerV5Sirali) => string | null;
};

const idx = (name: string) => FEATURE_NAMES.indexOf(name);

const OZELLIK_GRUPLARI: OzellikGrubu[] = [
  { kod: "AGF", ozellikIndeksleri: [idx("agfSirasi"), idx("agfPayi"), idx("agfPayi2")], aciklama: (r) => `AGF sÃ„Â±rasÃ„Â±: ${r.agfSirasi}${r.agfSirasi === 1 ? ` (AGF favorisi, %${r.agfPayi.toFixed(1)})` : ` (%${r.agfPayi.toFixed(1)})`}` },
  // 2026-08-28 kullanÃ„Â±cÃ„Â± kararÃ„Â± ("faydasÃ„Â± yoksa sil"): ACC/FORM/PIST/SIRE/GALOP/UZUNARA/
  // DUSUSIYI gruplarÃ„Â± (accurace, formEgimi/2, pistUzmani, sireOrani, galop,
  // uzunAraGalopKatkisi, agfDususVarMi) toFeatureVector'dan ÃƒÂ§Ã„Â±karÃ„Â±ldÃ„Â±Ã„Å¸Ã„Â± iÃƒÂ§in buradan da
  // kaldÃ„Â±rÃ„Â±ldÃ„Â± Ã¢â‚¬â€ artÃ„Â±k skora katkÃ„Â±larÃ„Â± yok, gerekÃƒÂ§e metninde gÃƒÂ¶stermek yanÃ„Â±ltÃ„Â±cÃ„Â± olurdu.
  // 2026-09-12 (V5.46) Ã¢â‚¬â€ KGS/KACAK/H2HKILO buradan da kaldÃ„Â±rÃ„Â±ldÃ„Â±: kgsVarMi/kacakYalniz/
  // h2hKiloDegisimi toFeatureVector'dan tamamen ÃƒÂ§Ã„Â±ktÃ„Â± (bkz. dosya baÃ…Å¸Ã„Â±ndaki not), artÃ„Â±k
  // skora hiÃƒÂ§ katkÃ„Â±larÃ„Â± yok.
  // 2026-08-31 (V5.31) Ã¢â‚¬â€ Handikap'ta bu sinyalin katsayÃ„Â±sÃ„Â± ELLE SIFIRLANMIÃ…Â (bkz. dosya
  // baÃ…Å¸Ã„Â±ndaki IDM_JOKEY_IDX/V5.31 notu, HIZ ile AYNI dÃƒÂ¼zeltme deseni) Ã¢â‚¬â€ eski kod ham
  // r.idmJokey'e bakÃ„Â±yordu, Handikap'ta bile "idman jokeyi uyumu" diye yanÃ„Â±ltÃ„Â±cÃ„Â± bir satÃ„Â±r
  // gÃƒÂ¶sterebilirdi. ArtÃ„Â±k GERÃƒâ€¡EK katkÃ„Â±ya (r.katkilar) bakÃ„Â±lÃ„Â±yor Ã¢â‚¬â€ Handikap'ta katkÃ„Â± her
  // zaman 0 olduÃ„Å¸undan satÃ„Â±r hiÃƒÂ§ gÃƒÂ¶sterilmez, diÃ„Å¸er kategorilerde davranÃ„Â±Ã…Å¸ deÃ„Å¸iÃ…Å¸medi.
  { kod: "IDMJOK", ozellikIndeksleri: [idx("idmJokey")], aciklama: (r) => (r.katkilar[IDM_JOKEY_IDX] !== 0 ? "BugÃƒÂ¼nkÃƒÂ¼ jokey, bu atÃ„Â±n idmanlarÃ„Â±ndan birini bizzat yaptÃ„Â±rmÃ„Â±Ã…Å¸" : null) },
  { kod: "JOKSTAT", ozellikIndeksleri: [idx("jokeyOrani")], aciklama: (r) => `Jokeyin genel kazanma oranÃ„Â± (dengelenmiÃ…Å¸ rakam): %${r.jokeyOrani.toFixed(1)}` },
  { kod: "ANTSTAT", ozellikIndeksleri: [idx("antrenorOrani")], aciklama: (r) => `AntrenÃƒÂ¶rÃƒÂ¼n genel kazanma oranÃ„Â± (dengelenmiÃ…Å¸ rakam): %${r.antrenorOrani.toFixed(1)}` },
  // 2026-08-17 denetim bulgusu: kacakAtMi ve dususAmaIyiPozisyon anlamlÃ„Â± sinyaller
  // (bkz. toFeatureVector ÃƒÂ¼stÃƒÂ¼ndeki notlar) ama hiÃƒÂ§bir OzellikGrubu'na dahil deÃ„Å¸ildi Ã¢â‚¬â€
  // katkÃ„Â±larÃ„Â± skoru etkiliyordu ama gerekÃƒÂ§e metninde hiÃƒÂ§ gÃƒÂ¶rÃƒÂ¼nmÃƒÂ¼yordu. Eklendi.
  // 2026-08-21 Ã¢â‚¬â€ H2H: bugÃƒÂ¼nkÃƒÂ¼ rakiplerle ortak geÃƒÂ§miÃ…Å¸ yarÃ„Â±Ã…Å¸ yoksa (h2hNetSkor=0) satÃ„Â±r
  // hiÃƒÂ§ gÃƒÂ¶sterilmez Ã¢â‚¬â€ "0 karÃ…Å¸Ã„Â±laÃ…Å¸ma" ile "hep berabere" ayrÃ„Â±mÃ„Â± yapÃ„Â±lamadÃ„Â±Ã„Å¸Ã„Â± iÃƒÂ§in nÃƒÂ¶tr.
  // 2026-08-27 Ã¢â‚¬â€ dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art'ta bu sinyalin katsayÃ„Â±sÃ„Â± ELLE sÃ„Â±fÃ„Â±rlanmÃ„Â±Ã…Å¸ (bkz. WEIGHTS_DUSUK_SART
  // ÃƒÂ¼stÃƒÂ¼ndeki not) Ã¢â‚¬â€ HIZ ile aynÃ„Â± dÃƒÂ¼zeltme: ham deÃ„Å¸ere deÃ„Å¸il gerÃƒÂ§ek katkÃ„Â±ya bakÃ„Â±lÃ„Â±yor,
  // dÃƒÂ¼Ã…Å¸ÃƒÂ¼k-Ã…Å¸art'ta satÃ„Â±r hiÃƒÂ§ gÃƒÂ¶sterilmez (puana katkÃ„Â±sÃ„Â± yok), diÃ„Å¸er'de davranÃ„Â±Ã…Å¸ deÃ„Å¸iÃ…Å¸medi.
  // 2026-08-30 kullanÃ„Â±cÃ„Â± talebi: "zemin Ã„Â±slaksa Ã„Â±slak koÃ…Å¸ulara gÃƒÂ¶re H2H yap, dereceleri
  // de ekle" Ã¢â‚¬â€ h2hZeminEslesmesiVarMi=true ise gerekÃƒÂ§e metni bunun BUGÃƒÅ“NÃƒÅ“N zemin koÃ…Å¸uluyla
  // eÃ…Å¸leÃ…Å¸en karÃ…Å¸Ã„Â±laÃ…Å¸ma(lar)a dayandÃ„Â±Ã„Å¸Ã„Â±nÃ„Â± ve atÃ„Â±n o karÃ…Å¸Ã„Â±laÃ…Å¸madaki kendi derecesini aÃƒÂ§Ã„Â±kÃƒÂ§a
  // belirtir; eÃ…Å¸leÃ…Å¸me yoksa (ya da bugÃƒÂ¼nÃƒÂ¼n zemini bilinmiyorsa) eski (tÃƒÂ¼m karÃ…Å¸Ã„Â±laÃ…Å¸malar)
  // metin aynen kalÃ„Â±r.
  {
    kod: "H2H",
    ozellikIndeksleri: [idx("h2hNetSkor")],
    aciklama: (r) => {
      if (r.katkilar[H2H_NET_SKOR_IDX] === 0) return null;
      const taban = `BugÃƒÂ¼nkÃƒÂ¼ rakipleriyle daha ÃƒÂ¶nce karÃ…Å¸Ã„Â±laÃ…Å¸mÃ„Â±Ã…Å¸${r.h2hZeminEslesmesiVarMi ? " (bugÃƒÂ¼nkÃƒÂ¼ne benzer zemin koÃ…Å¸ulunda)" : ""}: toplamda ${r.h2hNetSkor > 0 ? "+" : ""}${r.h2hNetSkor} net ${r.h2hNetSkor > 0 ? "ÃƒÂ¶nde" : "geride"} bitirmiÃ…Å¸`;
      return r.h2hZeminEslesmesiVarMi && r.h2hKendiDerece ? `${taban}, kendi derecesi: ${r.h2hKendiDerece}` : taban;
    },
  },
  // 2026-08-21 Ã¢â‚¬â€ HÃ„Â±z derecesi: veri yoksa (son 365 gÃƒÂ¼nde uygun geÃƒÂ§miÃ…Å¸ yok) 0, satÃ„Â±r
  // gÃƒÂ¶sterilmez Ã¢â‚¬â€ "hÃ„Â±zlÃ„Â± deÃ„Å¸il" ile "veri yok" karÃ„Â±Ã…Å¸masÃ„Â±n.
  // 2026-08-27 kullanÃ„Â±cÃ„Â± denetimi ("muhakemeler doÃ„Å¸ru mu"): Handikap kategorisinde
  // (WEIGHTS_DIGER_HANDIKAP) bu sinyalin katsayÃ„Â±sÃ„Â± ELLE SIFIRLANMIÃ…Â (bkz. dosya baÃ…Å¸Ã„Â±ndaki
  // V5.10 notu) Ã¢â‚¬â€ yani puana HÃ„Â°Ãƒâ€¡ katkÃ„Â±sÃ„Â± yok. Eski kod ham r.hizDerecesi'ye bakÃ„Â±yordu,
  // Handikap'ta bile "yavaÃ…Å¸/hÃ„Â±zlÃ„Â±" diye yanÃ„Â±ltÃ„Â±cÃ„Â± bir satÃ„Â±r gÃƒÂ¶steriyordu. ArtÃ„Â±k GERÃƒâ€¡EK
  // katkÃ„Â±ya (r.katkilar) bakÃ„Â±lÃ„Â±yor Ã¢â‚¬â€ Handikap'ta katkÃ„Â± her zaman 0 olduÃ„Å¸undan satÃ„Â±r hiÃƒÂ§
  // gÃƒÂ¶sterilmez, diÃ„Å¸er kategorilerde davranÃ„Â±Ã…Å¸ deÃ„Å¸iÃ…Å¸medi.
  { kod: "HIZ", ozellikIndeksleri: [idx("hizDerecesi")], aciklama: (r) => (r.katkilar[HIZ_DERECESI_IDX] !== 0 ? `Son yarÃ„Â±Ã…Å¸larÃ„Â±ndaki hÃ„Â±zÃ„Â±, benzer atlarÃ„Â±n ortalamasÃ„Â±na gÃƒÂ¶re %${Math.abs(r.hizDerecesi).toFixed(1)} ${r.hizDerecesi > 0 ? "daha hÃ„Â±zlÃ„Â±" : "daha yavaÃ…Å¸"}` : null) },
  // 2026-09-12 (V5.46) Ã¢â‚¬â€ H2HKILO buradan kaldÃ„Â±rÃ„Â±ldÃ„Â±: h2hKiloDegisimi toFeatureVector'dan
  // tamamen ÃƒÂ§Ã„Â±ktÃ„Â±, artÃ„Â±k skora katkÃ„Â±sÃ„Â± yok (bkz. dosya baÃ…Å¸Ã„Â±ndaki not).
  // 2026-08-28 Ã¢â‚¬â€ Zemin ToleransÃ„Â±: bkz. Faz1RunnerV5.zeminToleransi ÃƒÂ¼stÃƒÂ¼ndeki not. Veri
  // yoksa (Normal-dÃ„Â±Ã…Å¸Ã„Â± geÃƒÂ§miÃ…Å¸ koÃ…Å¸u yok) 0, satÃ„Â±r hiÃƒÂ§ gÃƒÂ¶sterilmez.
  { kod: "ZEMIN", ozellikIndeksleri: [idx("zeminToleransi")], aciklama: (r) => (r.zeminToleransi !== 0 ? `AÃ„Å¸Ã„Â±r/yaÃ„Å¸murlu pist gibi normal-dÃ„Â±Ã…Å¸Ã„Â± zeminlerdeki geÃƒÂ§miÃ…Å¸inde, diÃ„Å¸er atlara gÃƒÂ¶re %${Math.abs(r.zeminToleransi).toFixed(1)} ${r.zeminToleransi > 0 ? "daha hÃ„Â±zlÃ„Â±" : "daha yavaÃ…Å¸"}` : null) },
  { kod: "YAKINSAMA", ozellikIndeksleri: [idx("yakinsama2Plus")], aciklama: (r) => (r.katkilar[YAKINSAMA_IDX] !== 0 ? "Bu atta birden fazla olumlu iÃ…Å¸aret aynÃ„Â± anda bir araya gelmiÃ…Å¸ (pist uzmanlÃ„Â±Ã„Å¸Ã„Â±, pedigri, at-jokey geÃƒÂ§miÃ…Å¸i, AGF yÃƒÂ¼kseliÃ…Å¸i, sÃ„Â±nÃ„Â±f dÃƒÂ¼Ã…Å¸ÃƒÂ¼Ã…Å¸ÃƒÂ¼nden en az ikisi) Ã¢â‚¬â€ deneysel bir gÃƒÂ¶zlem, henÃƒÂ¼z kanÃ„Â±tlanmamÃ„Â±Ã…Å¸" : null) },
  { kod: "SPRINT", ozellikIndeksleri: [idx("sonIdmanSprint")], aciklama: (r) => (r.katkilar[SON_IDMAN_SPRINT_IDX] !== 0 ? `Son idmanÃ„Â±nÃ„Â± hÃ„Â±zlÃ„Â±/sÃƒÂ¼rat ÃƒÂ§alÃ„Â±Ã…Å¸masÃ„Â± olarak yapmÃ„Â±Ã…Å¸ (deneysel bir gÃƒÂ¶zlem, henÃƒÂ¼z kanÃ„Â±tlanmamÃ„Â±Ã…Å¸): geÃƒÂ§miÃ…Å¸te ${r.katkilar[SON_IDMAN_SPRINT_IDX] > 0 ? "olumlu" : "olumsuz"} ÃƒÂ§Ã„Â±kmÃ„Â±Ã…Å¸` : null) },
  // 2026-09-12 (V5.46) Ã¢â‚¬â€ TAKIEK/TAKICIK TEK sinyale (takiDegisikligi) birleÃ…Å¸tirildi (bkz.
  // TAKI_DEGISIKLIGI_IDX ÃƒÂ¼stÃƒÂ¼ndeki not) Ã¢â‚¬â€ ham iki alana (takiEklendiMi/takiCikarildiMi)
  // bakÃ„Â±larak YÃƒâ€“N belirleniyor, katkÃ„Â± TEK indeksten okunuyor.
  {
    kod: "TAKIDEGISIM",
    ozellikIndeksleri: [idx("takiDegisikligi")],
    aciklama: (r) => {
      if (r.katkilar[TAKI_DEGISIKLIGI_IDX] === 0) return null;
      const yon = r.takiCikarildiMi && !r.takiEklendiMi ? "ÃƒÂ§Ã„Â±karÃ„Â±lmÃ„Â±Ã…Å¸" : r.takiEklendiMi && !r.takiCikarildiMi ? "eklenmiÃ…Å¸" : "deÃ„Å¸iÃ…Å¸miÃ…Å¸";
      return `Son yarÃ„Â±Ã…Å¸Ã„Â±ndan bu yana bir ekipman ${yon}: geÃƒÂ§miÃ…Å¸te ${r.katkilar[TAKI_DEGISIKLIGI_IDX] > 0 ? "olumlu" : "olumsuz"} ÃƒÂ§Ã„Â±kmÃ„Â±Ã…Å¸`;
    },
  },
  { kod: "GIDISAT", ozellikIndeksleri: [idx("yarisGidisatiSkoru")], aciklama: (r) => (r.katkilar[YARIS_GIDISATI_IDX] !== 0 ? `Bu yarÃ„Â±Ã…Å¸Ã„Â±n beklenen gidiÃ…Å¸atÃ„Â±na (kimin ÃƒÂ¶ne geÃƒÂ§eceÃ„Å¸i, temponun nasÃ„Â±l olacaÃ„Å¸Ã„Â±) gÃƒÂ¶re bu atÃ„Â±n koÃ…Å¸u tarzÃ„Â± ${r.katkilar[YARIS_GIDISATI_IDX] > 0 ? "uygun dÃƒÂ¼Ã…Å¸ÃƒÂ¼yor" : "uygun dÃƒÂ¼Ã…Å¸mÃƒÂ¼yor"} (deneysel bir gÃƒÂ¶zlem, henÃƒÂ¼z kanÃ„Â±tlanmamÃ„Â±Ã…Å¸)` : null) },
];

// 2026-08-18 kullanÃ„Â±cÃ„Â± talebi: "18 sinyalin hepsinin kontrol edildiÃ„Å¸ini bana gÃƒÂ¶stermesini
// istiyorum, kanÃ„Â±tlamalÃ„Â±." Ã¢â‚¬â€ muhakemeUretV5'in gerekÃƒÂ§e satÃ„Â±rlarÃ„Â± YALNIZ en belirgin
// katkÃ„Â±larÃ„Â± gÃƒÂ¶steriyor (ÃƒÂ¼st-5 pozitif + ÃƒÂ¼st-2 negatif, eÃ…Å¸ik altÃ„Â±ndakiler hiÃƒÂ§ gÃƒÂ¶rÃƒÂ¼nmÃƒÂ¼yor) Ã¢â‚¬â€
// bu, "az katkÃ„Â±lÃ„Â± = hiÃƒÂ§ hesaplanmadÃ„Â±" izlenimi verebiliyordu. Bu fonksiyon FÃ„Â°LTRESÃ„Â°Z,
// TÃƒÅ“M 18 ÃƒÂ¶zelliÃ„Å¸i (ham deÃ„Å¸er + standardize + gerÃƒÂ§ek model katkÃ„Â±sÃ„Â±) sÃ„Â±rayla dÃƒÂ¶ner Ã¢â‚¬â€
// admin panelinde "TÃƒÂ¼m Sinyaller" aÃƒÂ§Ã„Â±lÃ„Â±r bÃƒÂ¶lÃƒÂ¼mÃƒÂ¼ iÃƒÂ§in, denetim amaÃƒÂ§lÃ„Â±.
