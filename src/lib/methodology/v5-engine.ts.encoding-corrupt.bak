  idmJokey: "Ã„Â°dman Jokeyi Uyumu", jokeyOrani: "Jokey Kazanma OranÃ„Â± (kÃƒÂ¼ÃƒÂ§ÃƒÂ¼ltÃƒÂ¼lmÃƒÂ¼Ã…Å¸)",
