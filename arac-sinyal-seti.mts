for (const [ad, H] of HS) { const idx = idxOf(H, () => true); P(`### ${ad}`); P("| Sinyal | ΔLL% [%95] | ΔTop1 p [%95] | **ΔTop3 p [%95]** | Kontrollü (cF6) ΔLL% [%95] | Tut. |\n|---|---|---|---|---|---|"); SIG.forEach(([a], i) => { const x = fark(H, "F6", `L${i}`, idx), y = fark(H, "cF6", `cL${i}`, idx); P(`| ${a} | ${isaret(x.llLo, x.llHi)} ${ci(x.ll, x.llLo, x.llHi)} | ${ci(x.t1, x.t1Lo, x.t1Hi, 1)} | ${ci(x.t3, x.t3Lo, x.t3Hi, 1)} | ${isaret(y.llLo, y.llHi)} ${ci(y.ll, y.llLo, y.llHi)} | ${x.tut} |`); }); P(""); }
// 4. SON6 varken / yokken
