for (const [ad, H] of HS) { const idx = idxOf(H, () => true); P(`### ${ad}`); P("| Sinyal | SON6 VAR (B7) ΔLL% | SON6 YOK (F6) ΔLL% | Değişim |\n|---|---|---|---|"); SIG.forEach(([a], i) => { const w = fark(H, "B7", `W${i}`, idx), y = fark(H, "F6", `L${i}`, idx); P(`| ${a} | ${hucre(w)} | ${hucre(y)} | ${fx(y.ll - w.ll)} |`); }); const c = fark(H, "B7", "F6", idx); P(`| **SON6'yı çıkarmanın maliyeti (B7 − F6)** | ${isaret(c.llLo, c.llHi)} ${ci(c.ll, c.llLo, c.llHi)} | | Top1 ${ci(c.t1, c.t1Lo, c.t1Hi, 1)}; Top3 ${ci(c.t3, c.t3Lo, c.t3Hi, 1)} |`); P(""); }
// 5. tipe göre
for (const [ad, H] of HS) { const TT: [string, number[]][] = [["Tümü", idxOf(H, () => true)], ["Maiden", idxOf(H, (i) => H.tip[i] === "Maiden")], ["Şartlı 3/4/5", idxOf(H, (i) => H.tip[i] === "Şartlı" && (H.sc[i] === 3 || H.sc[i] === 4 || H.sc[i] === 5))], ["Şartlı 2/19", idxOf(H, (i) => H.tip[i] === "Şartlı" && (H.sc[i] === 2 || H.sc[i] === 19))], ["Şartlı 1/27 (ortak β)", idxOf(H, (i) => H.tip[i] === "Şartlı" && (H.sc[i] === 1 || H.sc[i] === 27))], ["Handikap", idxOf(H, (i) => H.tip[i] === "Handikap")], ["KV", idxOf(H, (i) => H.tip[i] === "KV")], ["Grup + Satış", idxOf(H, (i) => H.tip[i] === "Grup" || H.tip[i] === "Satış")]];
  P(`## 5. Yarış tipine göre özgün katkı — ${ad} (F6 − sinyalsiz; ΔLL%; (+/−) test yarıları; n<100 yetersiz)`); const sg = Rseg ? mk(Rseg) : null; const sgi = sg ? idxOf(sg, () => true) : [];
  P("| Sinyal | " + TT.map(([a, idx]) => `${a} (n=${idx.length})`).join(" | ") + (ad.startsWith("P1") && sg ? ` | Şartlı 1/27 (segment-özel β; n=${sgi.length})` : "") + " |\n|---|" + "---|".repeat(TT.length + (ad.startsWith("P1") && sg ? 1 : 0)));
  const kapsam = (Hh: HH, idx: number[], cols: Kol[]) => { let n = 0, d = 0; for (const j of idx) { const k = Hh.R.yk[Hh.R.test[j]!]!.k; for (const a of k.atlar) { d++; if (cols.some((c) => a.v[c] != null)) n++; } } return d ? n / d : 0; };
  SIG.forEach(([a, cols], i) => P(`| ${a} | ` + TT.map(([, idx]) => (idx.length < 100 ? `— (n=${idx.length})` : kapsam(H, idx, cols) < 0.05 ? "**kullanılamaz** (veri yok)" : hucre(fark(H, "F6", `L${i}`, idx)))).join(" | ") + (ad.startsWith("P1") && sg ? ` | ${kapsam(sg, sgi, cols) < 0.05 ? "**kullanılamaz** (veri yok)" : hucre(fark(sg, "F6", `L${i}`, sgi))}` : "") + " |"));
  P("*'kullanılamaz (veri yok)': o gruptaki atların <%5'inde sinyal değeri var; bu bir 'sıfır katkı' değil, sinyalin o grupta HESAPLANAMADIĞI anlamına gelir (modelde nötr doldurulur).*");
  P(""); P("F6 modeli tipe göre: kazanç / Top1 / Top3 (1/N Top1):"); P("| Tip | n | Kazanç % | Top1 % | Top3 % | 1/N Top1 % |\n|---|---|---|---|---|---|"); for (const [a, idx] of TT) { if (idx.length < 30) continue; const s = seviye(H, "F6", idx); P(`| ${a} | ${idx.length} | ${fx(s.ll)} | ${fx(s.t1, 1)} | ${fx(s.t3, 1)} | ${fx(mean(idx.map((i) => H.R.r1[i]!)) * 100, 1)} |`); } P(""); }
if (Rseg) { const sg = mk(Rseg); const sgi = idxOf(sg, () => true); P(`## 6. Şartlı 1/27 — segment-özel β ayrıntısı (test ${sgi.length}; yalnız J_SEVIYE ve GALOP_KAPASITE verisi var)`); P("| Model | Kazanç % | Top1 % | Top3 % |\n|---|---|---|---|"); for (const [a, m] of [["F6", "F6"], ["yalnız J_SEVIYE", "a_S"], ["yalnız GALOP_KAPASITE", "a_kap"]] as [string, string][]) { const s = seviye(sg, m, sgi); P(`| ${a} | ${fx(s.ll)} | ${fx(s.t1, 1)} | ${fx(s.t3, 1)} |`); } P(""); }
P("## Sınırlar ve dürüst notlar");
P("- Keşif sonucudur (A/B/C dönemi tekrar kullanıldı); sinyal seti dondurulduktan sonra ileri-yönlü doğrulama gerekir. Çoklu karşılaştırma düzeltilmedi; tek hücredeki ✓/✗ kanıt sayılmaz.");
P("- P1'de GALOP, galop verisi olmayan dönemle seyreltildiği için yanlı düşük görünür; GALOP için P2 (ve Şartlı 1/27'de segment-özel β) esas alınmalıdır. Ortak β tipe dilimlenmiştir; tipe özel ağırlık öğrenilmedi (Şartlı 1/27 dışında).");
