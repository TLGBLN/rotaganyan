// 4. altılı
P("## 4. Aynı bütçeli ALTILI kupon (gerçek ikramiyeli; Eylül–Kasım katları)");
const dkey = (d: Date) => Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()); const raceKey = new Map<string, Rec>(); for (const r of A) raceKey.set(`${r.hip}|${r.date}|${r.no}`, r);
const kup = await db.homeKupon.findMany({ where: { slot: { in: [1, 2] } }, select: { hippodromeName: true, date: true, slot: true, legs: true } }); const ikr = await db.altiliIkramiyeLog.findMany({ select: { hippodromeName: true, date: true, slot: true, gercekIkramiye: true } }); const ikrMap = new Map<string, number>(); for (const x of ikr) if (x.gercekIkramiye != null && x.gercekIkramiye > 0) ikrMap.set(`${x.hippodromeName}|${dkey(x.date)}|${x.slot}`, x.gercekIkramiye);
