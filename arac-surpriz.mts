const altList = [...ALT.values()]; P(`Ayak yapısı: \`HomeKupon\` (1./2. Altılı ayak listeleri); gerçek ikramiye: \`AltiliIkramiyeLog.gercekIkramiye\` (kazanan kombinasyon başına, yalnız Eylül 2026'dan beri). Altı ayağı da test yarışlarında, AGF'li ve ikramiyesi bilinen altılı sayısı: **${altList.length}**.`);
P("**Kupon kurma (iki kaynak için AYNI algoritma, önceden bildirildi):** her ayakta atlar kaynağın olasılığına göre sıralanır; toplam kombinasyon sayısı ≤ B olacak şekilde, her adımda 'kapsama olasılığı log kazancı / log maliyet artışı' en yüksek ayağa bir at eklenir (açgözlü). B = 24 ve 48 kombinasyon. **Model kaynağı** = kalibre model olasılıkları; **AGF kaynağı** = AGF payları (yalnız sıralama/ağırlık referansı). **Maliyet varsayımı:** kombinasyon başına 1,00 TL (duyarlılık: 1,25 TL); ikramiye = kaydedilen 'kombinasyon-başı ödeme'. Bu varsayım doğrulanmadı; net getiri ölçeği değişebilir, model−AGF karşılaştırması aynı varsayımla yapılır.");
const kuponKur = (probs: number[][], B: number) => { const n = probs.length; const ord = probs.map((p) => p.map((x, j) => [x, j] as [number, number]).sort((a, b) => b[0] - a[0])); const cnt = new Array(n).fill(1), cov = ord.map((o) => o[0]![0]); let prod = 1; for (;;) { let bi = -1, bg = 0; for (let i = 0; i < n; i++) { if (cnt[i]! >= ord[i]!.length) continue; if (prod * (cnt[i]! + 1) / cnt[i]! > B + 1e-9) continue; const g = (Math.log(cov[i]! + ord[i]![cnt[i]!]![0]) - Math.log(cov[i]!)) / Math.log((cnt[i]! + 1) / cnt[i]!); if (g > bg) { bg = g; bi = i; } } if (bi < 0) break; cov[bi]! += ord[bi]![cnt[bi]!]![0]; prod = prod / cnt[bi]! * (cnt[bi]! + 1); cnt[bi]!++; } return { sets: ord.map((o, i) => new Set(o.slice(0, cnt[i]!).map((x) => x[1]))), combos: prod, cov: mean(cov.map((c) => c)) }; };
const degAlt = (a: Alt, B: number, kaynak: "m" | "a") => { const probs = a.legs.map((r) => (kaynak === "m" ? r.pv : r.av!)); const k = kuponKur(probs, B); const hit = a.legs.every((r, i) => r.win.some((w) => k.sets[i]!.has(w))); return { hit, combos: k.combos, payout: hit ? a.payout : 0 }; };
