    for (const B of [24, 48]) { const sonuc = (kaynak: "m" | "a") => altList.map((a) => degAlt(a, B, kaynak)); for (const [kn, kaynak] of [["Fiziksel model", "m"], ["AGF referansı", "a"]] as [string, "m" | "a"][]) { const s = sonuc(kaynak); const cost = sum(s.map((x) => x.combos * unit)), pay = sum(s.map((x) => x.payout)); const bh: number[] = [], br: number[] = []; for (let b = 0; b < 400; b++) { let h = 0, c = 0, p = 0; for (let i = 0; i < s.length; i++) { const x = s[(rnd() * s.length) | 0]!; h += x.hit ? 1 : 0; c += x.combos * unit; p += x.payout; } bh.push(h / s.length); br.push((p - c) / c); } P(`| ${B} | ${kn} | ${s.length} | ${fp(mean(s.map((x) => (x.hit ? 1 : 0))))}% (${s.filter((x) => x.hit).length}) ${cis(bh)} | ${fx(mean(s.map((x) => x.combos)), 1)} | ${fx(cost, 0)} | ${fx(pay, 0)} | ${fx(pay - cost, 0)} | ${fx((pay - cost) / cost)} ${cis(br, 1, 2)} |`); } } P(""); } }
