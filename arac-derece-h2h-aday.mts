type Fav = { p: number; hit: number; roi: number | null; v: Record<string, number | null> };
const favler = (R: Sonuc, ad: string): Fav[] => R.probs[ad]!.map((pr, j) => { let m = 0; pr.forEach((q, i) => { if (q > pr[m]!) m = i; }); const k = R.yk[R.test[j]!]!.k; const at = k.atlar[m]!; const hit = at.kazandi ? 1 : 0; return { p: pr[m]!, hit, roi: k.ganyan != null && k.ganyan > 0 ? (hit ? k.ganyan - 1 : -1) : null, v: { S6: at.S6, HD: at.HD, H2H: at.H2H } }; });
const ustK = (fv: Fav[], idx: number[], fr: number) => idx.slice().sort((x, y) => fv[y]!.p - fv[x]!.p).slice(0, Math.max(1, Math.round(fr * idx.length)));
const roiOrt = (fv: Fav[], s: number[]) => { const v = nn(s.map((j) => fv[j]!.roi)); return v.length ? mean(v) : NaN; };
function bankoTablo(R: Sonuc, bazAd: string, adAd: string) {
  const n = R.test.length; const fb = favler(R, bazAd), fa = favler(R, adAd); const satir: string[] = []; const tum = Array.from({ length: n }, (_, j) => j);
  for (const fr of [0.05, 0.10, 0.20, 0.30]) { const sb = ustK(fb, tum, fr), sa = ustK(fa, tum, fr); const K = sb.length; const ortak = sb.filter((j) => sa.includes(j)).length / K; const dh: number[] = [], dr: number[] = [];
    for (let b = 0; b < 400; b++) { const idx = Array.from({ length: n }, () => (rnd() * n) | 0); const rB = ustK(fb, idx, fr), rA = ustK(fa, idx, fr); dh.push(mean(rA.map((j) => fa[j]!.hit)) - mean(rB.map((j) => fb[j]!.hit))); const x = roiOrt(fa, rA) - roiOrt(fb, rB); if (isFinite(x)) dr.push(x); } dh.sort((x, y) => x - y); dr.sort((x, y) => x - y);
    const hb = mean(sb.map((j) => fb[j]!.hit)), ha = mean(sa.map((j) => fa[j]!.hit)), rb = roiOrt(fb, sb), ra = roiOrt(fa, sa);
    satir.push(`| ${K} (%${fr * 100}) | ${pct(hb)}% | ${pct(ha)}% | ${((ha - hb) * 100).toFixed(2)} [${(dh[Math.floor(dh.length * 0.025)]! * 100).toFixed(2)}; ${(dh[Math.floor(dh.length * 0.975)]! * 100).toFixed(2)}] | ${pct(rb)}% | ${pct(ra)}% | ${((ra - rb) * 100).toFixed(2)} [${((dr[Math.floor(dr.length * 0.025)] ?? NaN) * 100).toFixed(2)}; ${((dr[Math.floor(dr.length * 0.975)] ?? NaN) * 100).toFixed(2)}] | %${pct(ortak, 0)} |`); }
  return satir;
}
function olasilikEslesmis(R: Sonuc, bazAd: string, kol: "S6" | "HD" | "H2H") {
  const fv = favler(R, bazAd).filter((x) => x.v[kol] != null); const s = [...fv].sort((a, b) => a.p - b.p); const satir: string[] = []; const T = 3;
  for (let q = 0; q < T; q++) { const dil = s.slice(Math.floor((q * s.length) / T), Math.floor(((q + 1) * s.length) / T)); const med = medyan(dil.map((x) => x.v[kol]!)); const ust = dil.filter((x) => x.v[kol]! > med), alt = dil.filter((x) => x.v[kol]! <= med); if (ust.length < 10 || alt.length < 10) continue;
    const d: number[] = []; for (let b = 0; b < 500; b++) { const u = Array.from({ length: ust.length }, () => ust[(rnd() * ust.length) | 0]!.hit), a2 = Array.from({ length: alt.length }, () => alt[(rnd() * alt.length) | 0]!.hit); d.push(mean(u) - mean(a2)); } d.sort((x, y) => x - y); const ro = (g: Fav[]) => { const v = nn(g.map((x) => x.roi)); return v.length ? mean(v) : NaN; };
    satir.push(`| ${q + 1}. dilim (ort. P_fav ${pct(mean(dil.map((x) => x.p)))}%) | ${dil.length} | ${pct(mean(ust.map((x) => x.p)))}% / ${pct(mean(alt.map((x) => x.p)))}% | ${pct(mean(ust.map((x) => x.hit)))}% (${ust.length}) | ${pct(mean(alt.map((x) => x.hit)))}% (${alt.length}) | ${((mean(ust.map((x) => x.hit)) - mean(alt.map((x) => x.hit))) * 100).toFixed(2)} [${(d[Math.floor(d.length * 0.025)]! * 100).toFixed(2)}; ${(d[Math.floor(d.length * 0.975)]! * 100).toFixed(2)}] | ${pct(ro(ust))}% / ${pct(ro(alt))}% |`); }
  return satir;
}

