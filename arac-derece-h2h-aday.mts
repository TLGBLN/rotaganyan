const gAnahtar = (r: { irk: string; yuzey: string; hip: string; mesafe: number }) => [r.irk, r.yuzey, r.hip, r.mesafe].join("|"); const gMap = new Map<string, number[]>(); for (const r of audit) { const a = gMap.get(gAnahtar(r)) ?? []; a.push(r.sure); gMap.set(gAnahtar(r), a); }
