      out.push({ raceId: k.id, t, tip, ganyan: k.result?.ganyan ?? null, atlar: k.runners.map((r, i) => { const id = r.tjkAtId; const onceki = (id == null ? [] : gecmis.get(id) ?? []).filter((x) => x.t < t); const son10 = onceki.filter((x) => x.fp != null).slice(-10); const son3 = onceki.filter((x) => x.sinif != null).slice(-3);
        const d = id == null ? null : dereceBilesenleri(gd, id); const h = id == null ? null : h2hNet(gh, id, rakipIds, hedef);
        return { raceId: k.id, no: r.no, ad: r.name, atId: id, kazandi: win.has(r.no), kap: om([pH[i]!, pK[i]!, pE[i]!]), acc: id == null ? null : accBilesenleri(ga, id, yzm).accHiz, hp: r.hp, win: son10.length ? (1 + son10.filter((x) => x.fp === 1).length) / (2 + son10.length) : null, top3: son10.length ? (1 + son10.filter((x) => x.fp! <= 3).length) / (2 + son10.length) : null, sinif: bugunRank != null && son3.length ? bugunRank - mean(son3.map((x) => x.sinif!)) : null, S: r.jockey ? jokeyBilesenleri(gj, jn(r.jockey)).seviye.pRef : null, S6: d?.son6 ?? null, HD: d?.hizDerecesi ?? null, H2H: h?.deger ?? null, s6n: d?.guven.kullanilan ?? 0, s6Tek: d?.guven.tekYarisDusukGuven ?? false, h2hN: h?.nRakip ?? 0, h2hToplam: h?.toplamRakip ?? 0 }; }) }); } }
