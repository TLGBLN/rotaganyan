console.log("Örneklem A…"); const A = ozellikler(ksA); console.log("Örneklem B…"); const B = ozellikler(ksB);

// ───── sızıntı + bağımsız yeniden hesap
const gunlerA = [...new Set(A.map((k) => k.t))].sort((a, b) => a - b); const secilen = gunlerA.filter((_, i) => i % Math.ceil(gunlerA.length / 5) === 0).slice(0, 5); let denenenD = 0, farkliD = 0, denenenH = 0, farkliH = 0;
for (const t of secilen) { const g0 = dDep.gorunum(t), g1 = dDep.gelecegiBoz(t, 11 + (t / DERECE_GUN_MS) % 991).gorunum(t), h0 = hDep.gorunum(t), h1 = hDep.gelecegiBoz(t, 17 + (t / DERECE_GUN_MS) % 991).gorunum(t);
  for (const k of A.filter((x) => x.t === t)) { const ids = k.atlar.map((a) => a.atId).filter((x): x is number => x != null); const kr = ksA.find((q) => q.id === k.raceId)!; const hedef = { yuzey: YUZ_R[String(kr.surface)] ?? "?", mesafe: kr.distance }; for (const id of ids) { denenenD++; if (JSON.stringify(dereceBilesenleri(g0, id)) !== JSON.stringify(dereceBilesenleri(g1, id))) farkliD++; denenenH++; if (JSON.stringify(h2hNet(h0, id, ids, hedef)) !== JSON.stringify(h2hNet(h1, id, ids, hedef))) farkliH++; } } }
// bağımsız düz-döngü yeniden hesap
const ornek = A.flatMap((k) => k.atlar.filter((a) => a.atId != null && a.S6 != null).map((a) => ({ a, k }))); let bagD = 0, bagH = 0, nOrn = 0;
for (let i = 0; i < 80 && ornek.length; i++) { const { a, k } = ornek[Math.floor(rnd() * ornek.length)]!; nOrn++; const t = k.t; const o = dRows.filter((x) => x.atId === a.atId && x.tarih < t).sort((x, y) => x.tarih - y.tarih);
  const zl: number[] = []; for (const r of o) { let g = dRows.filter((x) => x.tarih < t && x.irk === r.irk && x.yuzey === r.yuzey && x.hip === r.hip && x.mesafe === r.mesafe); if (g.length < DERECE_SABITLERI.minGrupN) g = dRows.filter((x) => x.tarih < t && x.irk === r.irk && x.yuzey === r.yuzey && x.mesafe === r.mesafe); if (g.length < DERECE_SABITLERI.minGrupN) continue; const mu = mean(g.map((x) => x.sure)); const sd = Math.sqrt(sum(g.map((x) => (x.sure - mu) ** 2)) / (g.length - 1)); if (!(sd * sd > 1e-9)) continue; zl.push((mu - r.sure) / sd); }
  const z6 = zl.slice(-6).reverse(); const s6 = z6.length ? sum(z6.map((z, j) => [6, 5, 4, 3, 2, 1][j]! * z)) / sum(z6.map((_, j) => [6, 5, 4, 3, 2, 1][j]!)) : null; const sz = [...z6].sort((x, y) => y - x); const hd = z6.length === 0 ? null : z6.length === 1 ? sz[0]! : (sz[0]! + sz[1]!) / 2; const ok = (x: number | null, y: number | null) => (x == null || y == null ? x === y : Math.abs(x - y) < 1e-9); if (!(ok(s6, a.S6) && ok(hd, a.HD))); bagD += ok(s6, a.S6) && ok(hd, a.HD) ? 0 : 1;
  const kr = ksA.find((q) => q.id === k.raceId)!; const hedef = { yuzey: YUZ_R[String(kr.surface)] ?? "?", mesafe: kr.distance }; const rak = k.atlar.map((q) => q.atId).filter((x): x is number => x != null && x !== a.atId); const mine = hRows.filter((x) => x.atId === a.atId && x.tarih < t); const cv: number[] = [];
  for (const j of rak) { let sw = 0, swx = 0, n = 0; for (const m of mine) { const b = hRows.find((x) => x.atId === j && x.tarih < t && x.yarisKey === m.yarisKey); if (!b) continue; const x = m.sira < b.sira ? 1 : m.sira > b.sira ? -1 : 0; const w = Math.pow(0.5, (t - m.tarih) / DERECE_GUN_MS / 90) * (m.yuzey === hedef.yuzey ? 1 : 0.5) * (Math.abs(m.mesafe - hedef.mesafe) <= 200 ? 1 : 0.5); sw += w; swx += w * x; n++; } if (n > 0) cv.push(swx / (sw + 1)); }
  const h = cv.length ? mean(cv) : null; if (!((h == null && a.H2H == null) || (h != null && a.H2H != null && Math.abs(h - a.H2H) < 1e-9))) bagH++; }

// ───── ölçü cihazı (antrenör aracıyla aynı): forward-expanding 6 blok koşullu logit
type Kol = "acc" | "kap" | "hp" | "win" | "top3" | "sinif" | "S" | "S6" | "HD" | "H2H";
const SKALA: Record<Kol, number> = { acc: 100, kap: 1, hp: 20, win: 1, top3: 1, sinif: 2, S: 0.1, S6: 1, HD: 1, H2H: 0.3 };
const doldur = (v: (number | null)[]) => { const a = nn(v); if (a.length < 2) return v.map(() => 0); const mu = mean(a); return v.map((q) => (q == null ? mu : q)); };
const colX = (k: Kosu, c: Kol) => doldur(k.atlar.map((a) => (a[c] == null ? null : (a[c] as number) / SKALA[c])));
function coz(H: number[][], g: number[]) { const K = g.length; const M = H.map((r, i) => [...r, g[i]!]); for (let c = 0; c < K; c++) { let m = c; for (let r = c + 1; r < K; r++) if (Math.abs(M[r]![c]!) > Math.abs(M[m]![c]!)) m = r; [M[c], M[m]] = [M[m]!, M[c]!]; const d = M[c]![c]!; for (let j = c; j <= K; j++) M[c]![j]! /= d; for (let r = 0; r < K; r++) if (r !== c) { const fct = M[r]![c]!; for (let j = c; j <= K; j++) M[r]![j]! -= fct * M[c]![j]!; } } return M.map((r) => r[K]!); }
const BLOK = 6;
function fitFn(yk: { k: Kosu; w: number }[], X: (i: number, c: Kol) => number[]) { return (idx: number[], cols: Kol[]) => { const K = cols.length; let b = new Array(K).fill(0);
  for (let it = 0; it < 30; it++) { const g = new Array(K).fill(0); const H = Array.from({ length: K }, () => new Array(K).fill(0));
    for (const i of idx) { const Xi = cols.map((c) => X(i, c)); const N = Xi[0]!.length; const s = Array.from({ length: N }, (_, r) => sum(b.map((bk: number, k: number) => bk * Xi[k]![r]!))); const mx = Math.max(...s); const e = s.map((q) => Math.exp(q - mx)); const z = sum(e); const pr = e.map((q) => q / z);
      const ex = Xi.map((col) => sum(col.map((v, r) => pr[r]! * v))); const exx = Array.from({ length: K }, (_, a) => Array.from({ length: K }, (_, c) => sum(Xi[a]!.map((v, r) => pr[r]! * v * Xi[c]![r]!)))); const w = yk[i]!.w;
      for (let a = 0; a < K; a++) g[a] += Xi[a]![w]! - ex[a]!; for (let a = 0; a < K; a++) for (let c = 0; c < K; c++) H[a]![c] += exx[a]![c]! - ex[a]! * ex[c]!; }
    for (let a = 0; a < K; a++) { g[a] -= 0.02 * b[a]; H[a]![a] += 0.02; } const d = coz(H, g); b = b.map((q: number, k: number) => q + Math.max(-3, Math.min(3, d[k]!))); if (Math.max(...d.map(Math.abs)) < 1e-7) break; } return b as number[]; }; }
