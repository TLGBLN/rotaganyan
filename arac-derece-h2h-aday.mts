type At = { raceId: string; no: number; ad: string; atId: number | null; kazandi: boolean; acc: number | null; kap: number | null; hp: number | null; win: number | null; top3: number | null; sinif: number | null; S: number | null; S6: number | null; HD: number | null; H2H: number | null; s6n: number; s6Tek: boolean; h2hN: number; h2hToplam: number };
