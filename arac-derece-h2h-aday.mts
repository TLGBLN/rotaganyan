const tipOz = new Map<string, number[]>(); for (const x of zs) { const a = tipOz.get(x.tip) ?? []; a.push(x.z); tipOz.set(x.tip, a); } const zOrt = mean(zs.map((x) => x.z)); const SST = sum(zs.map((x) => (x.z - zOrt) ** 2)); const SSB = sum([...tipOz.values()].map((a) => a.length * (mean(a) - zOrt) ** 2)); const eta2 = SSB / SST; const kTip = tipOz.size;
